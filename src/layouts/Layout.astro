---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import FallingLeaves from '../components/FallingLeaves.astro';
import AchievementNotification from '../components/AchievementNotification.astro';
interface Props {
	title: string;
    description?: string;
}

const { title, description = "GATE Civil Engineering Preparation Tracker" } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="theme-color" content="#030a07" />
		<meta name="mobile-web-app-capable" content="yes" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/favicon.jpg', Astro.site || Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/favicon.jpg', Astro.site || Astro.url)} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
        <ViewTransitions />
	</head>
	<body class="min-h-screen">
        <div class="site-bg" aria-hidden="true"></div>
        <FallingLeaves />
        <AchievementNotification />
        <div class="app-container flex flex-col gap-5 sm:gap-6 relative z-0">
            <!-- Header -->
            <header class="flex flex-col gap-3 pb-4 border-b border-panel-border min-w-0">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3.5 sm:gap-4 min-w-0">
                    <div class="flex flex-col min-w-0 flex-1">
                        <a href="/" class="text-2xl sm:text-[28px] font-[Outfit] font-semibold flex items-center gap-2.5 text-white tracking-tight break-words leading-none hover:opacity-90 transition-opacity w-fit" style="letter-spacing: -0.01em;">
                            <img src="/favicon.jpg" alt="Logo" class="w-7 h-7 sm:w-8 sm:h-8 rounded object-cover border border-primary-accent/30 shrink-0 drop-shadow-[0_0_8px_rgba(74,222,128,0.3)]" />
                            <span class="truncate mt-0.5 text-[0.95em]">GATE CIVIL <span class="text-primary-accent">TRACKER</span></span>
                        </a>
                        <p class="text-text-muted text-xs sm:text-[13.5px] mt-2 leading-relaxed break-words max-w-3xl pr-4">Track your syllabus, PYQs, tests, full-length mocks & revisions — progress automatically saved to your browser.</p>
                    </div>
                    
                    <!-- Buttons Wrapper -->
                    <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 sm:gap-2.5 md:gap-3 w-full sm:w-auto shrink-0">
                        <a href="/achievements" class="btn relative hover:text-white text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center flex items-center gap-1.5 border-primary-accent/30 bg-primary-accent/5 hover:bg-primary-accent/20">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                            Achievements
                            <span id="ach-badge" class="absolute -top-2 -right-2 min-w-[20px] h-[20px] px-1 bg-primary-accent text-[#06140e] text-[10px] font-extrabold rounded-full shadow-[0_0_10px_rgba(74,222,128,0.8)] border-2 border-[#06140e] flex items-center justify-center pointer-events-none z-20 leading-none hidden">0</span>
                        </a>
                        <button class="btn text-red-400 hover:text-red-300 hover:border-red-400/30 hover:bg-red-400/10 text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center" id="btn-reset">Reset</button>
                        <button class="btn hover:text-white text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center" id="btn-export">Export</button>
                        <label class="btn hover:text-white cursor-pointer text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center">
                            Import
                            <input type="file" id="import-file" class="hidden" accept=".json">
                        </label>
                    </div>
                </div>

                <!-- Sync & Device Tip Banner -->
                <div class="flex items-center gap-2 px-3 py-1.5 sm:py-2 rounded-xl bg-primary-accent/[0.06] border border-primary-accent/20 text-text-muted text-[11px] sm:text-xs w-full sm:w-fit backdrop-blur-sm self-start">
                    <span class="text-primary-accent font-semibold flex items-center gap-1.5 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb text-primary-accent"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                        Tip:
                    </span>
                    <span class="leading-tight">
                        Export before switching devices, then import on the new one.
                    </span>
                </div>
            </header>
            
		    <slot />
        </div>

        <!-- Reset Confirmation Warning Modal -->
        <div id="reset-confirm-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[200] hidden items-center justify-center p-4 sm:p-6 opacity-0 transition-opacity duration-200">
            <div class="bg-[#06140e] border border-red-500/30 rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-md mx-auto shadow-2xl p-5 sm:p-6 flex flex-col gap-4 relative scale-95 transition-transform duration-200 transform" id="reset-modal-content">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-white">Reset All Progress?</h3>
                        <p class="text-[11px] sm:text-xs text-text-muted mt-0.5">This action is permanent and cannot be undone.</p>
                    </div>
                </div>

                <p class="text-xs sm:text-sm text-text-muted leading-relaxed bg-black/40 p-3 rounded-xl border border-white/5">
                    Are you sure you want to reset? All completed syllabus topics, PYQs, tests, mocks, revision and unlocked achievements will be wiped back to zero.
                </p>

                <div class="flex items-center justify-end gap-2.5 mt-1">
                    <button id="btn-cancel-reset" type="button" class="btn text-xs sm:text-sm px-4 py-2 hover:text-white bg-white/5 border border-white/10 rounded-xl transition-all cursor-pointer">
                        Cancel
                    </button>
                    <button id="btn-confirm-reset" type="button" class="btn text-xs sm:text-sm px-4 py-2 bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/40 rounded-xl font-semibold transition-all cursor-pointer">
                        Yes, Reset Everything
                    </button>
                </div>
            </div>
        </div>

        <!-- Activity Logging Modal -->
        <div id="log-activity-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[200] hidden items-center justify-center p-4 sm:p-6 opacity-0 transition-opacity duration-200">
            <div class="bg-[#06140e] border border-primary-accent/30 rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-md mx-auto shadow-2xl p-5 sm:p-6 flex flex-col gap-4 relative scale-95 transition-transform duration-200 transform" id="log-modal-content">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        Log Activity
                    </h3>
                    <button type="button" class="btn-close-log text-text-muted hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
                
                <form id="form-log-activity" class="flex flex-col gap-4" novalidate>
                    <input type="hidden" id="log-type" value="pyq">
                    
                    <div id="log-field-subject" class="flex flex-col gap-1.5">
                        <label class="text-xs text-text-muted font-medium ml-1">Subject</label>
                        <div id="log-subject-locked" class="hidden text-sm font-semibold text-white px-0.5 py-0.5"></div>
                        <select id="log-subject" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all custom-scrollbar">
                            <option value="general">General / All</option>
                            <!-- Subject options will be injected here via JS -->
                        </select>
                    </div>

                    <div id="log-field-pyq-year" class="flex flex-col gap-1.5 hidden">
                        <label class="text-xs text-text-muted font-medium ml-1">PYQ Year</label>
                        <input type="number" id="log-pyq-year" min="2000" placeholder="e.g. 2024" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all">
                    </div>

                    <div id="log-field-subtype" class="flex flex-col gap-1.5 hidden">
                        <label class="text-xs text-text-muted font-medium ml-1" id="log-label-subtype">Type</label>
                        <select id="log-subtype" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all custom-scrollbar">
                            <!-- Options injected dynamically -->
                        </select>
                    </div>

                    <div id="log-field-topic" class="flex flex-col gap-1.5 hidden">
                        <label class="text-xs text-text-muted font-medium ml-1">Topic</label>
                        <select id="log-topic" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all custom-scrollbar">
                            <!-- Options injected dynamically -->
                        </select>
                    </div>

                    <div id="log-field-amount" class="flex flex-col gap-1.5 hidden">
                        <label class="text-xs text-text-muted font-medium ml-1" id="log-label-amount">Amount</label>
                        <input type="number" id="log-amount" min="1" value="1" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all">
                    </div>
                    
                    <div id="log-field-name" class="flex flex-col gap-1.5 hidden">
                        <label class="text-xs text-text-muted font-medium ml-1">Mock Name / Series</label>
                        <input type="text" id="log-name" placeholder="e.g. MADE Easy Mock 1" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all">
                    </div>

                    <!-- Mock-specific fields (hidden for non-mock types) -->
                    <div id="log-field-mock-extra" class="hidden flex flex-col gap-3">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs text-text-muted font-medium ml-1">Marks Scored <span class="text-text-muted/60">(out of 100)</span></label>
                                <input type="number" id="log-mock-marks" min="0" max="100" step="any" placeholder="e.g. 52.67" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all">
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs text-text-muted font-medium ml-1">Percentile <span class="text-text-muted/60">(optional)</span></label>
                                <input type="number" id="log-mock-percentile" min="0" max="100" step="any" placeholder="e.g. 87.5" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Common Optional Fields (shown for all types) -->
                    <div id="log-field-common-extra" class="flex flex-col gap-3">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-text-muted font-medium ml-1">Hours Spent <span class="text-text-muted/60">(optional)</span></label>
                            <input type="number" id="log-hours" min="0" max="12" step="0.5" placeholder="e.g. 2.5" class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all">
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-xs text-text-muted font-medium ml-1">Notes / Weak Areas <span class="text-text-muted/60">(optional)</span></label>
                            <textarea id="log-notes" rows="2" placeholder="e.g. Weak in Fluid Mechanics, ran out of time in Part B..." class="bg-black/40 border border-white/10 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all resize-none custom-scrollbar"></textarea>
                        </div>
                    </div>

                    <div id="log-form-error" class="hidden text-xs text-red-400 bg-red-400/10 border border-red-400/20 p-2.5 rounded-xl mb-1 items-start gap-2 text-left">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                        <span id="log-form-error-text" class="flex-1"></span>
                    </div>

                    <div class="flex items-center justify-end gap-2.5 mt-2">
                        <button type="button" class="btn-close-log btn text-xs sm:text-sm px-4 py-2 hover:text-white bg-white/5 border border-white/10 rounded-xl transition-all cursor-pointer">
                            Cancel
                        </button>
                        <button type="submit" class="btn text-xs sm:text-sm px-4 py-2 bg-primary-accent/20 hover:bg-primary-accent/30 text-primary-accent border border-primary-accent/40 rounded-xl font-semibold transition-all cursor-pointer flex items-center gap-1.5">
                            Save Record
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Activity History Modal -->
        <div id="activity-history-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[200] hidden items-center justify-center p-4 sm:p-6 opacity-0 transition-opacity duration-200">
            <div class="bg-[#06140e] border border-panel-border rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-lg mx-auto shadow-2xl p-4 sm:p-6 flex flex-col gap-4 relative scale-95 transition-transform duration-200 transform max-h-[85vh]" id="history-modal-content">
                <div class="flex items-center justify-between mb-1 pb-3 border-b border-white/5 shrink-0">
                    <h3 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        Activity History
                    </h3>
                    <button type="button" class="btn-close-history text-text-muted hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
                
                <div id="history-list" class="flex flex-col gap-2 overflow-y-auto custom-scrollbar flex-1 -mx-2 px-2">
                    <!-- History items injected here via JS -->
                </div>
            </div>
        </div>

        <script>
            // @ts-nocheck
            import { defaultState } from '../data.js';
            import { evaluateAchievements } from '../utils/achievementEngine.js';
            import achievementsData from '../data/achievements.json';
            
            // Global helper functions to attach to window for cross-page use
            window.debounce = (func, wait) => {
                let timeout;
                return function(...args) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => func.apply(this, args), wait);
                };
            };
            
            window.getState = () => {
                const saved = localStorage.getItem('gateCivilTracker2027');
                if (saved) {
                    try {
                        const parsed = JSON.parse(saved);
                        if(!parsed.pyqs) {
                            parsed.pyqs = JSON.parse(JSON.stringify(defaultState.pyqs));
                        } else {
                            if (parsed.pyqs['geomatics_engineering'] && parsed.pyqs['geomatics_engineering'].total === 80) {
                                parsed.pyqs['geomatics_engineering'].total = 100;
                            }
                            if (parsed.pyqs['construction_materials'] && parsed.pyqs['construction_materials'].total === 80) {
                                parsed.pyqs['construction_materials'].total = 100;
                            }
                        }
                        if(!parsed.tests) parsed.tests = JSON.parse(JSON.stringify(defaultState.tests));
                        if(!parsed.tests.topic) parsed.tests.topic = { completed: 0, total: 40 };
                        if(!parsed.tests.subject) parsed.tests.subject = { completed: 0, total: 10 };
                        if(!parsed.mocks) parsed.mocks = JSON.parse(JSON.stringify(defaultState.mocks));
                        if(!parsed.revision) parsed.revision = JSON.parse(JSON.stringify(defaultState.revision));
                        if(!parsed.settings) parsed.settings = JSON.parse(JSON.stringify(defaultState.settings));
                        if(!parsed.settings.weights) parsed.settings.weights = JSON.parse(JSON.stringify(defaultState.settings.weights));
                        if(!parsed.achievements) parsed.achievements = JSON.parse(JSON.stringify(defaultState.achievements));
                        if(!parsed.streaks) parsed.streaks = JSON.parse(JSON.stringify(defaultState.streaks));
                        if(!parsed.studyHistory) parsed.studyHistory = [];
                        if(!parsed.mocksHistory) parsed.mocksHistory = [];
                        if(!parsed.subjects) parsed.subjects = JSON.parse(JSON.stringify(defaultState.subjects));
                        
                        // --- Data Migration Logic for Activity Records ---
                        const today = new Date().toISOString().split('T')[0];
                        
                        if(!parsed.pyqHistory) {
                            parsed.pyqHistory = [];
                            Object.entries(parsed.pyqs || {}).forEach(([subId, data]) => {
                                if (data.solved > 0) {
                                    parsed.pyqHistory.push({
                                        id: 'mig_pyq_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                                        subjectId: subId,
                                        date: today,
                                        solved: data.solved,
                                        notes: 'Legacy migration'
                                    });
                                }
                            });
                        }
                        
                        if(!parsed.testHistory) {
                            parsed.testHistory = [];
                            if (parsed.tests?.topic?.completed > 0) {
                                for (let i = 0; i < parsed.tests.topic.completed; i++) {
                                    parsed.testHistory.push({
                                        id: 'mig_tt_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                                        testType: 'topic',
                                        subjectId: 'general',
                                        date: today,
                                        notes: 'Legacy migration'
                                    });
                                }
                            }
                            if (parsed.tests?.subject?.completed > 0) {
                                for (let i = 0; i < parsed.tests.subject.completed; i++) {
                                    parsed.testHistory.push({
                                        id: 'mig_st_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                                        testType: 'subject',
                                        subjectId: 'general',
                                        date: today,
                                        notes: 'Legacy migration'
                                    });
                                }
                            }
                        }
                        
                        if(!parsed.mocksHistory || parsed.mocksHistory.length === 0) {
                            parsed.mocksHistory = [];
                            if (parsed.mocks?.completed > 0) {
                                for (let i = 0; i < parsed.mocks.completed; i++) {
                                    parsed.mocksHistory.push({
                                        id: 'mig_mk_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                                        name: `Legacy Mock ${i+1}`,
                                        date: today,
                                        notes: 'Legacy migration'
                                    });
                                }
                            }
                        }
                        
                        if(!parsed.revisionHistory) {
                            parsed.revisionHistory = [];
                            ['1st', '2nd', 'final'].forEach(revType => {
                                if (parsed.revision?.[revType] > 0) {
                                    for (let i = 0; i < parsed.revision[revType]; i++) {
                                        parsed.revisionHistory.push({
                                            id: 'mig_rev_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                                            subjectId: 'general',
                                            revisionType: revType,
                                            date: today,
                                            notes: 'Legacy migration'
                                        });
                                    }
                                }
                            });
                        }
                        
                        return parsed;
                    } catch(e) {
                        console.error("Error parsing saved state", e);
                    }
                }
                return JSON.parse(JSON.stringify(defaultState));
            };

            window.saveState = (state) => {
                // Ensure metrics are calculated before evaluating achievements
                window.calculateAllMetrics(state);
                
                const newUnlocks = evaluateAchievements(state, achievementsData.achievements);
                
                localStorage.setItem('gateCivilTracker2027', JSON.stringify(state));
                
                if (newUnlocks && newUnlocks.length > 0) {
                    window.dispatchEvent(new CustomEvent('achievementsUnlocked', { detail: newUnlocks }));
                }

                // Dispatch custom event so components know state changed
                window.dispatchEvent(new Event('stateChanged'));
            };

            window.calculateAllMetrics = (state) => {
                // --- Derive counts from histories ---
                if (state.pyqs) {
                    Object.keys(state.pyqs).forEach(k => {
                        state.pyqs[k].solved = 0;
                    });
                    if (state.pyqHistory) {
                        state.pyqHistory.forEach(h => {
                            if (state.pyqs[h.subjectId]) {
                                state.pyqs[h.subjectId].solved += (h.solved !== undefined ? (h.solved || 1) : 1);
                            }
                        });
                    }
                }
                
                if (state.testHistory) {
                    state.tests.topic.completed = state.testHistory.filter(t => t.testType === 'topic').length;
                    state.tests.subject.completed = state.testHistory.filter(t => t.testType === 'subject').length;
                }
                
                if (state.mocksHistory) {
                    state.mocks.completed = state.mocksHistory.length;
                }
                
                if (state.revisionHistory) {
                    state.revision['1st'] = state.revisionHistory.filter(r => r.revisionType === '1st').length;
                    state.revision['2nd'] = state.revisionHistory.filter(r => r.revisionType === '2nd').length;
                    state.revision.final = state.revisionHistory.filter(r => r.revisionType === 'final').length;
                }

                // --- Cap derived counts to their respective totals ---
                if (state.pyqs) {
                    Object.keys(state.pyqs).forEach(k => {
                        state.pyqs[k].solved = Math.min(state.pyqs[k].solved, state.pyqs[k].total);
                    });
                }
                if (state.tests?.topic) {
                    state.tests.topic.completed = Math.min(state.tests.topic.completed, state.tests.topic.total);
                }
                if (state.tests?.subject) {
                    state.tests.subject.completed = Math.min(state.tests.subject.completed, state.tests.subject.total);
                }
                if (state.mocks) {
                    state.mocks.completed = Math.min(state.mocks.completed, state.mocks.total);
                }
                if (state.revision) {
                    state.revision['1st'] = Math.min(state.revision['1st'], state.revision.total);
                    state.revision['2nd'] = Math.min(state.revision['2nd'], state.revision.total);
                    state.revision.final = Math.min(state.revision.final, state.revision.total);
                }
                // --- End capping ---
                
                // --- End derived counts ---
                
                let overallSyllabusWeightCompleted = 0;
                let totalSubjectTrackerWeight = 0;
                
                state.subjects.forEach(subject => {
                    let subjectTotalWeight = 0;
                    let subjectCompletedWeight = 0;
                    let subjectHours = 0;
                    
                    subject.topics.forEach(t => {
                        subjectTotalWeight += (t.trackerWeight || 0);
                        if (t.completed) {
                            subjectCompletedWeight += (t.trackerWeight || 0);
                        }
                    });
                    
                    [state.studyHistory, state.pyqHistory, state.testHistory, state.revisionHistory].forEach(history => {
                        if (history) {
                            history.forEach(entry => {
                                if (entry.subjectId === subject.id && entry.hours) {
                                    subjectHours += entry.hours;
                                }
                            });
                        }
                    });
                    
                    subject.progress = subjectTotalWeight === 0 ? 0 : (subjectCompletedWeight / subjectTotalWeight) * 100;
                    subject.hours = subjectHours;
                    overallSyllabusWeightCompleted += (subject.progress / 100) * (subject.trackerWeight || 0);
                    totalSubjectTrackerWeight += (subject.trackerWeight || 0);
                });
                
                // 1. Syllabus Progress: 0% to 100% based on all subject sub-topic completions
                state.overallSyllabusProgress = totalSubjectTrackerWeight === 0 ? 0 : (overallSyllabusWeightCompleted / totalSubjectTrackerWeight) * 100;
                let addedHours = 0;
                [state.pyqHistory, state.testHistory, state.mocksHistory, state.revisionHistory].forEach(history => {
                    if (history) {
                        addedHours += history.reduce((acc, curr) => acc + (curr.hours || 0), 0);
                    }
                });
                state.totalHours = (state.studyHistory ? state.studyHistory.reduce((acc, curr) => acc + (curr.hours || 0), 0) : 0) + addedHours;
                
                // 2. PYQs Progress: 0% to 100% based on questions solved vs total across all subjects
                let pyqTotal = 0, pyqSolved = 0;
                Object.values(state.pyqs).forEach(p => { pyqTotal += (p.total || 0); pyqSolved += (p.solved || 0); });
                state.pyqProgress = pyqTotal === 0 ? 0 : (pyqSolved / pyqTotal) * 100;
                
                // 3. Tests Progress: 0% to 100% based on topic + subject tests completed vs targets
                const totalTests = ((state.tests?.topic?.total || 0) + (state.tests?.subject?.total || 0));
                state.testProgress = totalTests === 0 ? 0 : (((state.tests?.topic?.completed || 0) + (state.tests?.subject?.completed || 0)) / totalTests) * 100;
                
                // 4. Mocks Progress: 0% to 100% based on full-length mocks completed vs target
                const totalMocks = (state.mocks?.total || 0);
                state.mockProgress = totalMocks === 0 ? 0 : ((state.mocks?.completed || 0) / totalMocks) * 100;
                
                // 5. Revision Progress: 0% to 100% based on 1st, 2nd, and final revision rounds (total subjects * 3)
                const totalRevisionTarget = (state.revision?.total || 9) * 3;
                const totalRevisionCompleted = (state.revision?.['1st'] || 0) + (state.revision?.['2nd'] || 0) + (state.revision?.final || 0);
                state.revisionProgress = totalRevisionTarget === 0 ? 0 : (totalRevisionCompleted / totalRevisionTarget) * 100;
                
                // 6. Overall GATE Readiness: Weighted composition of all 5 independent 100% pillars
                const w = state.settings?.weights || defaultState.settings.weights;
                const totalWeights = (w.syllabus + w.pyqs + w.tests + w.mocks + w.revision) || 1;
                state.gateReadiness = ((state.overallSyllabusProgress * w.syllabus) + 
                                      (state.pyqProgress * w.pyqs) + 
                                      (state.testProgress * w.tests) + 
                                      (state.mockProgress * w.mocks) + 
                                      (state.revisionProgress * w.revision)) / totalWeights;
            };

            window.formatHours = (hours) => {
                const h = Math.floor(hours);
                const m = Math.round((hours - h) * 60);
                if (m === 0) return `${h}h`;
                if (h === 0) return `${m}m`;
                return `${h}h ${m}m`;
            };

            window.formatPercent = (value) => {
                return value.toFixed(1) + '%';
            };

            // Global reset modal logic
            function initResetModal() {
                const resetModal = document.getElementById('reset-confirm-modal');
                const resetContent = document.getElementById('reset-modal-content');
                const btnOpenReset = document.getElementById('btn-reset');
                const btnCancelReset = document.getElementById('btn-cancel-reset');
                const btnConfirmReset = document.getElementById('btn-confirm-reset');

                const openModal = (e) => {
                    if (e) e.preventDefault();
                    if (!resetModal) return;
                    resetModal.classList.remove('hidden');
                    resetModal.classList.add('flex');
                    void resetModal.offsetWidth;
                    resetModal.classList.remove('opacity-0');
                    if (resetContent) {
                        resetContent.classList.remove('scale-95');
                        resetContent.classList.add('scale-100');
                    }
                };

                const closeModal = () => {
                    if (!resetModal) return;
                    resetModal.classList.add('opacity-0');
                    if (resetContent) {
                        resetContent.classList.remove('scale-100');
                        resetContent.classList.add('scale-95');
                    }
                    setTimeout(() => {
                        resetModal.classList.add('hidden');
                        resetModal.classList.remove('flex');
                    }, 200);
                };

                if (btnOpenReset) btnOpenReset.onclick = openModal;
                if (btnCancelReset) btnCancelReset.onclick = closeModal;
                if (resetModal) {
                    resetModal.onclick = (e) => {
                        if (e.target === resetModal) closeModal();
                    };
                }
                if (btnConfirmReset) {
                    btnConfirmReset.onclick = () => {
                        localStorage.removeItem('gateCivilTracker2027');
                        window.saveState(JSON.parse(JSON.stringify(defaultState)));
                        window.location.reload();
                    };
                }
            }

            initResetModal();
            document.addEventListener('astro:page-load', initResetModal);

            // Activity Logging Modal Logic
            function initActivityLogging() {
                const modal = document.getElementById('log-activity-modal');
                const content = document.getElementById('log-modal-content');
                const form = document.getElementById('form-log-activity');
                
                const typeInput = document.getElementById('log-type');
                const subjectSelect = document.getElementById('log-subject');
                const subjectLockedDisplay = document.getElementById('log-subject-locked');
                const subtypeSelect = document.getElementById('log-subtype');
                const amountInput = document.getElementById('log-amount');
                const pyqYearInput = document.getElementById('log-pyq-year');
                const nameInput = document.getElementById('log-name');
                const mockMarksInput = document.getElementById('log-mock-marks');
                const mockPercentileInput = document.getElementById('log-mock-percentile');
                const notesInput = document.getElementById('log-notes');
                const hoursInput = document.getElementById('log-hours');
                const fieldMockExtra = document.getElementById('log-field-mock-extra');
                
                const fieldSubject = document.getElementById('log-field-subject');
                const fieldPyqYear = document.getElementById('log-field-pyq-year');
                const fieldSubtype = document.getElementById('log-field-subtype');
                const fieldAmount = document.getElementById('log-field-amount');
                const fieldName = document.getElementById('log-field-name');
                const fieldTopic = document.getElementById('log-field-topic');
                const topicSelect = document.getElementById('log-topic');
                const labelSubtype = document.getElementById('log-label-subtype');
                const labelAmount = document.getElementById('log-label-amount');
                
                const formError = document.getElementById('log-form-error');
                const formErrorText = document.getElementById('log-form-error-text');

                const currentYear = new Date().getFullYear();
                let isSubmitting = false;

                const showError = (msg) => {
                    isSubmitting = false;
                    const submitBtn = form?.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }
                    if(formError && formErrorText) {
                        formErrorText.textContent = msg;
                        formError.classList.remove('hidden');
                        formError.classList.add('flex');
                    }
                };
                
                const hideError = () => {
                    if(formError) {
                        formError.classList.add('hidden');
                        formError.classList.remove('flex');
                    }
                };

                const updateTopicList = (state) => {
                    const currentType = typeInput.value;
                    const currentSubtype = subtypeSelect.value;
                    const subjectId = subjectSelect.value;
                    
                    if (currentType === 'test' && currentSubtype === 'topic') {
                        fieldTopic.classList.remove('hidden');
                        if (subjectId && subjectId !== 'general') {
                            const sub = state.subjects?.find(s => s.id === subjectId);
                            if (sub && sub.topics) {
                                let html = '<option value="" disabled selected>Select a Topic</option>';
                                sub.topics.forEach((t) => {
                                    html += `<option value="${t.name}">${t.name}</option>`;
                                });
                                topicSelect.innerHTML = html;
                            } else {
                                topicSelect.innerHTML = '<option value="" disabled selected>No topics available</option>';
                            }
                        } else {
                            topicSelect.innerHTML = '<option value="" disabled selected>Select a subject first</option>';
                        }
                    } else {
                        fieldTopic.classList.add('hidden');
                        topicSelect.innerHTML = '';
                    }
                };

                const updateSubjectsList = (state) => {
                    const currentType = typeInput.value;
                    const currentSubtype = subtypeSelect.value;
                    let html = '<option value="" disabled selected>Select a Subject</option>';
                    
                    if (state.subjects) {
                        state.subjects.forEach(sub => {
                            let disabledStr = '';
                            let labelStr = sub.name;

                            if (currentType === 'pyq') {
                                const pyqData = state.pyqs?.[sub.id];
                                if (pyqData) {
                                    const solvedCount = state.pyqHistory 
                                        ? state.pyqHistory.filter(h => h.subjectId === sub.id).length 
                                        : (pyqData.solved || 0);
                                    const total = pyqData.total || 0;
                                    const isComplete = total > 0 && solvedCount >= total;
                                    if (isComplete) {
                                        disabledStr = ' disabled';
                                        labelStr = `${sub.name} ✓ (${solvedCount}/${total} Completed)`;
                                    } else {
                                        labelStr = `${sub.name} (${solvedCount}${total > 0 ? `/${total} years logged` : ' years logged'})`;
                                    }
                                }
                            } else if (currentType === 'test') {
                                if (currentSubtype === 'subject' && state.testHistory) {
                                    const alreadyDone = state.testHistory.some(t => t.testType === 'subject' && t.subjectId === sub.id);
                                    if (alreadyDone) {
                                        disabledStr = ' disabled';
                                        labelStr = `${sub.name} ✓ (Subject Test Done)`;
                                    }
                                }
                            } else if (currentType === 'revision') {
                                if (currentSubtype && state.revisionHistory) {
                                    const alreadyLogged = state.revisionHistory.some(r => r.subjectId === sub.id && r.revisionType === currentSubtype);
                                    if (alreadyLogged) {
                                        disabledStr = ' disabled';
                                        labelStr = `${sub.name} ✓ (${currentSubtype} done)`;
                                    }
                                }
                            }
                            
                            html += `<option value="${sub.id}"${disabledStr}>${labelStr}</option>`;
                        });
                    }
                    
                    const prevVal = subjectSelect.value;
                    subjectSelect.innerHTML = html;
                    
                    if (prevVal) {
                        const prevOption = subjectSelect.querySelector(`option[value="${prevVal}"]`);
                        if (prevOption && !prevOption.disabled) {
                            subjectSelect.value = prevVal;
                        } else {
                            subjectSelect.value = '';
                        }
                    }
                    
                    updateTopicList(state);
                };

                subtypeSelect.removeEventListener('change', subtypeSelect._subtypeChangeHandler);
                subtypeSelect._subtypeChangeHandler = () => {
                    updateSubjectsList(window.getState());
                    updateTopicList(window.getState());
                };
                subtypeSelect.addEventListener('change', subtypeSelect._subtypeChangeHandler);

                subjectSelect.removeEventListener('change', subjectSelect._subjectChangeHandler);
                subjectSelect._subjectChangeHandler = () => {
                    updateTopicList(window.getState());
                };
                subjectSelect.addEventListener('change', subjectSelect._subjectChangeHandler);

                [amountInput, pyqYearInput, mockMarksInput, mockPercentileInput, hoursInput].forEach(input => {
                    if (input) {
                        input.removeEventListener('change', input._clampHandler);
                        input._clampHandler = (e) => {
                            const target = e.target;
                            if (target.value === '') return;
                            let val = parseFloat(target.value);
                            
                            const minStr = target.getAttribute('min');
                            if (minStr !== null && !isNaN(val)) {
                                const min = parseFloat(minStr);
                                if (val < min) {
                                    target.value = min;
                                    val = min;
                                }
                            }
                            
                            const maxStr = target.getAttribute('max');
                            if (maxStr !== null && !isNaN(val)) {
                                const max = parseFloat(maxStr);
                                if (val > max) {
                                    target.value = max;
                                }
                            }
                        };
                        input.addEventListener('change', input._clampHandler);
                    }
                });

                const openLogModal = (type, preselectedSubject = null) => {
                    if (!modal) return;
                    typeInput.value = type;
                    const state = window.getState();
                    
                    fieldSubject.classList.remove('hidden');
                    if (fieldPyqYear) fieldPyqYear.classList.add('hidden');
                    fieldSubtype.classList.add('hidden');
                    fieldAmount.classList.add('hidden');
                    fieldName.classList.add('hidden');
                    fieldTopic.classList.add('hidden');
                    if (fieldMockExtra) fieldMockExtra.classList.add('hidden');
                    
                    amountInput.value = 1;
                    amountInput.min = 1;
                    amountInput.removeAttribute('max');
                    if (pyqYearInput) pyqYearInput.value = '';
                    nameInput.value = '';
                    if (mockMarksInput) mockMarksInput.value = '';
                    if (mockPercentileInput) mockPercentileInput.value = '';
                    if (notesInput) notesInput.value = '';
                    if (hoursInput) hoursInput.value = '';
                    subtypeSelect.innerHTML = '';
                    
                    if (type === 'pyq') {
                        if (fieldPyqYear) fieldPyqYear.classList.remove('hidden');
                        if (pyqYearInput) {
                            pyqYearInput.min = currentYear - 49;
                            pyqYearInput.max = currentYear;
                            pyqYearInput.placeholder = `e.g. ${currentYear}`;
                        }
                    } else if (type === 'test') {
                        fieldSubtype.classList.remove('hidden');
                        labelSubtype.textContent = 'Test Type';
                        
                        const topicCompleted = state.testHistory ? state.testHistory.filter(t => t.testType === 'topic').length : (state.tests?.topic?.completed || 0);
                        const topicTotal = state.tests?.topic?.total || 40;
                        const subjectCompleted = state.testHistory ? state.testHistory.filter(t => t.testType === 'subject').length : (state.tests?.subject?.completed || 0);
                        const subjectTotal = state.tests?.subject?.total || 10;

                        const isTopicMax = topicCompleted >= topicTotal;
                        const isSubjectMax = subjectCompleted >= subjectTotal;

                        let testOptions = '';
                        testOptions += `<option value="topic"${isTopicMax ? ' disabled' : ''}>Topic Test (${topicCompleted}/${topicTotal}${isTopicMax ? ' — All Done!' : ' remaining'})</option>`;
                        testOptions += `<option value="subject"${isSubjectMax ? ' disabled' : ''}>Subject Test (${subjectCompleted}/${subjectTotal}${isSubjectMax ? ' — All Done!' : ' remaining'})</option>`;
                        subtypeSelect.innerHTML = testOptions;

                        if (!isTopicMax) {
                            subtypeSelect.value = 'topic';
                        } else if (!isSubjectMax) {
                            subtypeSelect.value = 'subject';
                        } else {
                            subtypeSelect.value = 'topic';
                        }
                    } else if (type === 'mock') {
                        fieldSubject.classList.add('hidden');
                        fieldName.classList.remove('hidden');
                        if (fieldMockExtra) fieldMockExtra.classList.remove('hidden');
                        
                        const mocksCount = state.mocksHistory ? state.mocksHistory.length : (state.mocks?.completed || 0);
                        const mocksTotal = state.mocks?.total || 20;
                        
                        if (mocksCount >= mocksTotal) {
                            nameInput.value = '';
                            nameInput.placeholder = `All ${mocksTotal} Mocks Completed`;
                        } else {
                            nameInput.value = `Mock Test ${mocksCount + 1}`;
                            nameInput.placeholder = `e.g. MADE Easy Mock ${mocksCount + 1}`;
                        }
                    } else if (type === 'revision') {
                        fieldSubtype.classList.remove('hidden');
                        labelSubtype.textContent = 'Revision Phase';

                        const revTotal = state.revision?.total || (state.subjects ? state.subjects.length : 9);
                        const rev1Count = state.revisionHistory ? state.revisionHistory.filter(r => r.revisionType === '1st').length : (state.revision?.['1st'] || 0);
                        const rev2Count = state.revisionHistory ? state.revisionHistory.filter(r => r.revisionType === '2nd').length : (state.revision?.['2nd'] || 0);
                        const revFinalCount = state.revisionHistory ? state.revisionHistory.filter(r => r.revisionType === 'final').length : (state.revision?.final || 0);

                        const is1stComplete = rev1Count >= revTotal;
                        const is2ndComplete = rev2Count >= revTotal;

                        let subtypeOptions = '';
                        subtypeOptions += `<option value="1st">1st Revision (${rev1Count}/${revTotal})</option>`;
                        subtypeOptions += `<option value="2nd"${!is1stComplete ? ' disabled' : ''}>2nd Revision (${rev2Count}/${revTotal}${!is1stComplete ? ' - Locked' : ''})</option>`;
                        subtypeOptions += `<option value="final"${!is2ndComplete ? ' disabled' : ''}>Final Revision (${revFinalCount}/${revTotal}${!is2ndComplete ? ' - Locked' : ''})</option>`;
                        subtypeSelect.innerHTML = subtypeOptions;

                        if (!is1stComplete) {
                            subtypeSelect.value = '1st';
                        } else if (!is2ndComplete) {
                            subtypeSelect.value = '2nd';
                        } else {
                            subtypeSelect.value = 'final';
                        }
                    }

                    updateSubjectsList(state);
                    if (preselectedSubject && subjectSelect) {
                        const opt = subjectSelect.querySelector(`option[value="${preselectedSubject}"]`);
                        if (opt) {
                            opt.disabled = false;
                            subjectSelect.value = preselectedSubject;
                            updateTopicList(state);
                        }
                        const subObj = state.subjects ? state.subjects.find(s => s.id === preselectedSubject) : null;
                        if (subjectLockedDisplay) {
                            subjectLockedDisplay.textContent = subObj ? subObj.name : preselectedSubject;
                            subjectLockedDisplay.classList.remove('hidden');
                        }
                        subjectSelect.classList.add('hidden');
                    } else {
                        if (subjectLockedDisplay) subjectLockedDisplay.classList.add('hidden');
                        if (subjectSelect) subjectSelect.classList.remove('hidden');
                    }

                    hideError();
                    isSubmitting = false;
                    const submitBtn = form?.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }

                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    void modal.offsetWidth;
                    modal.classList.remove('opacity-0');
                    if(content) {
                        content.classList.remove('scale-95');
                        content.classList.add('scale-100');
                    }
                };

                const closeLogModal = () => {
                    if (!modal) return;
                    isSubmitting = false;
                    const submitBtn = form?.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    }
                    if (subjectLockedDisplay) subjectLockedDisplay.classList.add('hidden');
                    if (subjectSelect) subjectSelect.classList.remove('hidden');
                    modal.classList.add('opacity-0');
                    if (content) {
                        content.classList.remove('scale-100');
                        content.classList.add('scale-95');
                    }
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                    }, 200);
                };

                document.querySelectorAll('.btn-log-activity').forEach(btn => {
                    btn.removeEventListener('click', btn._logHandler);
                    btn._logHandler = (e) => {
                        const type = e.currentTarget.dataset.type;
                        const preselectedSubject = e.currentTarget.dataset.subjectId || null;
                        openLogModal(type, preselectedSubject);
                    };
                    btn.addEventListener('click', btn._logHandler);
                });

                document.querySelectorAll('.btn-close-log').forEach(btn => {
                    btn.onclick = closeLogModal;
                });
                
                if (modal) {
                    modal.onclick = (e) => {
                        if (e.target === modal) closeLogModal();
                    };
                }

                if (form) {
                    form.onsubmit = (e) => {
                        e.preventDefault();
                        if (isSubmitting) return;
                        isSubmitting = true;
                        const submitBtn = form.querySelector('button[type="submit"]');
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                        }
                        hideError();
                        const state = window.getState();
                        const type = typeInput.value;
                        const today = new Date().toISOString().split('T')[0];
                        const id = 'act_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                        const subjectId = subjectSelect.value;
                        const hours = hoursInput && hoursInput.value !== '' ? parseFloat(hoursInput.value) : null;
                        const notes = notesInput && notesInput.value ? notesInput.value.trim() : null;
                        
                        if (notes) {
                            const wordCount = notes.split(/\s+/).filter(word => word.length > 0).length;
                            if (wordCount > 100) {
                                showError('Notes cannot exceed 100 words.');
                                return;
                            }
                        }

                        const subName = (sid) => {
                            const s = state.subjects?.find(x => x.id === sid);
                            return s ? s.name : sid;
                        };

                        if (type === 'pyq') {
                            if (!subjectId || subjectId === 'general') {
                                showError('Please select a specific subject for PYQs.');
                                return;
                            }
                            const pyqData = state.pyqs?.[subjectId];
                            if (!pyqData) {
                                showError('Invalid subject selected.');
                                return;
                            }
                            
                            const yearVal = pyqYearInput ? parseInt(pyqYearInput.value) : NaN;
                            if (isNaN(yearVal)) {
                                showError('Please enter or select a valid GATE PYQ year.');
                                return;
                            }
                            const minYear = currentYear - 49;
                            if (yearVal < minYear) {
                                showError(`GATE PYQ year cannot be before year ${minYear}.`);
                                return;
                            }
                            if (yearVal > currentYear) {
                                showError(`You cannot log PYQs for future years (up to ${currentYear}).`);
                                return;
                            }

                            const currentSolved = state.pyqHistory 
                                ? state.pyqHistory.filter(h => h.subjectId === subjectId).length 
                                : (pyqData.solved || 0);
                            const total = pyqData.total || 0;

                            if (total > 0 && currentSolved >= total) {
                                showError(`All ${total} PYQ target years for ${subName(subjectId)} are already completed!`);
                                return;
                            }

                            if(!state.pyqHistory) state.pyqHistory = [];
                            state.pyqHistory.push({ id, subjectId, pyqYear: yearVal, date: today, hours, notes });
                        } else if (type === 'test') {
                            const testType = subtypeSelect.value;
                            if (!subjectId) {
                                showError('Please select a subject for this test.');
                                return;
                            }
                            
                            const topicCompleted = state.testHistory ? state.testHistory.filter(t => t.testType === 'topic').length : 0;
                            const topicTotal = state.tests?.topic?.total || 40;
                            const subjectCompleted = state.testHistory ? state.testHistory.filter(t => t.testType === 'subject').length : 0;
                            const subjectTotal = state.tests?.subject?.total || 10;

                            if (testType === 'topic') {
                                if (!topicSelect.value) {
                                    showError('Please select a specific topic for this test.');
                                    return;
                                }
                                // Topic tests: multiple allowed per subject, only total cap matters
                                if (topicCompleted >= topicTotal) {
                                    showError(`You have reached the Topic Test target of ${topicTotal}. Well done!`);
                                    return;
                                }
                                // No per-subject restriction for topic tests
                            } else if (testType === 'subject') {
                                // Subject tests: 1 per subject, plus total cap
                                if (subjectCompleted >= subjectTotal) {
                                    showError(`You have reached the Subject Test target of ${subjectTotal}. Well done!`);
                                    return;
                                }
                                const alreadyDone = state.testHistory && state.testHistory.some(t => t.testType === 'subject' && t.subjectId === subjectId);
                                if (alreadyDone) {
                                    showError('A Subject Test for this subject is already logged. Each subject gets one subject test.');
                                    return;
                                }
                            }

                            if(!state.testHistory) state.testHistory = [];
                            state.testHistory.push({ id, testType, subjectId, topicName: topicSelect.value, date: today, hours, notes });
                        } else if (type === 'mock') {
                            const mocksCount = state.mocksHistory ? state.mocksHistory.length : 0;
                            const mocksTotal = state.mocks?.total || 20;

                            if (mocksCount >= mocksTotal) {
                                showError(`All ${mocksTotal} Full-Length Mocks target has already been completed!`);
                                return;
                            }

                            const name = (nameInput.value || '').trim();
                            if (!name) {
                                showError('Please enter a mock test name.');
                                return;
                            }

                            if (state.mocksHistory && state.mocksHistory.some(m => m.name.toLowerCase() === name.toLowerCase())) {
                                showError(`A mock with the name "${name}" has already been logged. Please use a distinct name.`);
                                return;
                            }

                            const marks = mockMarksInput && mockMarksInput.value !== '' ? parseFloat(mockMarksInput.value) : null;
                            const percentile = mockPercentileInput && mockPercentileInput.value !== '' ? parseFloat(mockPercentileInput.value) : null;

                            if (marks === null) {
                                showError('Marks scored is required.');
                                return;
                            }
                            if (isNaN(marks) || marks < 0 || marks > 100) {
                                showError('Marks must be between 0 and 100.');
                                return;
                            }
                            if (percentile !== null && (isNaN(percentile) || percentile < 0 || percentile > 100)) {
                                showError('Percentile must be between 0 and 100.');
                                return;
                            }

                            if(!state.mocksHistory) state.mocksHistory = [];
                            state.mocksHistory.push({ id, name, date: today, marks, percentile, hours, notes });
                        } else if (type === 'revision') {
                            const revisionType = subtypeSelect.value;
                            if (!subjectId || subjectId === 'general') {
                                showError('Please select a specific subject for revision.');
                                return;
                            }
                            
                            const revTotal = state.revision?.total || (state.subjects ? state.subjects.length : 9);
                            const rev1Count = state.revisionHistory ? state.revisionHistory.filter(r => r.revisionType === '1st').length : (state.revision?.['1st'] || 0);
                            const rev2Count = state.revisionHistory ? state.revisionHistory.filter(r => r.revisionType === '2nd').length : (state.revision?.['2nd'] || 0);

                            if (revisionType === '2nd' && rev1Count < revTotal) {
                                showError(`You must complete all ${revTotal} subjects in 1st Revision (${rev1Count}/${revTotal}) before starting 2nd Revision.`);
                                return;
                            }
                            if (revisionType === 'final' && rev2Count < revTotal) {
                                showError(`You must complete all ${revTotal} subjects in 2nd Revision (${rev2Count}/${revTotal}) before starting Final Revision.`);
                                return;
                            }

                            if (state.revisionHistory && state.revisionHistory.some(r => r.subjectId === subjectId && r.revisionType === revisionType)) {
                                showError(`This subject has already been logged for ${revisionType} Revision.`);
                                return;
                            }

                            if(!state.revisionHistory) state.revisionHistory = [];
                            state.revisionHistory.push({ id, subjectId, revisionType, date: today, hours, notes });
                        }
                        
                        window.saveState(state);
                        closeLogModal();
                    };
                }
            }

            // Activity History Modal Logic
            function initActivityHistory() {
                const modal = document.getElementById('activity-history-modal');
                const content = document.getElementById('history-modal-content');
                const listContainer = document.getElementById('history-list');

                const openHistoryModal = (filterType = null) => {
                    if (!modal) return;
                    _currentHistoryFilter = filterType;
                    renderHistoryList(filterType);
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    void modal.offsetWidth;
                    modal.classList.remove('opacity-0');
                    if(content) {
                        content.classList.remove('scale-95');
                        content.classList.add('scale-100');
                    }
                };

                const closeHistoryModal = () => {
                    if (!modal) return;
                    modal.classList.add('opacity-0');
                    if(content) {
                        content.classList.remove('scale-100');
                        content.classList.add('scale-95');
                    }
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                    }, 200);
                };

                document.querySelectorAll('.btn-activity-history').forEach(btn => {
                    btn.removeEventListener('click', btn._histHandler);
                    btn._histHandler = (e) => {
                        const filter = e.currentTarget.dataset.filter || null;
                        openHistoryModal(filter);
                    };
                    btn.addEventListener('click', btn._histHandler);
                });

                document.querySelectorAll('.btn-close-history').forEach(btn => {
                    btn.onclick = closeHistoryModal;
                });
                
                if (modal) {
                    modal.onclick = (e) => {
                        if (e.target === modal) closeHistoryModal();
                    };
                }

                function renderHistoryList(filterType) {
                    if(!listContainer) return;
                    const state = window.getState();
                    let allRecords = [];
                    
                    const subName = (id) => {
                        if (id === 'general') return 'General';
                        const s = state.subjects?.find(x => x.id === id);
                        return s ? s.name : id;
                    };
                    
                    if (state.pyqHistory && (!filterType || filterType === 'pyq')) {
                        allRecords = allRecords.concat(state.pyqHistory.map(r => ({
                            ...r,
                            _type: 'PYQ',
                            _title: r.pyqYear 
                                ? `GATE ${r.pyqYear} PYQ (${subName(r.subjectId)})` 
                                : `${r.solved || 1} PYQs Solved (${subName(r.subjectId)})`,
                            _extras: r.hours ? `${r.hours} hrs` : null
                        })));
                    }
                    if (state.testHistory && (!filterType || filterType === 'test')) {
                        allRecords = allRecords.concat(state.testHistory.map(r => ({ ...r, _type: 'Test', _title: `${r.testType === 'topic' ? 'Topic' : 'Subject'} Test${r.topicName ? `: ${r.topicName}` : ''} (${subName(r.subjectId)})`, _extras: r.hours ? `${r.hours} hrs` : null })));
                    }
                    if (state.mocksHistory && (!filterType || filterType === 'mock')) {
                        allRecords = allRecords.concat(state.mocksHistory.map(r => {
                            const extras = [];
                            if (r.marks !== null && r.marks !== undefined) extras.push(`${r.marks}/100 Marks`);
                            if (r.percentile !== null && r.percentile !== undefined) extras.push(`${r.percentile}%ile`);
                            if (r.hours !== null && r.hours !== undefined) extras.push(`${r.hours} hrs`);
                            return { ...r, _type: 'Mock', _title: `Full Mock: ${r.name}`, _extras: extras.length ? extras.join(' · ') : null };
                        }));
                    }
                    if (state.revisionHistory && (!filterType || filterType === 'revision')) {
                        allRecords = allRecords.concat(state.revisionHistory.map(r => ({ ...r, _type: 'Revision', _title: `${r.revisionType} Revision (${subName(r.subjectId)})`, _extras: r.hours ? `${r.hours} hrs` : null })));
                    }
                    
                    allRecords.sort((a, b) => b.id.localeCompare(a.id));
                    
                    if (allRecords.length === 0) {
                        listContainer.innerHTML = '<div class="text-center text-text-muted p-4 text-sm">No activity recorded yet.</div>';
                        return;
                    }
                    
                    listContainer.innerHTML = allRecords.map(r => `
                        <div class="flex items-center justify-between bg-white/5 border border-white/10 rounded-xl p-3 hover:bg-white/10 transition-colors">
                            <div class="flex flex-col min-w-0 flex-1">
                                <div class="text-sm font-semibold text-white">
                                    <div class="truncate">${r._title}</div>
                                    ${r._extras ? `<div class="text-xs text-primary-accent/80 font-medium mt-0.5">${r._extras}</div>` : ''}
                                    ${r.notes ? `<div class="text-xs text-text-muted mt-1.5 bg-black/20 p-2 rounded-lg border border-white/5 break-words whitespace-pre-wrap font-normal leading-relaxed">${r.notes}</div>` : ''}
                                </div>
                                <div class="flex items-center gap-2 text-xs text-text-muted mt-2">
                                    <span class="px-1.5 py-0.5 rounded bg-black/40 text-[10px] uppercase font-bold tracking-wider border border-white/5">${r._type}</span>
                                    <span>${r.date}</span>
                                </div>
                            </div>
                            <button class="btn-delete-record p-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors shrink-0 ml-3" data-id="${r.id}" data-type="${r._type}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                            </button>
                        </div>
                    `).join('');

                    listContainer.querySelectorAll('.btn-delete-record').forEach(btn => {
                        btn.onclick = (e) => {
                            const id = e.currentTarget.dataset.id;
                            const type = e.currentTarget.dataset.type;
                            deleteRecord(id, type);
                        };
                    });
                }
                
                // Track current history filter so delete re-renders with the same filter
                let _currentHistoryFilter = null;

                function deleteRecord(id, type) {
                    const state = window.getState();
                    
                    if (type === 'PYQ') state.pyqHistory = (state.pyqHistory || []).filter(r => r.id !== id);
                    if (type === 'Test') state.testHistory = (state.testHistory || []).filter(r => r.id !== id);
                    if (type === 'Mock') state.mocksHistory = (state.mocksHistory || []).filter(r => r.id !== id);
                    if (type === 'Revision') state.revisionHistory = (state.revisionHistory || []).filter(r => r.id !== id);
                    
                    window.saveState(state);
                    // Re-render with the same filter that was active when history was opened
                    renderHistoryList(_currentHistoryFilter);
                    if (window.location.pathname === '/') {
                        window.location.reload();
                    }
                }
            }

            initActivityLogging();
            document.addEventListener('astro:page-load', initActivityLogging);
            initActivityHistory();
            document.addEventListener('astro:page-load', initActivityHistory);

            // Global listeners

            document.getElementById('btn-export')?.addEventListener('click', () => {
                const state = window.getState();
                state.exportedOnce = true;
                window.saveState(state);
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
                const dlAnchorElem = document.createElement('a');
                dlAnchorElem.setAttribute("href", dataStr);
                dlAnchorElem.setAttribute("download", "gate-civil-tracker-2027.json");
                dlAnchorElem.click();
            });

            document.getElementById('import-file')?.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if(!file) return;
                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const importedState = JSON.parse(event.target.result);
                        if(importedState && importedState.subjects) {
                            importedState.importedOnce = true;
                            window.saveState(importedState);
                            alert('Progress imported successfully!');
                            window.location.reload();
                        } else {
                            alert('Invalid file format.');
                        }
                    } catch(err) {
                        alert('Error parsing file.');
                    }
                };
                reader.readAsText(file);
            });
        </script>
        {!isHome && (
            <div class="absolute w-0 h-0 overflow-hidden opacity-0 pointer-events-none" style="top: -9999px; left: -9999px;" aria-hidden="true">
                <spline-viewer 
                    id="hero-spline-viewer"
                    transition:persist="hero-spline"
                    class="w-full h-full pointer-events-none transition-opacity duration-500 opacity-0"
                    style="filter: sepia(1) hue-rotate(95deg) saturate(1.5) brightness(0.95) contrast(1.1);"
                    url="/scene.splinecode"
                    background="transparent"
                    loading-anim-type="none"
                    events-target="global"
                ></spline-viewer>
            </div>
        )}
	</body>
</html>
