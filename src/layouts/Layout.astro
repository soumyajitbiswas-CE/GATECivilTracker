---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import FallingLeaves from '../components/FallingLeaves.astro';
import AchievementNotification from '../components/AchievementNotification.astro';
interface Props {
	title: string;
    description?: string;
}

const { title, description = "GATE Civil Engineering Preparation Tracker" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="theme-color" content="#030a07" />
		<meta name="mobile-web-app-capable" content="yes" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
        <ViewTransitions />
	</head>
	<body class="min-h-screen">
        <div class="site-bg" aria-hidden="true"></div>
        <FallingLeaves />
        <AchievementNotification />
        <div class="app-container flex flex-col gap-5 sm:gap-6 relative z-0">
            <!-- Header -->
            <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-panel-border gap-3.5 sm:gap-4 min-w-0">
                <div class="flex flex-col min-w-0 flex-1">
                    <a href="/" class="text-2xl sm:text-[28px] font-[Outfit] font-semibold flex items-center gap-2.5 text-white tracking-tight break-words leading-none hover:opacity-90 transition-opacity w-fit" style="letter-spacing: -0.01em;">
                        <img src="/favicon.jpg" alt="Logo" class="w-7 h-7 sm:w-8 sm:h-8 rounded object-cover border border-primary-accent/30 shrink-0 drop-shadow-[0_0_8px_rgba(74,222,128,0.3)]" />
                        <span class="truncate mt-0.5 text-[0.95em]">GATE CIVIL <span class="text-primary-accent">TRACKER</span></span>
                    </a>
                    <p class="text-text-muted text-xs sm:text-[13.5px] mt-2 leading-relaxed break-words max-w-3xl pr-4">Track your syllabus, PYQs, tests, full-length mocks & revisions — progress automatically saved to your browser.</p>
                </div>
                
                <!-- Buttons Wrapper -->
                <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 sm:gap-2.5 md:gap-3 w-full sm:w-auto shrink-0">
                    <a href="/achievements" class="btn hover:text-white text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center flex items-center gap-1.5 border-primary-accent/30 bg-primary-accent/5 hover:bg-primary-accent/20">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                        Achievements
                    </a>
                    <button class="btn text-red-400 hover:text-red-300 hover:border-red-400/30 hover:bg-red-400/10 text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center" id="btn-reset">Reset</button>
                    <button class="btn hover:text-white text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center" id="btn-export">Export</button>
                    <label class="btn hover:text-white cursor-pointer text-xs sm:text-sm px-3 sm:px-4 py-2 justify-center">
                        Import
                        <input type="file" id="import-file" class="hidden" accept=".json">
                    </label>
                </div>
            </header>
            
		    <slot />
        </div>

        <script>
            // @ts-nocheck
            import { defaultState } from '../data.js';
            import { evaluateAchievements } from '../utils/achievementEngine.js';
            import achievementsData from '../data/achievements.json';
            
            // Global helper functions to attach to window for cross-page use
            window.getState = () => {
                const saved = localStorage.getItem('gateCivilTracker2027');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if(!parsed.pyqs) parsed.pyqs = defaultState.pyqs;
                    if(!parsed.settings) parsed.settings = defaultState.settings;
                    if(!parsed.settings.weights) parsed.settings.weights = defaultState.settings.weights;
                    if(!parsed.achievements) parsed.achievements = defaultState.achievements;
                    if(!parsed.streaks) parsed.streaks = defaultState.streaks;
                    return parsed;
                }
                return JSON.parse(JSON.stringify(defaultState));
            };

            window.saveState = (state) => {
                // Ensure metrics are calculated before evaluating achievements
                window.calculateAllMetrics(state);
                
                const newUnlocks = evaluateAchievements(state, achievementsData.achievements);
                
                localStorage.setItem('gateCivilTracker2027', JSON.stringify(state));
                
                if (newUnlocks && newUnlocks.length > 0) {
                    window.dispatchEvent(new CustomEvent('achievementsUnlocked', { detail: newUnlocks }));
                }

                // Dispatch custom event so components know state changed
                window.dispatchEvent(new Event('stateChanged'));
            };

            window.calculateAllMetrics = (state) => {
                let overallSyllabusWeightCompleted = 0;
                let totalSubjectTrackerWeight = 0;
                
                state.subjects.forEach(subject => {
                    let subjectTotalWeight = 0;
                    let subjectCompletedWeight = 0;
                    let subjectHours = 0;
                    
                    subject.topics.forEach(t => {
                        subjectTotalWeight += (t.trackerWeight || 0);
                        if (t.completed) {
                            subjectCompletedWeight += (t.trackerWeight || 0);
                        }
                    });
                    
                    state.studyHistory.forEach(entry => {
                        if (entry.subjectId === subject.id) {
                            subjectHours += entry.hours;
                        }
                    });
                    
                    subject.progress = subjectTotalWeight === 0 ? 0 : (subjectCompletedWeight / subjectTotalWeight) * 100;
                    subject.hours = subjectHours;
                    overallSyllabusWeightCompleted += (subject.progress / 100) * (subject.trackerWeight || 0);
                    totalSubjectTrackerWeight += (subject.trackerWeight || 0);
                });
                
                // 1. Syllabus Progress: 0% to 100% based on all subject sub-topic completions
                state.overallSyllabusProgress = totalSubjectTrackerWeight === 0 ? 0 : (overallSyllabusWeightCompleted / totalSubjectTrackerWeight) * 100;
                state.totalHours = state.studyHistory.reduce((acc, curr) => acc + curr.hours, 0);
                
                // 2. PYQs Progress: 0% to 100% based on questions solved vs total across all subjects
                let pyqTotal = 0, pyqSolved = 0;
                Object.values(state.pyqs).forEach(p => { pyqTotal += (p.total || 0); pyqSolved += (p.solved || 0); });
                state.pyqProgress = pyqTotal === 0 ? 0 : (pyqSolved / pyqTotal) * 100;
                
                // 3. Tests Progress: 0% to 100% based on topic + subject tests completed vs targets
                const totalTests = ((state.tests?.topic?.total || 0) + (state.tests?.subject?.total || 0));
                state.testProgress = totalTests === 0 ? 0 : (((state.tests?.topic?.completed || 0) + (state.tests?.subject?.completed || 0)) / totalTests) * 100;
                
                // 4. Mocks Progress: 0% to 100% based on full-length mocks completed vs target
                const totalMocks = (state.mocks?.total || 0);
                state.mockProgress = totalMocks === 0 ? 0 : ((state.mocks?.completed || 0) / totalMocks) * 100;
                
                // 5. Revision Progress: 0% to 100% based on 1st, 2nd, and final revision rounds (total subjects * 3)
                const totalRevisionTarget = (state.revision?.total || 9) * 3;
                const totalRevisionCompleted = (state.revision?.['1st'] || 0) + (state.revision?.['2nd'] || 0) + (state.revision?.final || 0);
                state.revisionProgress = totalRevisionTarget === 0 ? 0 : (totalRevisionCompleted / totalRevisionTarget) * 100;
                
                // 6. Overall GATE Readiness: Weighted composition of all 5 independent 100% pillars
                const w = state.settings?.weights || defaultState.settings.weights;
                const totalWeights = (w.syllabus + w.pyqs + w.tests + w.mocks + w.revision) || 1;
                state.gateReadiness = ((state.overallSyllabusProgress * w.syllabus) + 
                                      (state.pyqProgress * w.pyqs) + 
                                      (state.testProgress * w.tests) + 
                                      (state.mockProgress * w.mocks) + 
                                      (state.revisionProgress * w.revision)) / totalWeights;
            };

            window.formatHours = (hours) => {
                const h = Math.floor(hours);
                const m = Math.round((hours - h) * 60);
                if (m === 0) return `${h}h`;
                if (h === 0) return `${m}m`;
                return `${h}h ${m}m`;
            };

            window.formatPercent = (value) => {
                return value.toFixed(1) + '%';
            };

            // Global listeners
            document.getElementById('btn-reset')?.addEventListener('click', () => {
                if(confirm('Are you sure you want to reset all progress? This cannot be undone.')) {
                    window.saveState(JSON.parse(JSON.stringify(defaultState)));
                    window.location.reload();
                }
            });

            document.getElementById('btn-export')?.addEventListener('click', () => {
                const state = window.getState();
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
                const dlAnchorElem = document.createElement('a');
                dlAnchorElem.setAttribute("href", dataStr);
                dlAnchorElem.setAttribute("download", "gate-civil-tracker-2027.json");
                dlAnchorElem.click();
            });

            document.getElementById('import-file')?.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if(!file) return;
                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const importedState = JSON.parse(event.target.result);
                        if(importedState && importedState.subjects) {
                            window.saveState(importedState);
                            alert('Progress imported successfully!');
                            window.location.reload();
                        } else {
                            alert('Invalid file format.');
                        }
                    } catch(err) {
                        alert('Error parsing file.');
                    }
                };
                reader.readAsText(file);
            });
        </script>
	</body>
</html>
