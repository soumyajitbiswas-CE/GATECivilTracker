---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Contact Us | GATE Civil Tracker" 
    description="Get in touch with the developer of GATE Civil Tracker. Report bugs, suggest features, share feedback, or connect directly on LinkedIn & GitHub."
>
    <div class="flex flex-col gap-6 sm:gap-8 min-w-0 pb-6">
        <!-- Back Navigation -->
        <div class="mb-1">
            <a href="/" class="btn text-xs sm:text-sm px-3.5 sm:px-4 py-2 inline-flex items-center gap-2 border border-white/15 bg-white/5 active:scale-95 touch-manipulation cursor-pointer select-none group">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left shrink-0 text-primary-accent group-hover:-translate-x-0.5 transition-transform pointer-events-none"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                <span>Back to Dashboard</span>
            </a>
        </div>

        <!-- Hero Header -->
        <div class="surface-hero backdrop-blur-md border border-panel-border rounded-2xl p-6 sm:p-10 flex flex-col gap-3 relative overflow-hidden">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-accent/10 border border-primary-accent/30 text-primary-accent text-xs font-semibold w-fit tracking-wide uppercase">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Direct Support & Inquiries
            </div>

            <h1 class="text-2xl sm:text-4xl font-[Outfit] font-bold tracking-tight text-white leading-tight">
                Contact Us & Share Feedback
            </h1>

            <p class="text-text-muted text-sm sm:text-base max-w-2xl leading-relaxed">
                Have an idea to make the tracker better? Encountered a bug, or found a missing sub-topic in the GATE CE syllabus? We would love to hear from you!
            </p>
        </div>

        <!-- Contact Channels Grid (Two Options) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
            <!-- Channel 1: LinkedIn -->
            <a href="https://www.linkedin.com/in/soumyajitbiswas-ce/" target="_blank" rel="noopener noreferrer" class="bg-[#020503] border border-panel-border hover:border-white/20 rounded-2xl p-6 flex flex-col justify-between gap-5 transition-all group">
                <div class="flex flex-col gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white shrink-0 group-hover:bg-primary-accent/10 group-hover:text-primary-accent group-hover:border-primary-accent/30 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    </div>
                    <h2 class="text-base sm:text-lg font-semibold text-white font-[Outfit]">LinkedIn</h2>
                    <p class="text-text-muted text-xs sm:text-[13px] leading-relaxed">
                        Connect with developer Soumyajit Biswas for professional networking, partnerships, or quick chats.
                    </p>
                </div>
                <div class="text-xs font-semibold text-white/80 group-hover:text-primary-accent flex items-center gap-1.5 pt-3 border-t border-white/5 transition-colors">
                    <span>Message on LinkedIn</span>
                    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
            </a>

            <!-- Channel 2: GitHub -->
            <a href="https://github.com/soumyajitbiswas-CE" target="_blank" rel="noopener noreferrer" class="bg-[#020503] border border-panel-border hover:border-white/20 rounded-2xl p-6 flex flex-col justify-between gap-5 transition-all group">
                <div class="flex flex-col gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white shrink-0 group-hover:bg-primary-accent/10 group-hover:text-primary-accent group-hover:border-primary-accent/30 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    </div>
                    <h2 class="text-base sm:text-lg font-semibold text-white font-[Outfit]">GitHub Repository</h2>
                    <p class="text-text-muted text-xs sm:text-[13px] leading-relaxed">
                        Report technical bugs, track feature updates, review code, or file feature requests directly on GitHub.
                    </p>
                </div>
                <div class="text-xs font-semibold text-white/80 group-hover:text-primary-accent flex items-center gap-1.5 pt-3 border-t border-white/5 transition-colors">
                    <span>View GitHub Profile</span>
                    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
            </a>
        </div>

        <!-- Interactive Feedback Form & Email Target -->
        <div class="bg-[#020503] border border-panel-border rounded-2xl p-6 sm:p-8 flex flex-col gap-8 mt-2">
            
            <!-- Email Info Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex flex-col gap-2">
                    <h2 class="text-xl sm:text-2xl font-bold text-white font-[Outfit] tracking-tight">
                        Send a Quick Message
                    </h2>
                    <p class="text-text-muted text-[13px] sm:text-sm">
                        Use the form below or directly email <a href="mailto:contact@gateciviltracker.com" class="text-primary-accent hover:underline decoration-primary-accent/50 underline-offset-4">contact@gateciviltracker.com</a>
                    </p>
                </div>
                <button id="btn-copy-email" type="button" class="btn text-xs px-4 py-2 flex items-center gap-2 border border-white/10 bg-white/5 hover:bg-white/10 transition-all shrink-0 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    <span id="copy-email-text">Copy Email</span>
                </button>
            </div>

            <form id="contact-form" class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
                <div class="flex flex-col gap-2">
                    <label for="sender-name" class="text-xs font-semibold text-white/90 uppercase tracking-wide">Your Name</label>
                    <input 
                        type="text" 
                        id="sender-name" 
                        required 
                        placeholder="e.g. Rahul Sharma" 
                        class="bg-white/[0.03] border border-white/10 rounded-xl p-3.5 text-[13px] text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all placeholder:text-white/20"
                    >
                </div>

                <div class="flex flex-col gap-2">
                    <label for="msg-category" class="text-xs font-semibold text-white/90 uppercase tracking-wide">Inquiry Topic</label>
                    <select 
                        id="msg-category" 
                        class="bg-[#070b09] border border-white/10 rounded-xl p-3.5 text-[13px] text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all appearance-none cursor-pointer"
                        style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2394a3b8%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m6%209%206%206%206-6%22%2F%3E%3C%2Fsvg%3E'); background-repeat: no-repeat; background-position: right 12px center; background-size: 16px;"
                    >
                        <option value="Feature Suggestion">Feature Suggestion / Idea</option>
                        <option value="Bug Report">Bug / Visual Issue Report</option>
                        <option value="Syllabus Correction">Syllabus / PYQ Topic Correction</option>
                        <option value="General Feedback">General Feedback & Encouragement</option>
                        <option value="Other Inquiry">Other Inquiry</option>
                    </select>
                </div>

                <div class="flex flex-col gap-2 md:col-span-2">
                    <label for="sender-message" class="text-xs font-semibold text-white/90 uppercase tracking-wide">Message Details</label>
                    <textarea 
                        id="sender-message" 
                        rows="5" 
                        required 
                        placeholder="Tell us what you would like to see improved, or describe any issue you encountered..." 
                        class="bg-white/[0.03] border border-white/10 rounded-xl p-3.5 text-[13px] text-white focus:outline-none focus:border-primary-accent/50 focus:ring-1 focus:ring-primary-accent/30 transition-all resize-none custom-scrollbar placeholder:text-white/20"
                    ></textarea>
                </div>

                <div class="md:col-span-2 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pt-2">
                    <div id="form-feedback" class="text-[13px] font-medium text-primary-accent hidden items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        <span>Opening your email client...</span>
                    </div>

                    <button type="submit" class="btn btn-primary text-[13px] sm:text-sm px-8 py-3 sm:ml-auto flex items-center justify-center gap-2 cursor-pointer font-semibold w-full sm:w-auto shadow-none border-primary-accent/50 hover:bg-primary-accent hover:text-[#020503] transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Draft Email
                    </button>
                </div>
            </form>
        </div>

        <Footer />
    </div>

    <script>
        // @ts-nocheck
        function initContactPage() {
            const form = document.getElementById('contact-form');
            const feedback = document.getElementById('form-feedback');
            const copyBtn = document.getElementById('btn-copy-email');
            const copyText = document.getElementById('copy-email-text');
            
            const targetEmail = "contact@gateciviltracker.com";

            // Setup Copy Button
            if (copyBtn && copyText) {
                copyBtn.onclick = () => {
                    navigator.clipboard.writeText(targetEmail).then(() => {
                        copyText.textContent = "Copied! ✓";
                        copyBtn.classList.add('bg-primary-accent/20', 'text-primary-accent', 'border-primary-accent/30');
                        setTimeout(() => {
                            copyText.textContent = "Copy Email";
                            copyBtn.classList.remove('bg-primary-accent/20', 'text-primary-accent', 'border-primary-accent/30');
                        }, 2500);
                    }).catch(() => {
                        window.location.href = `mailto:${targetEmail}`;
                    });
                };
            }

            // Setup Mailto Form
            if (form) {
                form.onsubmit = (e) => {
                    e.preventDefault();
                    const name = document.getElementById('sender-name')?.value || 'GATE CE Aspirant';
                    const category = document.getElementById('msg-category')?.value || 'Feedback';
                    const message = document.getElementById('sender-message')?.value || '';

                    const subject = encodeURIComponent(`[GATE Civil Tracker] ${category} from ${name}`);
                    const body = encodeURIComponent(`Hi Soumyajit,\n\nName: ${name}\nTopic: ${category}\n\nMessage:\n${message}\n\n---\nSent from GATE Civil Tracker Web App`);

                    if (feedback) {
                        feedback.classList.remove('hidden');
                        feedback.classList.add('flex');
                    }

                    setTimeout(() => {
                        window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${body}`;
                    }, 300);
                };
            }
        }

        initContactPage();
        document.addEventListener('astro:page-load', initContactPage);
    </script>
</Layout>
