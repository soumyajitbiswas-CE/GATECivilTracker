                    </div>
                </div>

                <div class="flex flex-col gap-2 shrink-0 min-w-0">
                    <div class="flex justify-between items-center gap-2">
                        <label class="text-xs sm:text-sm font-semibold text-text-muted truncate">Select Subject for Sub-Topics</label>
                        <span class="text-xs text-primary-accent font-medium shrink-0" id="selected-subject-weight-display">Weight: 15%</span>
                    </div>
                    <select id="syllabus-subject-select" class="bg-white/5 border border-panel-border text-text-main p-2.5 sm:p-3 rounded-lg focus:outline-none focus:border-primary-accent cursor-pointer text-sm w-full">
                        {subjects.map(sub => (
                            <option value={sub.id} class="bg-bg-dark">{sub.name}</option>
                        ))}
                    </select>
                </div>
                
                <div class="bg-black/20 p-3.5 sm:p-4 rounded-xl border border-panel-border flex flex-col gap-3 min-h-[220px] sm:min-h-[280px] flex-grow overflow-hidden min-w-0">
                    <div class="flex justify-between items-center mb-1 shrink-0 gap-2">
                        <h4 class="text-xs sm:text-sm font-semibold text-primary-accent uppercase tracking-wider">Sub-Topics</h4>
                        <button class="btn btn-primary btn-sm flex items-center gap-1 shrink-0" id="btn-add-topic" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            Add Topic (<span id="dashboard-topic-count">0</span>/40)
                        </button>
                    </div>
                    
                    <div class="flex justify-between items-center px-1 text-xs text-text-muted font-medium mb-1">
                        <span class="flex-grow">Topic Name</span>
                        <span class="w-16 sm:w-20 text-center">Weight</span>
                        <span class="w-12 sm:w-16 text-center" title="Normalized percentage within this subject">True %</span>
                        <span class="w-8 sm:w-9"></span>
                    </div>

                    <div id="topics-edit-list" class="flex flex-col gap-2.5 overflow-y-auto pr-1 custom-scrollbar flex-grow min-w-0">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 sm:gap-3 mt-4 sm:mt-6 shrink-0 pt-3 border-t border-panel-border">
                <button class="btn justify-center text-xs sm:text-sm py-2" id="btn-syllabus-cancel">Cancel</button>
                <button class="btn btn-primary justify-center text-xs sm:text-sm py-2" id="btn-syllabus-save">Save & Apply</button>
            </div>
        </div>
        </div>
    </div>
    <script>
        // @ts-nocheck
        let workingSubjects = [];

        // Hydration logic
        function hydrateDashboard() {
            const state = window.getState();
            window.calculateAllMetrics(state);

            // Update Hero
            const heroText = document.getElementById('hero-progress-text');
            const heroCircle = document.getElementById('hero-progress-circle');
            if (heroText) heroText.textContent = window.formatPercent(state.gateReadiness || 0);
            if (heroCircle) heroCircle.style.setProperty('--progress', `${state.gateReadiness || 0}%`);
            
            const metSyllabus = document.getElementById('metric-syllabus');
            const metPyqs = document.getElementById('metric-pyqs');
            const metTests = document.getElementById('metric-tests');
            const metMocks = document.getElementById('metric-mocks');
            const metRevision = document.getElementById('metric-revision');
            const metHours = document.getElementById('metric-hours');

            if (metSyllabus) metSyllabus.textContent = window.formatPercent(state.overallSyllabusProgress || 0);
            if (metPyqs) metPyqs.textContent = window.formatPercent(state.pyqProgress || 0);
            if (metTests) metTests.textContent = window.formatPercent(state.testProgress || 0);
            if (metMocks) metMocks.textContent = window.formatPercent(state.mockProgress || 0);
            if (metRevision) metRevision.textContent = window.formatPercent(state.revisionProgress || 0);
            if (metHours) metHours.textContent = window.formatHours(state.totalHours || 0);

            // Render Subjects Progress
            if (state.subjects) {
                state.subjects.forEach(sub => {
                    const bar = document.querySelector(`.subject-progress-bar[data-id="${sub.id}"]`);
                    const text = document.querySelector(`.subject-progress-text[data-id="${sub.id}"]`);
                    const hours = document.querySelector(`.subject-hours-text[data-id="${sub.id}"]`);
                    const weightText = document.querySelector(`.subject-weight-text[data-id="${sub.id}"]`);
                    
                    if(bar) bar.style.width = `${sub.progress}%`;
                    if(text) text.innerHTML = `${window.formatPercent(sub.progress)} <span class="text-xs font-medium text-text-muted ml-1">Complete</span>`;
                    if(hours) hours.textContent = `${window.formatHours(sub.hours)} studied`;
                    if(weightText) weightText.textContent = `${sub.trackerWeight}%`;
                });
            }

            // Hydrate Achievement Badge
            const badge = document.getElementById('ach-badge');
            if (badge && state.achievements && state.achievements.unlocked) {
                const unviewedCount = Object.values(state.achievements.unlocked).filter(a => a.viewed === false).length;
                if (unviewedCount > 0) {
                    badge.textContent = unviewedCount;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            // Hydrate Practice & Revision inputs
            const derivedVals = [
                { id: 'val-tests-topic', value: state.tests?.topic?.completed ?? 0, total: state.tests?.topic?.total ?? 40 },
                { id: 'val-tests-subject', value: state.tests?.subject?.completed ?? 0, total: state.tests?.subject?.total ?? 10 },
                { id: 'val-mocks', value: state.mocks?.completed ?? 0, total: state.mocks?.total ?? 20 },
                { id: 'val-rev-1', value: state.revision?.['1st'] ?? 0, total: state.revision?.total ?? 9 },
                { id: 'val-rev-2', value: state.revision?.['2nd'] ?? 0, total: state.revision?.total ?? 9 },
                { id: 'val-rev-f', value: state.revision?.final ?? 0, total: state.revision?.total ?? 9 }
            ];
            
            derivedVals.forEach(item => {
                const el = document.getElementById(item.id);
                if (el) {
                    el.textContent = item.value;
                    const totalSpan = document.getElementById(item.id.replace('val-', 'total-'));
                    if (totalSpan) totalSpan.textContent = `/ ${item.total}`;
                }
            });

            // Hydrate PYQs
            if (state.subjects && state.pyqs) {
                state.subjects.forEach(sub => {
                    const pyqVal = document.getElementById(`val-pyq-${sub.id}`);
                    const pyqTotal = document.querySelector(`.pyq-total-dash[data-subject="${sub.id}"]`);
                    if (state.pyqs[sub.id]) {
                        if (pyqVal) {
                            pyqVal.textContent = state.pyqs[sub.id].solved;
                        }
                        if (pyqTotal) {
                            pyqTotal.textContent = `/ ${state.pyqs[sub.id].total}`;
                        }
                    }
                });
            }

            // Hydrate Settings Modal
            const w = state.settings?.weights || { syllabus: 0.60, pyqs: 0.15, tests: 0.10, mocks: 0.10, revision: 0.05 };
            const elWeightSyl = document.getElementById('set-weight-syllabus');
            const elWeightPyq = document.getElementById('set-weight-pyqs');
            const elWeightTest = document.getElementById('set-weight-tests');
            const elWeightMock = document.getElementById('set-weight-mocks');
            const elWeightRev = document.getElementById('set-weight-revision');

            if (elWeightSyl) elWeightSyl.value = Math.round(w.syllabus * 100);
            if (elWeightPyq) elWeightPyq.value = Math.round(w.pyqs * 100);
            if (elWeightTest) elWeightTest.value = Math.round(w.tests * 100);
            if (elWeightMock) elWeightMock.value = Math.round(w.mocks * 100);
            if (elWeightRev) elWeightRev.value = Math.round(w.revision * 100);

            const setTopTest = document.getElementById('set-target-topic-tests');
            const setSubTest = document.getElementById('set-target-subject-tests');
            const setMock = document.getElementById('set-target-mocks');
            const setRev = document.getElementById('set-target-revision');

            if (setTopTest) setTopTest.value = state.tests?.topic?.total ?? 40;
            if (setSubTest) setSubTest.value = state.tests?.subject?.total ?? 10;
            if (setMock) setMock.value = state.mocks?.total ?? 20;
            if (setRev) setRev.value = state.revision?.total ?? 9;

            if (state.subjects && state.pyqs) {
                state.subjects.forEach(sub => {
                    const pyqSetInput = document.getElementById(`set-target-pyq-${sub.id}`);
                    if (state.pyqs[sub.id] && pyqSetInput) {
                        pyqSetInput.value = state.pyqs[sub.id].total;
                    }
                });
            }
        }

        // Input Listeners & Dashboard Setup
        function setupDashboardListeners() {
            const setupInput = (id, callback) => {
                const el = document.getElementById(id);
                if(el) {
                    const debouncedSave = window.debounce((val) => {
                        const state = window.getState();
                        const clamped = callback(state, val);
                        if (clamped !== undefined && document.activeElement !== el) {
                            el.value = clamped;
                        }
                        window.saveState(state);
                    }, 300);

                    const handler = (e) => {
                        const val = parseInt(e.target.value);
                        if (isNaN(val) || val < 0) return;
                        debouncedSave(val);
                    };
                    el.oninput = handler;
                    el.onchange = handler;
                }
            };

            // (Legacy input listeners for Practice & Revision removed as they are now read-only derived values)

            // Settings Modal Logic
            const settingsModal = document.getElementById('settings-modal');
            document.querySelectorAll('.open-settings-btn').forEach(btn => {
                btn.onclick = () => {
                    hydrateDashboard(); // ensure it has the latest before showing
                    if (settingsModal) settingsModal.classList.remove('hidden');
                };
            });

            const btnSettingsCancel = document.getElementById('btn-settings-cancel');
            if (btnSettingsCancel) {
                btnSettingsCancel.onclick = () => {
                    if (settingsModal) settingsModal.classList.add('hidden');
                };
            }

            const btnSettingsSave = document.getElementById('btn-settings-save');
            if (btnSettingsSave) {
                btnSettingsSave.onclick = () => {
                    const state = window.getState();

                    // Targets
                    state.tests.topic.total = Math.max(1, parseInt(document.getElementById('set-target-topic-tests').value) || 40);
                    state.tests.subject.total = Math.max(1, parseInt(document.getElementById('set-target-subject-tests').value) || 10);
                    state.mocks.total = Math.max(1, parseInt(document.getElementById('set-target-mocks').value) || 20);
                    state.revision.total = Math.max(1, parseInt(document.getElementById('set-target-revision').value) || 9);

                    document.querySelectorAll('.set-pyq-input').forEach(input => {
                        const subId = input.dataset.pyqSubject;
                        const val = Math.max(1, parseInt(input.value) || 100);
                        if(state.pyqs && state.pyqs[subId]) {
                            state.pyqs[subId].total = val;
                            // Cap solved at the new max
                            state.pyqs[subId].solved = Math.min(state.pyqs[subId].solved, val);
                        }
                    });
                    
                    // Cap existing values at new maxes
                    state.tests.topic.completed = Math.min(state.tests.topic.completed, state.tests.topic.total);
                    state.tests.subject.completed = Math.min(state.tests.subject.completed, state.tests.subject.total);
                    state.mocks.completed = Math.min(state.mocks.completed, state.mocks.total);
                    ['1st', '2nd', 'final'].forEach(k => {
                        state.revision[k] = Math.min(state.revision[k], state.revision.total);
                    });

                    window.saveState(state);
                    if (settingsModal) settingsModal.classList.add('hidden');
                };
            }

            // Syllabus Modal Logic
            const syllabusModal = document.getElementById('syllabus-settings-modal');
            const syllabusSelect = document.getElementById('syllabus-subject-select');
            const topicsList = document.getElementById('topics-edit-list');
            const btnAddTopic = document.getElementById('btn-add-topic');

            function syncCurrentVisibleTopics() {
                if (!syllabusSelect || !workingSubjects.length) return;
                const currentSubjectId = syllabusSelect.value;
                const currentSubject = workingSubjects.find(s => s.id === currentSubjectId);
                if (!currentSubject) return;

                if (topicsList) {
                    topicsList.querySelectorAll('.topic-name-input').forEach(inp => {
                        const idx = parseInt(inp.dataset.idx);
                        if (currentSubject.topics[idx]) currentSubject.topics[idx].name = inp.value;
                    });
                    topicsList.querySelectorAll('.topic-weight-input').forEach(inp => {
                        const idx = parseInt(inp.dataset.idx);
                        if (currentSubject.topics[idx]) {
                            const val = parseFloat(inp.value);
                            currentSubject.topics[idx].trackerWeight = isNaN(val) ? 0 : val;
                        }
                    });
                }

                document.querySelectorAll('.set-subject-weight-input').forEach(inp => {
                    const subId = inp.dataset.subjectId;
                    const sub = workingSubjects.find(s => s.id === subId);
                    if (sub) {
                        const val = parseFloat(inp.value);
                        sub.trackerWeight = isNaN(val) ? 0 : val;
                    }
                });
            }

            function renderWorkingTopics(subjectId) {
                if (!topicsList) return;
                topicsList.innerHTML = '';
                const subject = workingSubjects.find(s => s.id === subjectId);
                if (!subject) return;

                const disp = document.getElementById('selected-subject-weight-display');
                if (disp) disp.textContent = `Weight: ${subject.trackerWeight}%`;

                const totalTopicWeight = subject.topics.reduce((sum, t) => sum + (parseFloat(t.trackerWeight) || 0), 0);

                subject.topics.forEach((topic, idx) => {
                    const truePct = totalTopicWeight === 0 ? 0 : ((parseFloat(topic.trackerWeight) || 0) / totalTopicWeight) * 100;
                    const row = document.createElement('div');
                    row.className = "flex items-center gap-1.5 sm:gap-2 bg-black/30 p-2 rounded-lg border border-panel-border shrink-0 min-w-0";
                    row.innerHTML = `
                        <input type="text" class="topic-name-input flex-grow min-w-0 bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-xs sm:text-sm" value="${topic.name}" data-idx="${idx}">
                        <input type="number" step="0.1" class="topic-weight-input w-16 sm:w-20 shrink-0 bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-xs sm:text-sm text-center font-semibold" value="${topic.trackerWeight}" data-idx="${idx}" title="Relative Weight">
                        <span class="topic-true-percent w-12 sm:w-16 text-center text-xs text-primary-accent font-semibold shrink-0" data-idx="${idx}">${truePct.toFixed(1)}%</span>
                        <button class="btn btn-sm text-red-400 hover:text-red-300 hover:bg-red-400/10 btn-delete-topic shrink-0 p-1.5 sm:p-2" data-idx="${idx}" title="Remove Topic">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        </button>
                    `;
                    topicsList.appendChild(row);
                });
                
                const countSpan = document.getElementById('dashboard-topic-count');
                if (countSpan) countSpan.textContent = subject.topics.length;
                if (btnAddTopic) {
                    btnAddTopic.disabled = subject.topics.length >= 40;
                    btnAddTopic.style.opacity = subject.topics.length >= 40 ? '0.5' : '1';
                    btnAddTopic.style.cursor = subject.topics.length >= 40 ? 'not-allowed' : 'pointer';
                }

                topicsList.querySelectorAll('.topic-name-input').forEach(inp => {
                    const update = (e) => {
                        const idx = parseInt(e.target.dataset.idx);
                        if (subject.topics[idx]) subject.topics[idx].name = e.target.value;
                    };
                    inp.addEventListener('input', update);
                    inp.addEventListener('change', update);
                });
                topicsList.querySelectorAll('.topic-weight-input').forEach(inp => {
                    const update = (e) => {
                        const idx = parseInt(e.target.dataset.idx);
                        if (subject.topics[idx]) {
                            let val = parseFloat(e.target.value);
                            subject.topics[idx].trackerWeight = isNaN(val) ? 0 : val;
                            
                            // Dynamically update true percentages without re-rendering everything
                            const totalTopicWeight = subject.topics.reduce((sum, t) => sum + (parseFloat(t.trackerWeight) || 0), 0);
                            topicsList.querySelectorAll('.topic-true-percent').forEach(span => {
                                const i = parseInt(span.dataset.idx);
                                if (subject.topics[i]) {
                                    const w = parseFloat(subject.topics[i].trackerWeight) || 0;
                                    const truePct = totalTopicWeight === 0 ? 0 : (w / totalTopicWeight) * 100;
                                    span.textContent = `${truePct.toFixed(1)}%`;
                                }
                            });
                        }
                    };
                    inp.addEventListener('input', update);
                    inp.addEventListener('change', update);
                });
                topicsList.querySelectorAll('.btn-delete-topic').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        syncCurrentVisibleTopics();
                        const idx = parseInt(e.currentTarget.dataset.idx);
                        subject.topics.splice(idx, 1);
                        renderWorkingTopics(subjectId);
                    });
                });
            }

            document.querySelectorAll('.set-subject-weight-input').forEach(inp => {
                const updateSubjectWeight = (e) => {
                    const subId = e.target.dataset.subjectId;
                    const sub = workingSubjects.find(s => s.id === subId);
                    if (sub) {
                        const val = parseFloat(e.target.value);
                        sub.trackerWeight = isNaN(val) ? 0 : val;
                        if (syllabusSelect && syllabusSelect.value === subId) {
                            const disp = document.getElementById('selected-subject-weight-display');
                            if (disp) disp.textContent = `Weight: ${sub.trackerWeight}%`;
                        }
                    }
                };
                inp.addEventListener('input', updateSubjectWeight);
                inp.addEventListener('change', updateSubjectWeight);
            });

            document.querySelectorAll('.open-syllabus-settings-btn').forEach(btn => {
                btn.onclick = () => {
                    workingSubjects = JSON.parse(JSON.stringify(window.getState().subjects));
                    workingSubjects.forEach(s => {
                        const inp = document.getElementById(`set-subject-weight-${s.id}`);
                        if (inp) inp.value = s.trackerWeight;
                    });
                    if (syllabusSelect && workingSubjects.length > 0) {
                        syllabusSelect.value = workingSubjects[0].id;
                        renderWorkingTopics(syllabusSelect.value);
                    }
                    if (syllabusModal) syllabusModal.classList.remove('hidden');
                };
            });

            if (syllabusSelect) {
                syllabusSelect.onchange = (e) => {
                    syncCurrentVisibleTopics();
                    renderWorkingTopics(e.target.value);
                };
            }

            if (btnAddTopic) {
                btnAddTopic.onclick = () => {
                    syncCurrentVisibleTopics();
                    const subjectId = syllabusSelect ? syllabusSelect.value : null;
                    const subject = workingSubjects.find(s => s.id === subjectId);
                    if (!subject) return;
                    
                    if (subject.topics.length >= 40) {
                        alert('Maximum of 40 topics allowed per subject.');
                        return;
                    }
                    
                    subject.topics.push({
                        id: `custom_${Date.now()}`,
                        name: "New Topic",
                        trackerWeight: 1.0,
                        completed: false
                    });
                    renderWorkingTopics(subjectId);
                    if (topicsList) {
                        setTimeout(() => { topicsList.scrollTop = topicsList.scrollHeight; }, 10);
                    }
                };
            }

            const btnSyllabusCancel = document.getElementById('btn-syllabus-cancel');
            if (btnSyllabusCancel) {
                btnSyllabusCancel.onclick = () => {
                    if (syllabusModal) syllabusModal.classList.add('hidden');
                };
            }

            const btnSyllabusSave = document.getElementById('btn-syllabus-save');
            if (btnSyllabusSave) {
                btnSyllabusSave.onclick = () => {
                    syncCurrentVisibleTopics();
                    const state = window.getState();
                    
                    // 1. GATE Readiness Weights save logic
                    const oldW = state.settings?.weights || { syllabus: 0.60, pyqs: 0.15, tests: 0.10, mocks: 0.10, revision: 0.05 };
                    const inputs = {
                        syllabus: parseFloat(document.getElementById('set-weight-syllabus').value) || 0,
                        pyqs: parseFloat(document.getElementById('set-weight-pyqs').value) || 0,
                        tests: parseFloat(document.getElementById('set-weight-tests').value) || 0,
                        mocks: parseFloat(document.getElementById('set-weight-mocks').value) || 0,
                        revision: parseFloat(document.getElementById('set-weight-revision').value) || 0
                    };

                    let changedKeys = [];
                    let unchangedKeys = [];
                    let changedSum = 0;

                    Object.keys(inputs).forEach(k => {
                        if (Math.round(inputs[k]) !== Math.round(oldW[k] * 100)) {
                            changedKeys.push(k);
                            changedSum += inputs[k];
                        } else {
                            unchangedKeys.push(k);
                        }
                    });

                    if (changedKeys.length > 0) {
                        let remaining = 100 - changedSum;
                        if (remaining < 0) {
                            let total = Object.values(inputs).reduce((a,b)=>a+b, 0);
                            let currentSum = 0;
                            let values = Object.keys(inputs).map(k => {
                                let prop = Math.round((inputs[k] / total) * 100);
                                currentSum += prop;
                                return { k, val: prop };
                            });
                            let diff = 100 - currentSum;
                            if(diff !== 0) {
                                values.sort((a,b) => b.val - a.val);
                                values[0].val += diff;
                            }
                            values.forEach(v => inputs[v.k] = v.val);
                        } else if (unchangedKeys.length > 0) {
                            let unchangedOriginalSum = unchangedKeys.reduce((sum, k) => sum + Math.round(oldW[k] * 100), 0);
                            let currentNewSum = 0;
                            let values = unchangedKeys.map(k => {
                                const oldVal = Math.round(oldW[k] * 100);
                                const propVal = unchangedOriginalSum === 0 
                                    ? Math.floor(remaining / unchangedKeys.length) 
                                    : Math.round((oldVal / unchangedOriginalSum) * remaining);
                                currentNewSum += propVal;
                                return { k, val: propVal };
                            });
                            
                            let diff = remaining - currentNewSum;
                            if (diff !== 0 && values.length > 0) {
                                values.sort((a,b) => b.val - a.val);
                                values[0].val += diff;
                            }
                            
                            values.forEach(v => {
                                inputs[v.k] = Math.max(0, v.val);
                            });
                        } else if (changedSum !== 100) {
                            let currentSum = 0;
                            let values = Object.keys(inputs).map(k => {
                                let prop = Math.round((inputs[k] / changedSum) * 100);
                                currentSum += prop;
                                return { k, val: prop };
                            });
                            let diff = 100 - currentSum;
                            if(diff !== 0) {
                                values.sort((a,b) => b.val - a.val);
                                values[0].val += diff;
                            }
                            values.forEach(v => inputs[v.k] = v.val);
                        }
                    }

                    const finalSum = Object.values(inputs).reduce((a,b)=>a+b, 0);
                    if (Math.round(finalSum) !== 100) {
                        alert('GATE Readiness Weights must sum up exactly to 100%!');
                        return;
                    }
                    
                    if(!state.settings) state.settings = {};
                    state.settings.weights = {
                        syllabus: inputs.syllabus / 100,
                        pyqs: inputs.pyqs / 100,
                        tests: inputs.tests / 100,
                        mocks: inputs.mocks / 100,
                        revision: inputs.revision / 100
                    };
                    
                    // 2. Smart Auto-Balance for Subject Tracker Weights (Must total 100%)
                    let changedSubIndices = [];
                    let unchangedSubIndices = [];
                    let changedSubSum = 0;

                    workingSubjects.forEach((s, i) => {
                        const origS = state.subjects.find(os => os.id === s.id);
                        if (!origS || Math.abs(origS.trackerWeight - s.trackerWeight) > 0.01) {
                            changedSubIndices.push(i);
                            changedSubSum += s.trackerWeight;
                        } else {
                            unchangedSubIndices.push(i);
                        }
                    });

                    let currentTotalSub = workingSubjects.reduce((a, b) => a + b.trackerWeight, 0);

                    if (changedSubIndices.length > 0 && unchangedSubIndices.length > 0) {
                        let remainingSub = 100 - changedSubSum;
                        if (remainingSub <= 0) {
                            if (currentTotalSub > 0) {
                                workingSubjects.forEach(s => s.trackerWeight = (s.trackerWeight / currentTotalSub) * 100);
                            } else {
                                workingSubjects.forEach(s => s.trackerWeight = 100 / workingSubjects.length);
                            }
                        } else {
                            let unchangedSubSum = unchangedSubIndices.reduce((sum, i) => sum + workingSubjects[i].trackerWeight, 0);
                            unchangedSubIndices.forEach(i => {
                                const oldVal = workingSubjects[i].trackerWeight;
                                const propVal = unchangedSubSum === 0 ? (remainingSub / unchangedSubIndices.length) : (oldVal / unchangedSubSum) * remainingSub;
                                workingSubjects[i].trackerWeight = propVal;
                            });
                        }
                    } else if (changedSubIndices.length > 0 && unchangedSubIndices.length === 0) {
                        if (changedSubSum > 0 && Math.abs(changedSubSum - 100) > 0.01) {
                            workingSubjects.forEach(s => s.trackerWeight = (s.trackerWeight / changedSubSum) * 100);
                        }
                    } else if (Math.abs(currentTotalSub - 100) > 0.01) {
                        if (currentTotalSub > 0) {
                            workingSubjects.forEach(s => s.trackerWeight = (s.trackerWeight / currentTotalSub) * 100);
                        }
                    }

                    let newSubSum = 0;
                    workingSubjects.forEach(s => {
                        s.trackerWeight = Math.round(s.trackerWeight * 10) / 10;
                        newSubSum += s.trackerWeight;
                    });

                    let subDiff = Math.round((100 - newSubSum) * 10) / 10;
                    if (subDiff !== 0 && workingSubjects.length > 0) {
                        let targetIdx = unchangedSubIndices.length > 0 ? unchangedSubIndices[0] : 0;
                        workingSubjects[targetIdx].trackerWeight = Math.max(0, Math.round((workingSubjects[targetIdx].trackerWeight + subDiff) * 10) / 10);
                    }

                    // 3. Smart Auto-Balance for Subtopics on Save (Must total each subject's trackerWeight)
                    workingSubjects.forEach(workingSub => {
                        const origSub = state.subjects.find(s => s.id === workingSub.id);
                        if (!origSub || !workingSub.topics || workingSub.topics.length === 0) return;
                        
                        const totalTarget = workingSub.trackerWeight;
                        if (workingSub.topics.length === 1) {
                            workingSub.topics[0].trackerWeight = totalTarget;
                            return;
                        }

                        let changedIndices = [];
                        let unchangedIndices = [];
                        let changedSum = 0;

                        workingSub.topics.forEach((t, i) => {
                            const origT = origSub?.topics?.find(ot => ot.id === t.id);
                            if (!origT || Math.abs(origT.trackerWeight - t.trackerWeight) > 0.01) {
                                changedIndices.push(i);
                                changedSum += t.trackerWeight;
                            } else {
                                unchangedIndices.push(i);
                            }
                        });

                        let currentTotalSum = workingSub.topics.reduce((a, b) => a + b.trackerWeight, 0);

                        if (changedIndices.length > 0 && unchangedIndices.length > 0) {
                            let remaining = totalTarget - changedSum;
                            if (remaining <= 0) {
                                if (currentTotalSum > 0) {
                                    workingSub.topics.forEach(t => {
                                        t.trackerWeight = (t.trackerWeight / currentTotalSum) * totalTarget;
                                    });
                                } else {
                                    const eq = totalTarget / workingSub.topics.length;
                                    workingSub.topics.forEach(t => t.trackerWeight = eq);
                                }
                            } else {
                                let unchangedSum = unchangedIndices.reduce((sum, i) => sum + workingSub.topics[i].trackerWeight, 0);
                                unchangedIndices.forEach(i => {
                                    const oldVal = workingSub.topics[i].trackerWeight;
                                    const propVal = unchangedSum === 0 
                                        ? remaining / unchangedIndices.length 
                                        : (oldVal / unchangedSum) * remaining;
                                    workingSub.topics[i].trackerWeight = propVal;
                                });
                            }
                        } else if (changedIndices.length > 0 && unchangedIndices.length === 0) {
                            if (changedSum > 0 && Math.abs(changedSum - totalTarget) > 0.01) {
                                workingSub.topics.forEach(t => {
                                    t.trackerWeight = (t.trackerWeight / changedSum) * totalTarget;
                                });
                            } else if (changedSum === 0) {
                                const eq = totalTarget / workingSub.topics.length;
                                workingSub.topics.forEach(t => t.trackerWeight = eq);
                            }
                        } else if (Math.abs(currentTotalSum - totalTarget) > 0.01) {
                            // Triggers if topics were deleted or subject's trackerWeight changed
                            if (currentTotalSum > 0) {
                                workingSub.topics.forEach(t => {
                                    t.trackerWeight = (t.trackerWeight / currentTotalSum) * totalTarget;
                                });
                            } else {
                                const eq = totalTarget / workingSub.topics.length;
                                workingSub.topics.forEach(t => t.trackerWeight = eq);
                            }
                        }

                        // Rounding and diff adjustment to hit exact totalTarget
                        let newSum = 0;
                        workingSub.topics.forEach(t => {
                            t.trackerWeight = Math.round(t.trackerWeight * 10) / 10;
                            newSum += t.trackerWeight;
                        });

                        let diff = Math.round((totalTarget - newSum) * 10) / 10;
                        if (diff !== 0 && workingSub.topics.length > 0) {
                            let targetIdx = unchangedIndices.length > 0 ? unchangedIndices[0] : 0;
                            workingSub.topics[targetIdx].trackerWeight = Math.max(0, Math.round((workingSub.topics[targetIdx].trackerWeight + diff) * 10) / 10);
                        }
                    });

                    state.subjects = workingSubjects;
                    window.saveState(state);
                    if (syllabusModal) syllabusModal.classList.add('hidden');
                };
            }
        }

        function setupSeoToggle() {
            const btn = document.getElementById('btn-read-more');
            const container = document.getElementById('seo-content-container');
            const gradient = document.getElementById('seo-gradient');
            const chevron = document.getElementById('seo-chevron');
            const btnText = document.getElementById('seo-btn-text');
            
            if (btn && container && gradient && chevron && btnText) {
                let isExpanded = false;
                btn.onclick = () => {
                    isExpanded = !isExpanded;
                    btn.setAttribute('aria-expanded', isExpanded.toString());
                    if (isExpanded) {
                        container.style.maxHeight = container.scrollHeight + 'px';
                        gradient.style.opacity = '0';
                        btnText.textContent = 'Show Less';
                        chevron.style.transform = 'rotate(180deg)';
                    } else {
                        container.style.maxHeight = '180px';
                        gradient.style.opacity = '1';
                        btnText.textContent = 'Read More';
                        chevron.style.transform = 'rotate(0deg)';
                        setTimeout(() => {
                            container.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }, 300);
                    }
                };
            }
        }

        // Run on load and on state change
        function initPage() {
            hydrateDashboard();
            setupDashboardListeners();
            setupSeoToggle();
            setupFaqAccordion();
        }

        function setupFaqAccordion() {
            const btns = document.querySelectorAll('.faq-btn');
            btns.forEach(btn => {
                btn.onclick = () => {
                    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
                    
                    // Close all
                    btns.forEach(b => {
                        b.setAttribute('aria-expanded', 'false');
                        b.nextElementSibling.style.gridTemplateRows = '0fr';
                        b.querySelector('.faq-icon').style.transform = 'rotate(0deg)';
                    });
                    
                    // Open clicked if it wasn't expanded
                    if (!isExpanded) {
                        btn.setAttribute('aria-expanded', 'true');
                        btn.nextElementSibling.style.gridTemplateRows = '1fr';
                        btn.querySelector('.faq-icon').style.transform = 'rotate(180deg)';
                    }
                };
            });
        }

        document.addEventListener('astro:page-load', initPage);
        window.addEventListener('stateChanged', hydrateDashboard);
    </script>

