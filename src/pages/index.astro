---
import Layout from '../layouts/Layout.astro';
import { defaultState } from '../data.js';
import HeroSpline from '../components/HeroSpline.astro';
import Footer from '../components/Footer.astro';

const subjects = defaultState.subjects;
const subjectBgClass = {
    general_aptitude: 'surface-ga',
    engineering_mathematics: 'surface-em',
    structural_engineering: 'surface-se',
    geotechnical_engineering: 'surface-ge',
    water_resources_engineering: 'surface-wre',
    environmental_engineering: 'surface-ee',
    transportation_engineering: 'surface-te',
    geomatics_engineering: 'surface-gm',
    construction_materials: 'surface-cm',
};
---

<Layout 
    title="GATE Civil Tracker | Gamified GATE CE Preparation & Syllabus Planner" 
    description="The ultimate GATE Civil Tracker to monitor your GATE CE preparation. Features a GATE CE syllabus checklist, PYQ tracker, mock test analyzer, and gamified revision planner."
>
    <!-- Main Dashboard View -->
    <div id="dashboard-view" class="flex flex-col gap-5 sm:gap-6 min-w-0">
        
        <!-- Hero Progress Area -->
        <div class="glass-panel surface-hero p-3.5 sm:p-6 grid grid-cols-1 md:grid-cols-[auto_1fr] lg:grid-cols-[220px_1fr] gap-4 sm:gap-6 items-center relative overflow-hidden">
            <HeroSpline />
            
            <div class="flex flex-col items-center justify-center text-center relative z-10 pointer-events-none py-2 sm:py-0">
                <div class="circular-progress animate-pulse-glow pointer-events-auto" id="hero-progress-circle" style="--progress: 0%;">
                    <span class="relative z-10 text-2xl sm:text-3xl font-bold" id="hero-progress-text">0%</span>
                </div>
                <p class="text-text-muted text-[11px] sm:text-sm font-semibold tracking-wide mt-1.5 sm:mt-2 shadow-text">Overall Readiness</p>
            </div>
            
            <div class="grid grid-cols-3 gap-2 sm:gap-3.5 md:gap-4 relative z-10 pointer-events-none">
                <div class="bg-black/20 border border-panel-border rounded-xl p-2 sm:p-4 flex flex-col items-center sm:items-start gap-0.5 sm:gap-1 min-w-0 pointer-events-auto">
                    <span class="text-text-muted text-[9px] sm:text-xs uppercase tracking-wide truncate max-w-full">Syllabus</span>
                    <span class="text-base sm:text-xl font-semibold text-white" id="metric-syllabus">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-2 sm:p-4 flex flex-col items-center sm:items-start gap-0.5 sm:gap-1 min-w-0 pointer-events-auto">
                    <span class="text-text-muted text-[9px] sm:text-xs uppercase tracking-wide truncate max-w-full">PYQs</span>
                    <span class="text-base sm:text-xl font-semibold text-white" id="metric-pyqs">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-2 sm:p-4 flex flex-col items-center sm:items-start gap-0.5 sm:gap-1 min-w-0 pointer-events-auto">
                    <span class="text-text-muted text-[9px] sm:text-xs uppercase tracking-wide truncate max-w-full">Tests</span>
                    <span class="text-base sm:text-xl font-semibold text-white" id="metric-tests">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-2 sm:p-4 flex flex-col items-center sm:items-start gap-0.5 sm:gap-1 min-w-0 pointer-events-auto">
                    <span class="text-text-muted text-[9px] sm:text-xs uppercase tracking-wide truncate max-w-full">Mocks</span>
                    <span class="text-base sm:text-xl font-semibold text-white" id="metric-mocks">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-2 sm:p-4 flex flex-col items-center sm:items-start gap-0.5 sm:gap-1 min-w-0 pointer-events-auto">
                    <span class="text-text-muted text-[9px] sm:text-xs uppercase tracking-wide truncate max-w-full">Revision</span>
                    <span class="text-base sm:text-xl font-semibold text-white" id="metric-revision">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-2 sm:p-4 flex flex-col items-center sm:items-start gap-0.5 sm:gap-1 min-w-0 pointer-events-auto">
                    <span class="text-text-muted text-[9px] sm:text-xs uppercase tracking-wide truncate max-w-full">Hours</span>
                    <span class="text-base sm:text-xl font-semibold text-primary-accent" id="metric-hours">0h</span>
                </div>
            </div>
        </div>

        <!-- Subject Grid -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2.5 sm:gap-4 mt-2">
            <h2 class="text-lg sm:text-xl font-semibold tracking-tight">1. SYLLABUS COMPLETION</h2>
            <button class="btn btn-primary text-xs sm:text-sm px-3 sm:px-4 py-1.5 sm:py-2 flex items-center gap-1.5 open-syllabus-settings-btn shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit Syllabus
            </button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {subjects.map((sub, index) => (
                <div class={`${subjectBgClass[sub.id] || 'surface-syllabus'} backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col justify-between subject-card min-w-0 glow-card group relative overflow-hidden`} data-id={sub.id}>
                    <!-- Top section: Title and Weight -->
                    <div class="flex flex-col gap-1 min-w-0">
                        <div class="flex items-start gap-3 min-w-0">
                            <div class="bg-white/5 p-2 rounded-lg flex items-center justify-center text-primary-accent shrink-0" set:html={sub.icon} />
                            <div class="flex flex-col min-w-0 flex-1">
                                <h3 class="text-[1.05rem] sm:text-[1.1rem] font-semibold leading-snug mb-0.5 break-words hyphens-auto">{sub.name}</h3>
                                <div class="text-[11px] text-text-muted font-medium">Tracker Weight: <span class="subject-weight-text" data-id={sub.id}>{sub.trackerWeight}%</span></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Middle section: Progress -->
                    <div class="flex flex-col gap-2 mt-4 mb-3">
                        <div>
                            <span class="subject-progress-text text-xl sm:text-2xl font-bold text-white tracking-tight" data-id={sub.id}>0% <span class="text-xs font-medium text-text-muted ml-1">Complete</span></span>
                        </div>
                        <div class="w-full h-2 bg-panel-border rounded-full overflow-hidden">
                            <div class="h-full bg-primary-accent rounded-full subject-progress-bar" style="width: 0%" data-id={sub.id}></div>
                        </div>
                    </div>
                    
                    <!-- Bottom section: Hours and Action -->
                    <div class="flex justify-between items-center gap-2 mt-auto pt-3 border-t border-panel-border">
                        <div class="text-[12px] sm:text-[13px] flex items-center gap-1.5 text-text-muted font-medium pb-0.5 truncate">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="subject-hours-text truncate" data-id={sub.id}>0h studied</span>
                        </div>
                        <a href={`/subject/${sub.id}`} class="btn text-[11px] sm:text-[12px] px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0">OPEN →</a>
                    </div>
                </div>
            ))}
        </div>

        <!-- Practice and Revision -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2.5 sm:gap-4 mt-6 mb-3 sm:mb-4">
            <h2 class="text-lg sm:text-xl font-semibold tracking-tight">2. PRACTICE & REVISION</h2>
            <button class="btn btn-primary text-xs sm:text-sm px-3 sm:px-4 py-1.5 sm:py-2 flex items-center gap-1.5 open-settings-btn shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit Targets
            </button>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            <!-- PYQs Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-start justify-between w-full gap-2 mb-1">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0 mt-0.5 sm:mt-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-check"><path d="M8 3H2v15h7c1.7 0 3 1.3 3 3V7c0-2.2-1.8-4-4-4Z"/><path d="m16 12 2 2 4-4"/><path d="M22 6V3h-6c-2.2 0-4 1.8-4 4v14c0-1.7 1.3-3 3-3h7v-2.3"/></svg>
                        </div>
                        <h3 class="text-base sm:text-lg font-semibold leading-tight sm:leading-normal mt-1 sm:mt-0">PYQs</h3>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 mt-1 sm:mt-0">
                        <button class="btn-activity-history p-1 text-primary-accent/60 hover:text-primary-accent hover:bg-primary-accent/10 rounded-md transition-colors" data-filter="pyq" title="History">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </button>
                        <button class="btn-log-activity text-[10px] sm:text-xs font-semibold px-2 py-1 rounded bg-primary-accent/10 text-primary-accent border border-primary-accent/30 hover:bg-primary-accent/20 transition-colors whitespace-nowrap" data-type="pyq">+ Log</button>
                    </div>
                </div>
                <div class="flex flex-col gap-2 overflow-y-auto max-h-[170px] pr-1 sm:pr-2 custom-scrollbar mt-1">
                    {subjects.map(sub => (
                        <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border shrink-0 min-w-0 gap-2">
                            <span class="text-xs sm:text-sm font-medium text-text-muted truncate flex-1 min-w-0" title={sub.name}>{sub.name}</span>
                            <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                                <span id={`val-pyq-${sub.id}`} class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                                <span class="text-[10px] sm:text-xs font-medium text-text-muted pyq-total-dash" data-subject={sub.id}>/ 0</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Tests Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-start justify-between w-full gap-2 mb-1">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0 mt-0.5 sm:mt-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
                        </div>
                        <h3 class="text-base sm:text-lg font-semibold leading-tight sm:leading-normal mt-1 sm:mt-0">Tests</h3>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 mt-1 sm:mt-0">
                        <button class="btn-activity-history p-1 text-primary-accent/60 hover:text-primary-accent hover:bg-primary-accent/10 rounded-md transition-colors" data-filter="test" title="History">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </button>
                        <button class="btn-log-activity text-[10px] sm:text-xs font-semibold px-2 py-1 rounded bg-primary-accent/10 text-primary-accent border border-primary-accent/30 hover:bg-primary-accent/20 transition-colors whitespace-nowrap" data-type="test">+ Log</button>
                    </div>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-2.5 sm:p-3 rounded-xl border border-panel-border gap-2 mt-1 min-w-0">
                    <span class="text-xs sm:text-sm font-medium text-text-muted truncate">Topic Tests</span>
                    <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                        <span id="val-tests-topic" class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                        <span id="total-tests-topic" class="text-[10px] sm:text-xs font-medium text-text-muted">/ 40</span>
                    </div>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-2.5 sm:p-3 rounded-xl border border-panel-border gap-2 min-w-0">
                    <span class="text-xs sm:text-sm font-medium text-text-muted truncate">Subject Tests</span>
                    <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                        <span id="val-tests-subject" class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                        <span id="total-tests-subject" class="text-[10px] sm:text-xs font-medium text-text-muted">/ 10</span>
                    </div>
                </div>
            </div>

            <!-- Mocks Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-start justify-between w-full gap-2 mb-1">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0 mt-0.5 sm:mt-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        </div>
                        <h3 class="text-base sm:text-lg font-semibold leading-tight sm:leading-normal mt-1 sm:mt-0">Full-Length Mocks</h3>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 mt-1 sm:mt-0">
                        <button class="btn-activity-history p-1 text-primary-accent/60 hover:text-primary-accent hover:bg-primary-accent/10 rounded-md transition-colors" data-filter="mock" title="History">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </button>
                        <button class="btn-log-activity text-[10px] sm:text-xs font-semibold px-2 py-1 rounded bg-primary-accent/10 text-primary-accent border border-primary-accent/30 hover:bg-primary-accent/20 transition-colors whitespace-nowrap" data-type="mock">+ Log</button>
                    </div>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-2.5 sm:p-3 rounded-xl border border-panel-border gap-2 mt-1 min-w-0">
                    <span class="text-xs sm:text-sm font-medium text-text-muted truncate uppercase tracking-wider">Completed</span>
                    <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                        <span id="val-mocks" class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                        <span id="total-mocks" class="text-[10px] sm:text-xs font-medium text-text-muted">/ 20</span>
                    </div>
                </div>
            </div>

            <!-- Revision Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-start justify-between w-full gap-2 mb-1">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0 mt-0.5 sm:mt-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                        </div>
                        <h3 class="text-base sm:text-lg font-semibold leading-tight sm:leading-normal mt-1 sm:mt-0">Revision (Subjects)</h3>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 mt-1 sm:mt-0">
                        <button class="btn-activity-history p-1 text-primary-accent/60 hover:text-primary-accent hover:bg-primary-accent/10 rounded-md transition-colors" data-filter="revision" title="History">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        </button>
                        <button class="btn-log-activity text-[10px] sm:text-xs font-semibold px-2 py-1 rounded bg-primary-accent/10 text-primary-accent border border-primary-accent/30 hover:bg-primary-accent/20 transition-colors whitespace-nowrap" data-type="revision">+ Log</button>
                    </div>
                </div>
                <div class="flex flex-col gap-2 mt-1">
                    <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border gap-2 min-w-0">
                        <span class="text-xs sm:text-sm font-medium text-text-muted truncate">1st Revision</span>
                        <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                            <span id="val-rev-1" class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                            <span id="total-rev-1" class="text-[10px] sm:text-xs font-medium text-text-muted">/ 9</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border gap-2 min-w-0">
                        <span class="text-xs sm:text-sm font-medium text-text-muted truncate">2nd Revision</span>
                            <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                                <span id="val-rev-2" class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                                <span id="total-rev-2" class="text-[10px] sm:text-xs font-medium text-text-muted">/ 9</span>
                            </div>
                    </div>
                    <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border gap-2 min-w-0">
                        <span class="text-xs sm:text-sm font-medium text-text-muted truncate">Final Revision</span>
                            <div class="flex items-center gap-1.5 bg-white/5 border border-panel-border rounded-lg px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0 transition-colors tabular-nums">
                                <span id="val-rev-f" class="text-xs sm:text-sm font-semibold text-text-main text-right min-w-[20px]">0</span>
                                <span id="total-rev-f" class="text-[10px] sm:text-xs font-medium text-text-muted">/ 9</span>
                            </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SEO Content Block -->
        <div class="mt-12 mb-10 relative flex flex-col items-center">
            <section class="seo-content-block w-full p-6 sm:p-8 bg-black/20 border border-panel-border rounded-2xl text-text-muted relative overflow-hidden transition-[max-height] duration-500 ease-in-out" id="seo-content-container" style="max-height: 180px;">
                <h1 class="text-xl sm:text-2xl font-semibold text-white/90 mb-5 tracking-tight">GATE Civil Tracker: The Ultimate Gamified GATE Preparation Tool</h1>
                
                <div class="space-y-4 text-sm sm:text-base leading-relaxed pb-8">
                    <p>Welcome to the <strong>GATE Civil Tracker</strong>, a comprehensive preparation application designed for the Graduate Aptitude Test in Engineering (GATE) in Civil Engineering (CE). If you are looking for an effective <em>GATE study planner</em>, this tool helps you organize your study plan into a structured, engaging, and gamified experience.</p>
                    
                    <h2 class="text-lg sm:text-xl font-semibold text-primary-accent mt-6 mb-3">Organize Your Civil Engineering GATE Preparation</h2>
                    <p>Preparing for GATE Civil Engineering requires managing a vast syllabus that spans structural, geotechnical, environmental, and transportation engineering. A dedicated <strong>GATE preparation tracker</strong> can help replace scattered spreadsheets and physical notebooks, offering a dynamic way to monitor your progress.</p>
                    <p>Our platform provides a detailed <strong>GATE Civil syllabus</strong> checklist. By breaking down the syllabus into manageable sub-topics and tracking them against historical topic distributions from actual GATE papers, the tracker provides an 'Overall Readiness' score to help you prioritize your focus.</p>
                    
                    <h2 class="text-lg sm:text-xl font-semibold text-primary-accent mt-6 mb-3">Core Tracking Features</h2>
                    <ul class="list-disc pl-5 space-y-2 mt-2">
                        <li><strong>Advanced Syllabus Tracking:</strong> Visualize your subject progress in real-time. The tracker weighs completed topics against their historical prominence in the exam.</li>
