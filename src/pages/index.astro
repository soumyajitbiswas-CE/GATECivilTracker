---
import Layout from '../layouts/Layout.astro';
import { defaultState } from '../data.js';

const subjects = defaultState.subjects;
---

<Layout title="GATE Civil Tracker 2027">
    <!-- Main Dashboard View -->
    <div id="dashboard-view" class="flex flex-col gap-6">
        
        <!-- Hero Progress Area -->
        <div class="glass-panel grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-6 items-center">
            <div class="flex flex-col items-center justify-center text-center">
                <div class="circular-progress" id="hero-progress-circle" style="--progress: 0%;">
                    <span class="relative z-10 text-3xl font-bold" id="hero-progress-text">0%</span>
                </div>
                <p class="text-text-muted text-sm font-semibold tracking-wide mt-2">Overall GATE Readiness</p>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div class="bg-black/20 border border-panel-border rounded-xl p-4 flex flex-col gap-1">
                    <span class="text-text-muted text-xs uppercase tracking-wide">Syllabus</span>
                    <span class="text-xl font-semibold" id="metric-syllabus">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-4 flex flex-col gap-1">
                    <span class="text-text-muted text-xs uppercase tracking-wide">PYQs</span>
                    <span class="text-xl font-semibold" id="metric-pyqs">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-4 flex flex-col gap-1">
                    <span class="text-text-muted text-xs uppercase tracking-wide">Tests</span>
                    <span class="text-xl font-semibold" id="metric-tests">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-4 flex flex-col gap-1">
                    <span class="text-text-muted text-xs uppercase tracking-wide">Mocks</span>
                    <span class="text-xl font-semibold" id="metric-mocks">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-4 flex flex-col gap-1">
                    <span class="text-text-muted text-xs uppercase tracking-wide">Revision</span>
                    <span class="text-xl font-semibold" id="metric-revision">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-4 flex flex-col gap-1">
                    <span class="text-text-muted text-xs uppercase tracking-wide">Study Hours</span>
                    <span class="text-xl font-semibold text-primary-accent" id="metric-hours">0h</span>
                </div>
            </div>
        </div>

        <!-- Subject Grid -->
        <div class="flex justify-between items-center mt-2">
            <h2 class="text-xl font-semibold">1. SYLLABUS COMPLETION</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {subjects.map(sub => (
                <div class="bg-panel-bg border border-panel-border rounded-2xl p-5 transition-all hover:border-white/20 hover:-translate-y-0.5 flex flex-col gap-4 subject-card" data-id={sub.id}>
                    <div class="flex items-start gap-3">
                        <div class="bg-white/5 p-2.5 rounded-lg flex items-center justify-center text-primary-accent" set:html={sub.icon} />
                        <div>
                            <h3 class="text-[1.1rem] font-semibold leading-tight mb-1">{sub.name}</h3>
                            <div class="text-xs text-text-muted">Tracker Weight: {sub.trackerWeight}%</div>
                        </div>
                    </div>
                    <div class="flex flex-col gap-2">
                        <div class="w-full h-2 bg-panel-border rounded-full overflow-hidden">
                            <div class="h-full bg-primary-accent rounded-full transition-all duration-300 subject-progress-bar" style="width: 0%" data-id={sub.id}></div>
                        </div>
                        <div class="flex justify-between text-sm text-text-muted">
                            <span class="subject-progress-text" data-id={sub.id}>0% Complete</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-center mt-auto pt-4 border-t border-panel-border">
                        <div class="text-sm flex items-center gap-1.5 text-text-muted">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="subject-hours-text" data-id={sub.id}>0h studied</span>
                        </div>
                        <a href={`/subject/${sub.id}`} class="btn">OPEN →</a>
                    </div>
                </div>
            ))}
        </div>

        <!-- Practice and Revision -->
        <div class="flex justify-between items-center mt-6">
            <h2 class="text-xl font-semibold">2. PRACTICE & REVISION</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- PYQs Card -->
            <div class="bg-panel-bg border border-panel-border rounded-2xl p-5 flex flex-col gap-4 transition-all hover:border-white/20">
                <div class="flex items-center gap-3 mb-2">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-check"><path d="M8 3H2v15h7c1.7 0 3 1.3 3 3V7c0-2.2-1.8-4-4-4Z"/><path d="m16 12 2 2 4-4"/><path d="M22 6V3h-6c-2.2 0-4 1.8-4 4v14c0-1.7 1.3-3 3-3h7v-2.3"/></svg>
                    </div>
                    <h3 class="text-lg font-semibold">PYQs</h3>
                </div>
                <div class="flex flex-col gap-2 overflow-y-auto max-h-[170px] pr-2 mt-2">
                    {subjects.map(sub => (
                        <div class="flex justify-between items-center bg-black/20 p-2 rounded-xl border border-panel-border shrink-0">
                            <span class="text-xs font-medium text-text-muted truncate w-24" title={sub.name}>{sub.name}</span>
                            <div class="flex items-center gap-1.5">
                                <input type="number" id={`input-pyq-${sub.id}`} data-subject={sub.id} min="0" class="input-pyq-dash bg-white/5 border border-panel-border text-text-main p-1 rounded-md focus:outline-none focus:border-primary-accent w-14 text-center text-xs font-semibold" value="0">
                                <span class="text-text-muted text-[10px] font-medium w-8 text-right pyq-total-dash" data-subject={sub.id}>/ 0</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Tests Card -->
            <div class="bg-panel-bg border border-panel-border rounded-2xl p-5 flex flex-col gap-4 transition-all hover:border-white/20">
                <div class="flex items-center gap-3 mb-2">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
                    </div>
                    <h3 class="text-lg font-semibold">Tests</h3>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-3 rounded-xl border border-panel-border mt-2">
                    <span class="text-sm font-medium text-text-muted">Topic Tests</span>
                    <div class="flex items-center gap-2">
                        <input type="number" id="input-tests-topic" min="0" max="40" class="bg-white/5 border border-panel-border text-text-main p-1.5 rounded-md focus:outline-none focus:border-primary-accent w-16 text-center text-sm font-semibold" value="0">
                        <span class="text-text-muted text-sm font-medium w-8 text-right">/ 40</span>
                    </div>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-3 rounded-xl border border-panel-border">
                    <span class="text-sm font-medium text-text-muted">Subject Tests</span>
                    <div class="flex items-center gap-2">
                        <input type="number" id="input-tests-subject" min="0" max="10" class="bg-white/5 border border-panel-border text-text-main p-1.5 rounded-md focus:outline-none focus:border-primary-accent w-16 text-center text-sm font-semibold" value="0">
                        <span class="text-text-muted text-sm font-medium w-8 text-right">/ 10</span>
                    </div>
                </div>
            </div>

            <!-- Mocks Card -->
            <div class="bg-panel-bg border border-panel-border rounded-2xl p-5 flex flex-col gap-4 transition-all hover:border-white/20">
                <div class="flex items-center gap-3 mb-2">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    </div>
                    <h3 class="text-lg font-semibold">Full-Length Mocks</h3>
                </div>
                <div class="flex flex-col items-center justify-center flex-grow bg-black/20 p-4 rounded-xl border border-panel-border gap-2 mt-2">
                    <span class="text-sm text-text-muted uppercase tracking-wider font-semibold">Completed</span>
                    <div class="flex items-baseline gap-2">
                        <input type="number" id="input-mocks" min="0" max="20" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent w-24 text-center text-3xl font-bold text-primary-accent" value="0">
                        <span class="text-text-muted text-lg font-bold">/ 20</span>
                    </div>
                </div>
            </div>

            <!-- Revision Card -->
            <div class="bg-panel-bg border border-panel-border rounded-2xl p-5 flex flex-col gap-4 transition-all hover:border-white/20">
                <div class="flex items-center gap-3 mb-2">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                    </div>
                    <h3 class="text-lg font-semibold">Revision (Subjects)</h3>
                </div>
                <div class="flex flex-col gap-2 mt-2">
                    <div class="flex justify-between items-center bg-black/20 p-2.5 rounded-xl border border-panel-border">
                        <span class="text-sm font-medium text-text-muted">1st Revision</span>
                        <div class="flex items-center gap-2">
                            <input type="number" id="input-rev-1" min="0" max="9" class="bg-white/5 border border-panel-border text-text-main p-1 rounded-md focus:outline-none focus:border-primary-accent w-14 text-center text-sm font-semibold" value="0">
                            <span class="text-text-muted text-sm font-medium w-6 text-right">/ 9</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-center bg-black/20 p-2.5 rounded-xl border border-panel-border">
                        <span class="text-sm font-medium text-text-muted">2nd Revision</span>
                        <div class="flex items-center gap-2">
                            <input type="number" id="input-rev-2" min="0" max="9" class="bg-white/5 border border-panel-border text-text-main p-1 rounded-md focus:outline-none focus:border-primary-accent w-14 text-center text-sm font-semibold" value="0">
                            <span class="text-text-muted text-sm font-medium w-6 text-right">/ 9</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-center bg-black/20 p-2.5 rounded-xl border border-panel-border">
                        <span class="text-sm font-medium text-text-muted">Final Revision</span>
                        <div class="flex items-center gap-2">
                            <input type="number" id="input-rev-f" min="0" max="9" class="bg-white/5 border border-panel-border text-text-main p-1 rounded-md focus:outline-none focus:border-primary-accent w-14 text-center text-sm font-semibold" value="0">
                            <span class="text-text-muted text-sm font-medium w-6 text-right">/ 9</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Summary -->
        <div class="glass-panel mt-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold">QUICK SUMMARY</h2>
            </div>
            <div class="flex flex-wrap gap-6 items-center justify-between">
                <div class="flex flex-wrap gap-4 text-text-muted text-sm">
                    <span id="qs-syllabus">Syllabus — 0%</span> | 
                    <span id="qs-pyqs">PYQs — 0%</span> | 
                    <span id="qs-tests">Tests — 0%</span> | 
                    <span id="qs-mocks">Mocks — 0%</span> | 
                    <span id="qs-revision">Revision — 0%</span> | 
                    <span id="qs-hours">Study Time — 0h</span>
                </div>
                <div class="bg-primary-accent/10 px-6 py-3 rounded-lg border border-primary-accent/30">
                    <div class="text-xs text-primary-accent uppercase tracking-wider">Tracker Estimate</div>
                    <div class="text-2xl font-bold text-white mt-1" id="metric-readiness">GATE READINESS: 0%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Settings Modal -->
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 p-4" id="settings-modal">
        <div class="bg-bg-dark border border-panel-border rounded-2xl p-6 w-full max-w-[500px] shadow-2xl max-h-[90vh] overflow-y-auto custom-scrollbar">
            <h3 class="text-xl font-semibold mb-5 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                Tracker Settings & Targets
            </h3>
            
            <div class="flex flex-col gap-6">
                <!-- Readiness Weights -->
                <div class="bg-black/20 p-4 rounded-xl border border-panel-border">
                    <h4 class="text-sm font-semibold text-primary-accent mb-3 uppercase tracking-wider">GATE Readiness Weights (%)</h4>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Syllabus</label>
                            <input type="number" id="set-weight-syllabus" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">PYQs</label>
                            <input type="number" id="set-weight-pyqs" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Tests</label>
                            <input type="number" id="set-weight-tests" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Mocks</label>
                            <input type="number" id="set-weight-mocks" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Revision</label>
                            <input type="number" id="set-weight-revision" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                    </div>
                </div>

                <!-- Target Values -->
                <div class="bg-black/20 p-4 rounded-xl border border-panel-border">
                    <h4 class="text-sm font-semibold text-primary-accent mb-3 uppercase tracking-wider">Practice Targets</h4>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Max Topic Tests</label>
                            <input type="number" id="set-target-topic-tests" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Max Subject Tests</label>
                            <input type="number" id="set-target-subject-tests" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Max Mocks</label>
                            <input type="number" id="set-target-mocks" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label class="text-xs text-text-muted">Total Revision Subjects</label>
                            <input type="number" id="set-target-revision" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                        </div>
                    </div>
                </div>
                
                <!-- PYQ Targets -->
                <div class="bg-black/20 p-4 rounded-xl border border-panel-border">
                    <h4 class="text-sm font-semibold text-primary-accent mb-3 uppercase tracking-wider">PYQ Targets by Subject</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[200px] overflow-y-auto pr-2 custom-scrollbar">
                        {subjects.map(sub => (
                            <div class="flex flex-col gap-1">
                                <label class="text-xs text-text-muted truncate w-full" title={sub.name}>{sub.name}</label>
                                <input type="number" id={`set-target-pyq-${sub.id}`} data-pyq-subject={sub.id} min="1" class="set-pyq-input bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent">
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <button class="btn" id="btn-settings-cancel">Cancel</button>
                <button class="btn btn-primary" id="btn-settings-save">Save & Apply</button>
            </div>
        </div>
    </div>

    <script>
        // Hydration logic
        function hydrateDashboard() {
            const state = window.getState();
            window.calculateAllMetrics(state);

            // Update Hero
            document.getElementById('hero-progress-text').textContent = window.formatPercent(state.gateReadiness);
            document.getElementById('hero-progress-circle').style.setProperty('--progress', `${state.gateReadiness}%`);
            
            document.getElementById('metric-syllabus').textContent = window.formatPercent(state.overallSyllabusProgress);
            document.getElementById('metric-pyqs').textContent = window.formatPercent(state.pyqProgress);
            document.getElementById('metric-tests').textContent = window.formatPercent(state.testProgress);
            document.getElementById('metric-mocks').textContent = window.formatPercent(state.mockProgress);
            document.getElementById('metric-revision').textContent = window.formatPercent(state.revisionProgress);
            document.getElementById('metric-hours').textContent = window.formatHours(state.totalHours);
            document.getElementById('metric-readiness').textContent = window.formatPercent(state.gateReadiness);
            
            // Quick summary
            document.getElementById('qs-syllabus').textContent = `Syllabus — ${window.formatPercent(state.overallSyllabusProgress)}`;
            document.getElementById('qs-pyqs').textContent = `PYQs — ${window.formatPercent(state.pyqProgress)}`;
            document.getElementById('qs-tests').textContent = `Tests — ${window.formatPercent(state.testProgress)}`;
            document.getElementById('qs-mocks').textContent = `Mocks — ${window.formatPercent(state.mockProgress)}`;
            document.getElementById('qs-revision').textContent = `Revision — ${window.formatPercent(state.revisionProgress)}`;
            document.getElementById('qs-hours').textContent = `Study Time — ${window.formatHours(state.totalHours)}`;
            
            // Render Subjects Progress
            state.subjects.forEach(sub => {
                const bar = document.querySelector(`.subject-progress-bar[data-id="${sub.id}"]`);
                const text = document.querySelector(`.subject-progress-text[data-id="${sub.id}"]`);
                const hours = document.querySelector(`.subject-hours-text[data-id="${sub.id}"]`);
                
                if(bar) bar.style.width = `${sub.progress}%`;
                if(text) text.textContent = `${window.formatPercent(sub.progress)} Complete`;
                if(hours) hours.textContent = `${window.formatHours(sub.hours)} studied`;
            });

            // Hydrate Practice & Revision inputs
            const inputs = [
                { id: 'input-tests-topic', value: state.tests.topic.completed, total: state.tests.topic.total },
                { id: 'input-tests-subject', value: state.tests.subject.completed, total: state.tests.subject.total },
                { id: 'input-mocks', value: state.mocks.completed, total: state.mocks.total },
                { id: 'input-rev-1', value: state.revision['1st'], total: state.revision.total },
                { id: 'input-rev-2', value: state.revision['2nd'], total: state.revision.total },
                { id: 'input-rev-f', value: state.revision.final, total: state.revision.total }
            ];
            
            inputs.forEach(item => {
                const el = document.getElementById(item.id);
                if (el) {
                    if (document.activeElement !== el) {
                        el.value = item.value;
                    }
                    el.max = item.total;
                    const totalSpan = el.nextElementSibling;
                    if (totalSpan) totalSpan.textContent = `/ ${item.total}`;
                }
            });

            // Hydrate PYQs
            state.subjects.forEach(sub => {
                const pyqInput = document.getElementById(`input-pyq-${sub.id}`);
                const pyqTotal = document.querySelector(`.pyq-total-dash[data-subject="${sub.id}"]`);
                if (state.pyqs[sub.id]) {
                    if (pyqInput && document.activeElement !== pyqInput) {
                        pyqInput.value = state.pyqs[sub.id].solved;
                        pyqInput.max = state.pyqs[sub.id].total;
                    }
                    if (pyqTotal) {
                        pyqTotal.textContent = `/ ${state.pyqs[sub.id].total}`;
                    }
                }
            });

            // Hydrate Settings Modal
            const w = state.settings?.weights || { syllabus: 0.60, pyqs: 0.15, tests: 0.10, mocks: 0.10, revision: 0.05 };
            document.getElementById('set-weight-syllabus').value = Math.round(w.syllabus * 100);
            document.getElementById('set-weight-pyqs').value = Math.round(w.pyqs * 100);
            document.getElementById('set-weight-tests').value = Math.round(w.tests * 100);
            document.getElementById('set-weight-mocks').value = Math.round(w.mocks * 100);
            document.getElementById('set-weight-revision').value = Math.round(w.revision * 100);

            document.getElementById('set-target-topic-tests').value = state.tests.topic.total;
            document.getElementById('set-target-subject-tests').value = state.tests.subject.total;
            document.getElementById('set-target-mocks').value = state.mocks.total;
            document.getElementById('set-target-revision').value = state.revision.total;

            state.subjects.forEach(sub => {
                const pyqSetInput = document.getElementById(`set-target-pyq-${sub.id}`);
                if (state.pyqs[sub.id] && pyqSetInput) {
                    pyqSetInput.value = state.pyqs[sub.id].total;
                }
            });
        }

        // Input Listeners
        const setupInput = (id, callback) => {
            const el = document.getElementById(id);
            if(el) {
                el.addEventListener('change', (e) => {
                    const val = parseInt(e.target.value);
                    if (isNaN(val) || val < 0) return;
                    const state = window.getState();
                    callback(state, val);
                    window.saveState(state);
                });
            }
        };

        setupInput('input-tests-topic', (s, v) => s.tests.topic.completed = Math.min(v, s.tests.topic.total));
        setupInput('input-tests-subject', (s, v) => s.tests.subject.completed = Math.min(v, s.tests.subject.total));
        setupInput('input-mocks', (s, v) => s.mocks.completed = Math.min(v, s.mocks.total));
        setupInput('input-rev-1', (s, v) => s.revision['1st'] = Math.min(v, 9));
        setupInput('input-rev-2', (s, v) => s.revision['2nd'] = Math.min(v, 9));
        setupInput('input-rev-f', (s, v) => s.revision.final = Math.min(v, 9));

        document.querySelectorAll('.input-pyq-dash').forEach(input => {
            input.addEventListener('change', (e) => {
                const val = parseInt(e.target.value);
                if (isNaN(val) || val < 0) return;
                const subjectId = e.target.dataset.subject;
                const state = window.getState();
                if (state.pyqs[subjectId]) {
                    const max = state.pyqs[subjectId].total;
                    state.pyqs[subjectId].solved = Math.min(val, max);
                    window.saveState(state);
                }
            });
        });

        // Settings Modal Logic
        const settingsModal = document.getElementById('settings-modal');
        document.querySelectorAll('.open-settings-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                hydrateDashboard(); // ensure it has the latest before showing
                settingsModal.style.display = 'flex';
            });
        });

        document.getElementById('btn-settings-cancel')?.addEventListener('click', () => {
            settingsModal.style.display = 'none';
        });

        // Auto-balance weights
        const weightInputs = [
            document.getElementById('set-weight-syllabus'),
            document.getElementById('set-weight-pyqs'),
            document.getElementById('set-weight-tests'),
            document.getElementById('set-weight-mocks'),
            document.getElementById('set-weight-revision')
        ];

        weightInputs.forEach(input => {
            input.addEventListener('change', (e) => {
                let newVal = parseInt(e.target.value) || 0;
                newVal = Math.max(0, Math.min(100, newVal));
                e.target.value = newVal;

                const otherInputs = weightInputs.filter(inp => inp !== e.target);
                let remaining = 100 - newVal;
                
                let otherSum = otherInputs.reduce((sum, inp) => sum + (parseInt(inp.value) || 0), 0);
                
                if (otherSum === 0) {
                    const share = Math.floor(remaining / otherInputs.length);
                    let rem = remaining % otherInputs.length;
                    otherInputs.forEach(inp => {
                        inp.value = share + (rem > 0 ? 1 : 0);
                        if (rem > 0) rem--;
                    });
                } else {
                    let currentNewSum = 0;
                    let values = otherInputs.map(inp => {
                        const oldVal = parseInt(inp.value) || 0;
                        const propVal = Math.round((oldVal / otherSum) * remaining);
                        currentNewSum += propVal;
                        return { inp, val: propVal };
                    });

                    let diff = remaining - currentNewSum;
                    if (diff !== 0) {
                        values.sort((a, b) => b.val - a.val);
                        values[0].val += diff;
                    }

                    values.forEach(v => v.inp.value = Math.max(0, v.val));
                }
            });
        });

        document.getElementById('btn-settings-save')?.addEventListener('click', () => {
            const state = window.getState();
            
            // Validate weights sum to 100
            const wSyl = parseFloat(document.getElementById('set-weight-syllabus').value) || 0;
            const wPyq = parseFloat(document.getElementById('set-weight-pyqs').value) || 0;
            const wTst = parseFloat(document.getElementById('set-weight-tests').value) || 0;
            const wMck = parseFloat(document.getElementById('set-weight-mocks').value) || 0;
            const wRev = parseFloat(document.getElementById('set-weight-revision').value) || 0;
            
            if (Math.round(wSyl + wPyq + wTst + wMck + wRev) !== 100) {
                alert('GATE Readiness Weights must sum up exactly to 100%!');
                return;
            }
            
            if(!state.settings) state.settings = {};
            state.settings.weights = {
                syllabus: wSyl / 100,
                pyqs: wPyq / 100,
                tests: wTst / 100,
                mocks: wMck / 100,
                revision: wRev / 100
            };

            // Targets
            state.tests.topic.total = Math.max(1, parseInt(document.getElementById('set-target-topic-tests').value) || 40);
            state.tests.subject.total = Math.max(1, parseInt(document.getElementById('set-target-subject-tests').value) || 10);
            state.mocks.total = Math.max(1, parseInt(document.getElementById('set-target-mocks').value) || 20);
            state.revision.total = Math.max(1, parseInt(document.getElementById('set-target-revision').value) || 9);

            document.querySelectorAll('.set-pyq-input').forEach(input => {
                const subId = input.dataset.pyqSubject;
                const val = Math.max(1, parseInt(input.value) || 100);
                if(state.pyqs[subId]) {
                    state.pyqs[subId].total = val;
                    // Cap solved at the new max
                    state.pyqs[subId].solved = Math.min(state.pyqs[subId].solved, val);
                }
            });
            
            // Cap existing values at new maxes
            state.tests.topic.completed = Math.min(state.tests.topic.completed, state.tests.topic.total);
            state.tests.subject.completed = Math.min(state.tests.subject.completed, state.tests.subject.total);
            state.mocks.completed = Math.min(state.mocks.completed, state.mocks.total);
            ['1st', '2nd', 'final'].forEach(k => {
                state.revision[k] = Math.min(state.revision[k], state.revision.total);
            });

            window.saveState(state);
            settingsModal.style.display = 'none';
        });

        // Run on load and state changes
        document.addEventListener('DOMContentLoaded', hydrateDashboard);
        window.addEventListener('stateChanged', hydrateDashboard);
    </script>
</Layout>
