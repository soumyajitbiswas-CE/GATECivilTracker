---
import Layout from '../layouts/Layout.astro';
import { defaultState } from '../data.js';

const subjects = defaultState.subjects;
---

<Layout title="GATE Civil Tracker 2027">
    <!-- Main Dashboard View -->
    <div id="dashboard-view" class="flex flex-col gap-5 sm:gap-6 min-w-0">
        
        <!-- Hero Progress Area -->
        <div class="glass-panel surface-hero p-4 sm:p-6 grid grid-cols-1 md:grid-cols-[auto_1fr] lg:grid-cols-[220px_1fr] gap-5 sm:gap-6 items-center">
            <div class="flex flex-col items-center justify-center text-center">
                <div class="circular-progress animate-pulse-glow" id="hero-progress-circle" style="--progress: 0%;">
                    <span class="relative z-10 text-2xl sm:text-3xl font-bold" id="hero-progress-text">0%</span>
                </div>
                <p class="text-text-muted text-xs sm:text-sm font-semibold tracking-wide mt-1 sm:mt-2">Overall GATE Readiness</p>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3.5 md:gap-4">
                <div class="bg-black/20 border border-panel-border rounded-xl p-3 sm:p-4 flex flex-col gap-1 min-w-0">
                    <span class="text-text-muted text-[10px] sm:text-xs uppercase tracking-wide truncate">Syllabus</span>
                    <span class="text-lg sm:text-xl font-semibold text-white" id="metric-syllabus">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-3 sm:p-4 flex flex-col gap-1 min-w-0">
                    <span class="text-text-muted text-[10px] sm:text-xs uppercase tracking-wide truncate">PYQs</span>
                    <span class="text-lg sm:text-xl font-semibold text-white" id="metric-pyqs">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-3 sm:p-4 flex flex-col gap-1 min-w-0">
                    <span class="text-text-muted text-[10px] sm:text-xs uppercase tracking-wide truncate">Tests</span>
                    <span class="text-lg sm:text-xl font-semibold text-white" id="metric-tests">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-3 sm:p-4 flex flex-col gap-1 min-w-0">
                    <span class="text-text-muted text-[10px] sm:text-xs uppercase tracking-wide truncate">Mocks</span>
                    <span class="text-lg sm:text-xl font-semibold text-white" id="metric-mocks">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-3 sm:p-4 flex flex-col gap-1 min-w-0">
                    <span class="text-text-muted text-[10px] sm:text-xs uppercase tracking-wide truncate">Revision</span>
                    <span class="text-lg sm:text-xl font-semibold text-white" id="metric-revision">0%</span>
                </div>
                <div class="bg-black/20 border border-panel-border rounded-xl p-3 sm:p-4 flex flex-col gap-1 min-w-0">
                    <span class="text-text-muted text-[10px] sm:text-xs uppercase tracking-wide truncate">Study Hours</span>
                    <span class="text-lg sm:text-xl font-semibold text-primary-accent" id="metric-hours">0h</span>
                </div>
            </div>
        </div>

        <!-- Subject Grid -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2.5 sm:gap-4 mt-2">
            <h2 class="text-lg sm:text-xl font-semibold tracking-tight">1. SYLLABUS COMPLETION</h2>
            <button class="btn btn-primary text-xs sm:text-sm px-3 sm:px-4 py-1.5 sm:py-2 flex items-center gap-1.5 open-syllabus-settings-btn shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit Syllabus
            </button>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {subjects.map((sub, index) => (
                <div class="surface-syllabus backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col justify-between subject-card min-w-0 glow-card group" data-id={sub.id}>
                    <!-- Top section: Title and Weight -->
                    <div class="flex flex-col gap-1 min-w-0">
                        <div class="flex items-start gap-3 min-w-0">
                            <div class="bg-white/5 p-2 rounded-lg flex items-center justify-center text-primary-accent shrink-0" set:html={sub.icon} />
                            <div class="flex flex-col min-w-0 flex-1">
                                <h3 class="text-[1.05rem] sm:text-[1.1rem] font-semibold leading-snug mb-0.5 break-words hyphens-auto">{sub.name}</h3>
                                <div class="text-[11px] text-text-muted font-medium">Tracker Weight: <span class="subject-weight-text" data-id={sub.id}>{sub.trackerWeight}%</span></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Middle section: Progress -->
                    <div class="flex flex-col gap-2 mt-4 mb-3">
                        <div>
                            <span class="subject-progress-text text-xl sm:text-2xl font-bold text-white tracking-tight" data-id={sub.id}>0% <span class="text-xs font-medium text-text-muted ml-1">Complete</span></span>
                        </div>
                        <div class="w-full h-2 bg-panel-border rounded-full overflow-hidden">
                            <div class="h-full bg-primary-accent rounded-full transition-all duration-300 subject-progress-bar" style="width: 0%" data-id={sub.id}></div>
                        </div>
                    </div>
                    
                    <!-- Bottom section: Hours and Action -->
                    <div class="flex justify-between items-center gap-2 mt-auto pt-3 border-t border-panel-border">
                        <div class="text-[12px] sm:text-[13px] flex items-center gap-1.5 text-text-muted font-medium pb-0.5 truncate">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="subject-hours-text truncate" data-id={sub.id}>0h studied</span>
                        </div>
                        <a href={`/subject/${sub.id}`} class="btn text-[11px] sm:text-[12px] px-2.5 sm:px-3 py-1 sm:py-1.5 shrink-0">OPEN →</a>
                    </div>
                </div>
            ))}
        </div>

        <!-- Practice and Revision -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2.5 sm:gap-4 mt-6 mb-3 sm:mb-4">
            <h2 class="text-lg sm:text-xl font-semibold tracking-tight">2. PRACTICE & REVISION</h2>
            <button class="btn btn-primary text-xs sm:text-sm px-3 sm:px-4 py-1.5 sm:py-2 flex items-center gap-1.5 open-settings-btn shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit Targets
            </button>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
            <!-- PYQs Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-center gap-3 mb-1">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-check"><path d="M8 3H2v15h7c1.7 0 3 1.3 3 3V7c0-2.2-1.8-4-4-4Z"/><path d="m16 12 2 2 4-4"/><path d="M22 6V3h-6c-2.2 0-4 1.8-4 4v14c0-1.7 1.3-3 3-3h7v-2.3"/></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-semibold">PYQs</h3>
                </div>
                <div class="flex flex-col gap-2 overflow-y-auto max-h-[170px] pr-1 sm:pr-2 custom-scrollbar mt-1">
                    {subjects.map(sub => (
                        <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border shrink-0 min-w-0 gap-2">
                            <span class="text-xs sm:text-sm font-medium text-text-muted truncate flex-1 min-w-0" title={sub.name}>{sub.name}</span>
                            <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                                <input type="number" id={`input-pyq-${sub.id}`} data-subject={sub.id} min="0" class="input-pyq-dash bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                                <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                                    <span class="text-text-muted text-[10px] sm:text-[11px] font-medium pyq-total-dash" data-subject={sub.id}>/ 0</span>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Tests Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-center gap-3 mb-1">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-semibold">Tests</h3>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-2.5 sm:p-3 rounded-xl border border-panel-border gap-2 mt-1 min-w-0">
                    <span class="text-xs sm:text-sm font-medium text-text-muted truncate">Topic Tests</span>
                    <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                        <input type="number" id="input-tests-topic" min="0" max="40" class="bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                        <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                            <span class="text-text-muted text-[10px] sm:text-[11px] font-medium">/ 40</span>
                        </div>
                    </div>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-2.5 sm:p-3 rounded-xl border border-panel-border gap-2 min-w-0">
                    <span class="text-xs sm:text-sm font-medium text-text-muted truncate">Subject Tests</span>
                    <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                        <input type="number" id="input-tests-subject" min="0" max="10" class="bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                        <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                            <span class="text-text-muted text-[10px] sm:text-[11px] font-medium">/ 10</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mocks Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-center gap-3 mb-1">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-semibold">Full-Length Mocks</h3>
                </div>
                <div class="flex justify-between items-center bg-black/20 p-2.5 sm:p-3 rounded-xl border border-panel-border gap-2 mt-1 min-w-0">
                    <span class="text-xs sm:text-sm font-medium text-text-muted truncate uppercase tracking-wider">Completed</span>
                    <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                        <input type="number" id="input-mocks" min="0" max="20" class="bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                        <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                            <span class="text-text-muted text-[10px] sm:text-[11px] font-medium">/ 20</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Revision Card -->
            <div class="surface-practice backdrop-blur-md border border-panel-border rounded-2xl p-4 sm:p-5 flex flex-col gap-3 sm:gap-4 min-w-0 glow-card">
                <div class="flex items-center gap-3 mb-1">
                    <div class="bg-white/5 p-2 rounded-lg text-primary-accent shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                    </div>
                    <h3 class="text-base sm:text-lg font-semibold">Revision (Subjects)</h3>
                </div>
                <div class="flex flex-col gap-2 mt-1">
                    <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border gap-2 min-w-0">
                        <span class="text-xs sm:text-sm font-medium text-text-muted truncate">1st Revision</span>
                        <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                            <input type="number" id="input-rev-1" min="0" max="9" class="bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                            <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                                <span class="text-text-muted text-[10px] sm:text-[11px] font-medium">/ 9</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border gap-2 min-w-0">
                        <span class="text-xs sm:text-sm font-medium text-text-muted truncate">2nd Revision</span>
                        <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                            <input type="number" id="input-rev-2" min="0" max="9" class="bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                            <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                                <span class="text-text-muted text-[10px] sm:text-[11px] font-medium">/ 9</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex justify-between items-center bg-black/20 p-2 sm:p-2.5 rounded-xl border border-panel-border gap-2 min-w-0">
                        <span class="text-xs sm:text-sm font-medium text-text-muted truncate">Final Revision</span>
                        <div class="flex items-center bg-white/5 border border-panel-border rounded-lg focus-within:border-primary-accent focus-within:ring-1 focus-within:ring-primary-accent/30 overflow-hidden shrink-0 transition-colors">
                            <input type="number" id="input-rev-f" min="0" max="9" class="bg-transparent text-text-main p-1 sm:p-1.5 w-12 sm:w-14 text-center text-xs sm:text-sm font-semibold focus:outline-none" value="0">
                            <div class="bg-black/40 px-2 sm:px-2.5 py-1 sm:py-1.5 border-l border-panel-border h-full flex items-center justify-center">
                                <span class="text-text-muted text-[10px] sm:text-[11px] font-medium">/ 9</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="mt-8 pt-6 border-t border-panel-border flex flex-col sm:flex-row justify-between items-center gap-4 text-xs sm:text-sm">
            <div class="text-text-muted text-center sm:text-left">
                Made for GATE CE students by <span class="font-semibold text-primary-accent/90">Soumyajit Biswas</span>
            </div>
            <div class="flex items-center gap-4">
                <a href="https://www.linkedin.com/in/soumyajitbiswas-ce/" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary-accent transition-colors" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                </a>
                <a href="https://github.com/soumyajitbiswas-CE" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary-accent transition-colors" aria-label="GitHub">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                </a>
            </div>
        </footer>
    </div>

    <!-- Global Settings Modal -->
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 overflow-y-auto" id="settings-modal">
        <div class="flex min-h-full items-center justify-center p-4 sm:p-6">
            <div class="bg-[#06140e] border border-panel-border rounded-2xl p-4 sm:p-6 w-[calc(100%-2rem)] sm:w-full max-w-[540px] mx-auto shadow-2xl flex flex-col overflow-hidden relative">
            <h3 class="text-lg sm:text-xl font-semibold mb-4 sm:mb-5 flex items-center gap-2 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent shrink-0"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                Tracker Settings & Targets
            </h3>
            
            <div class="flex flex-col gap-4 sm:gap-5 overflow-y-auto pr-1 sm:pr-2 custom-scrollbar flex-grow min-w-0">
                <!-- Target Values -->
                <div class="bg-black/20 p-3.5 sm:p-4 rounded-xl border border-panel-border min-w-0">
                    <h4 class="text-xs sm:text-sm font-semibold text-primary-accent mb-2.5 sm:mb-3 uppercase tracking-wider">Practice Targets</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3 min-w-0">
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Max Topic Tests</label>
                            <input type="number" id="set-target-topic-tests" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Max Subject Tests</label>
                            <input type="number" id="set-target-subject-tests" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Max Mocks</label>
                            <input type="number" id="set-target-mocks" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Total Revision Subjects</label>
                            <input type="number" id="set-target-revision" min="1" class="bg-white/5 border border-panel-border text-text-main p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                    </div>
                </div>
                
                <!-- PYQ Targets -->
                <div class="bg-black/20 p-3.5 sm:p-4 rounded-xl border border-panel-border min-w-0">
                    <h4 class="text-xs sm:text-sm font-semibold text-primary-accent mb-2.5 sm:mb-3 uppercase tracking-wider">PYQ Targets by Subject</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-[180px] overflow-y-auto pr-1 custom-scrollbar min-w-0">
                        {subjects.map(sub => (
                            <div class="flex flex-col gap-1 min-w-0">
                                <label class="text-xs text-text-muted truncate w-full" title={sub.name}>{sub.name}</label>
                                <input type="number" id={`set-target-pyq-${sub.id}`} data-pyq-subject={sub.id} min="1" class="set-pyq-input bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 sm:gap-3 mt-4 sm:mt-6 shrink-0 pt-3 border-t border-panel-border">
                <button class="btn justify-center text-xs sm:text-sm py-2" id="btn-settings-cancel">Cancel</button>
                <button class="btn btn-primary justify-center text-xs sm:text-sm py-2" id="btn-settings-save">Save & Apply</button>
            </div>
        </div>
        </div>
    </div>

    <!-- Syllabus Settings Modal -->
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 overflow-y-auto" id="syllabus-settings-modal">
        <div class="flex min-h-full items-center justify-center p-4 sm:p-6">
            <div class="bg-[#06140e] border border-panel-border rounded-2xl p-4 sm:p-6 w-[calc(100%-2rem)] sm:w-full max-w-[650px] mx-auto shadow-2xl flex flex-col overflow-hidden relative">
            <h3 class="text-lg sm:text-xl font-semibold mb-4 sm:mb-5 flex items-center gap-2 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-accent shrink-0"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Edit Syllabus Topics
            </h3>
            
            <div class="flex flex-col gap-4 overflow-y-auto custom-scrollbar flex-grow pr-1 sm:pr-2 min-w-0">
                <!-- Readiness Weights -->
                <div class="bg-black/20 p-3.5 sm:p-4 rounded-xl border border-panel-border shrink-0 min-w-0">
                    <h4 class="text-xs sm:text-sm font-semibold text-primary-accent mb-2.5 sm:mb-3 uppercase tracking-wider">GATE Readiness Weights (%)</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2 sm:gap-2.5 min-w-0">
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Syllabus</label>
                            <input type="number" id="set-weight-syllabus" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">PYQs</label>
                            <input type="number" id="set-weight-pyqs" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Tests</label>
                            <input type="number" id="set-weight-tests" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Mocks</label>
                            <input type="number" id="set-weight-mocks" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                        <div class="flex flex-col gap-1 min-w-0">
                            <label class="text-xs text-text-muted">Revision</label>
                            <input type="number" id="set-weight-revision" min="0" max="100" class="bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-sm w-full">
                        </div>
                    </div>
                </div>
                <!-- Subject Tracker Weights Allocation -->
                <div class="bg-black/20 p-3.5 sm:p-4 rounded-xl border border-panel-border shrink-0 min-w-0">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1 mb-2.5 sm:mb-3 min-w-0">
                        <h4 class="text-xs sm:text-sm font-semibold text-primary-accent uppercase tracking-wider">Subject Tracker Weights (%)</h4>
                        <span class="text-xs text-text-muted">Target: 100% Total</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 max-h-[160px] overflow-y-auto pr-1 custom-scrollbar min-w-0">
                        {subjects.map(sub => (
                            <div class="flex flex-col gap-1 bg-black/30 p-2 rounded-lg border border-panel-border min-w-0">
                                <label class="text-[11px] text-text-muted truncate font-medium" title={sub.name}>{sub.name}</label>
                                <div class="flex items-center gap-1 min-w-0">
                                    <input type="number" step="0.1" min="0" max="100" class="set-subject-weight-input bg-white/5 border border-panel-border text-text-main p-1 rounded-md focus:outline-none focus:border-primary-accent text-xs w-full font-semibold" data-subject-id={sub.id} id={`set-subject-weight-${sub.id}`} value={sub.trackerWeight}>
                                    <span class="text-xs text-text-muted font-semibold shrink-0">%</span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="flex flex-col gap-2 shrink-0 min-w-0">
                    <div class="flex justify-between items-center gap-2">
                        <label class="text-xs sm:text-sm font-semibold text-text-muted truncate">Select Subject for Sub-Topics</label>
                        <span class="text-xs text-primary-accent font-medium shrink-0" id="selected-subject-weight-display">Weight: 15%</span>
                    </div>
                    <select id="syllabus-subject-select" class="bg-white/5 border border-panel-border text-text-main p-2.5 sm:p-3 rounded-lg focus:outline-none focus:border-primary-accent cursor-pointer text-sm w-full">
                        {subjects.map(sub => (
                            <option value={sub.id} class="bg-bg-dark">{sub.name}</option>
                        ))}
                    </select>
                </div>
                
                <div class="bg-black/20 p-3.5 sm:p-4 rounded-xl border border-panel-border flex flex-col gap-3 min-h-[220px] sm:min-h-[280px] flex-grow overflow-hidden min-w-0">
                    <div class="flex justify-between items-center mb-1 shrink-0 gap-2">
                        <h4 class="text-xs sm:text-sm font-semibold text-primary-accent uppercase tracking-wider">Sub-Topics</h4>
                        <button class="btn btn-primary btn-sm flex items-center gap-1 shrink-0" id="btn-add-topic" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            Add Topic (<span id="dashboard-topic-count">0</span>/40)
                        </button>
                    </div>
                    
                    <div class="flex justify-between items-center px-1 text-xs text-text-muted font-medium mb-1">
                        <span class="flex-grow">Topic Name</span>
                        <span class="w-16 sm:w-20 text-center">Weight</span>
                        <span class="w-12 sm:w-16 text-center" title="Normalized percentage within this subject">True %</span>
                        <span class="w-8 sm:w-9"></span>
                    </div>

                    <div id="topics-edit-list" class="flex flex-col gap-2.5 overflow-y-auto pr-1 custom-scrollbar flex-grow min-w-0">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 sm:gap-3 mt-4 sm:mt-6 shrink-0 pt-3 border-t border-panel-border">
                <button class="btn justify-center text-xs sm:text-sm py-2" id="btn-syllabus-cancel">Cancel</button>
                <button class="btn btn-primary justify-center text-xs sm:text-sm py-2" id="btn-syllabus-save">Save & Apply</button>
            </div>
        </div>
        </div>
    </div>

    <script>
        // Hydration logic
        function hydrateDashboard() {
            const state = window.getState();
            window.calculateAllMetrics(state);

            // Update Hero
            document.getElementById('hero-progress-text').textContent = window.formatPercent(state.gateReadiness);
            document.getElementById('hero-progress-circle').style.setProperty('--progress', `${state.gateReadiness}%`);
            
            document.getElementById('metric-syllabus').textContent = window.formatPercent(state.overallSyllabusProgress);
            document.getElementById('metric-pyqs').textContent = window.formatPercent(state.pyqProgress);
            document.getElementById('metric-tests').textContent = window.formatPercent(state.testProgress);
            document.getElementById('metric-mocks').textContent = window.formatPercent(state.mockProgress);
            document.getElementById('metric-revision').textContent = window.formatPercent(state.revisionProgress);
            document.getElementById('metric-hours').textContent = window.formatHours(state.totalHours);
            // Render Subjects Progress
            state.subjects.forEach(sub => {
                const bar = document.querySelector(`.subject-progress-bar[data-id="${sub.id}"]`);
                const text = document.querySelector(`.subject-progress-text[data-id="${sub.id}"]`);
                const hours = document.querySelector(`.subject-hours-text[data-id="${sub.id}"]`);
                const weightText = document.querySelector(`.subject-weight-text[data-id="${sub.id}"]`);
                
                if(bar) bar.style.width = `${sub.progress}%`;
                if(text) text.innerHTML = `${window.formatPercent(sub.progress)} <span class="text-xs font-medium text-text-muted ml-1">Complete</span>`;
                if(hours) hours.textContent = `${window.formatHours(sub.hours)} studied`;
                if(weightText) weightText.textContent = `${sub.trackerWeight}%`;
            });

            // Hydrate Practice & Revision inputs
            const inputs = [
                { id: 'input-tests-topic', value: state.tests.topic.completed, total: state.tests.topic.total },
                { id: 'input-tests-subject', value: state.tests.subject.completed, total: state.tests.subject.total },
                { id: 'input-mocks', value: state.mocks.completed, total: state.mocks.total },
                { id: 'input-rev-1', value: state.revision['1st'], total: state.revision.total },
                { id: 'input-rev-2', value: state.revision['2nd'], total: state.revision.total },
                { id: 'input-rev-f', value: state.revision.final, total: state.revision.total }
            ];
            
            inputs.forEach(item => {
                const el = document.getElementById(item.id);
                if (el) {
                    if (document.activeElement !== el) {
                        el.value = item.value;
                    }
                    el.max = item.total;
                    const totalSpan = el.nextElementSibling?.querySelector('span') || el.nextElementSibling;
                    if (totalSpan) totalSpan.textContent = `/ ${item.total}`;
                }
            });

            // Hydrate PYQs
            state.subjects.forEach(sub => {
                const pyqInput = document.getElementById(`input-pyq-${sub.id}`);
                const pyqTotal = document.querySelector(`.pyq-total-dash[data-subject="${sub.id}"]`);
                if (state.pyqs[sub.id]) {
                    if (pyqInput && document.activeElement !== pyqInput) {
                        pyqInput.value = state.pyqs[sub.id].solved;
                        pyqInput.max = state.pyqs[sub.id].total;
                    }
                    if (pyqTotal) {
                        pyqTotal.textContent = `/ ${state.pyqs[sub.id].total}`;
                    }
                }
            });

            // Hydrate Settings Modal
            const w = state.settings?.weights || { syllabus: 0.60, pyqs: 0.15, tests: 0.10, mocks: 0.10, revision: 0.05 };
            document.getElementById('set-weight-syllabus').value = Math.round(w.syllabus * 100);
            document.getElementById('set-weight-pyqs').value = Math.round(w.pyqs * 100);
            document.getElementById('set-weight-tests').value = Math.round(w.tests * 100);
            document.getElementById('set-weight-mocks').value = Math.round(w.mocks * 100);
            document.getElementById('set-weight-revision').value = Math.round(w.revision * 100);

            document.getElementById('set-target-topic-tests').value = state.tests.topic.total;
            document.getElementById('set-target-subject-tests').value = state.tests.subject.total;
            document.getElementById('set-target-mocks').value = state.mocks.total;
            document.getElementById('set-target-revision').value = state.revision.total;

            state.subjects.forEach(sub => {
                const pyqSetInput = document.getElementById(`set-target-pyq-${sub.id}`);
                if (state.pyqs[sub.id] && pyqSetInput) {
                    pyqSetInput.value = state.pyqs[sub.id].total;
                }
            });
        }

        // Input Listeners
        const setupInput = (id, callback) => {
            const el = document.getElementById(id);
            if(el) {
                el.addEventListener('change', (e) => {
                    const val = parseInt(e.target.value);
                    if (isNaN(val) || val < 0) return;
                    const state = window.getState();
                    const clamped = callback(state, val);
                    if (clamped !== undefined) {
                        e.target.value = clamped;
                    }
                    window.saveState(state);
                });
            }
        };

        setupInput('input-tests-topic', (s, v) => s.tests.topic.completed = Math.min(v, s.tests.topic.total));
        setupInput('input-tests-subject', (s, v) => s.tests.subject.completed = Math.min(v, s.tests.subject.total));
        setupInput('input-mocks', (s, v) => s.mocks.completed = Math.min(v, s.mocks.total));
        setupInput('input-rev-1', (s, v) => s.revision['1st'] = Math.min(v, 9));
        setupInput('input-rev-2', (s, v) => s.revision['2nd'] = Math.min(v, 9));
        setupInput('input-rev-f', (s, v) => s.revision.final = Math.min(v, 9));

        document.querySelectorAll('.input-pyq-dash').forEach(input => {
            input.addEventListener('change', (e) => {
                const val = parseInt(e.target.value);
                if (isNaN(val) || val < 0) return;
                const subjectId = e.target.dataset.subject;
                const state = window.getState();
                if (state.pyqs[subjectId]) {
                    const max = state.pyqs[subjectId].total;
                    state.pyqs[subjectId].solved = Math.min(val, max);
                    e.target.value = state.pyqs[subjectId].solved;
                    window.saveState(state);
                }
            });
        });

        // Settings Modal Logic
        const settingsModal = document.getElementById('settings-modal');
        document.querySelectorAll('.open-settings-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                hydrateDashboard(); // ensure it has the latest before showing
                settingsModal.classList.remove('hidden');
            });
        });

        document.getElementById('btn-settings-cancel')?.addEventListener('click', () => {
            settingsModal.classList.add('hidden');
        });

        document.getElementById('btn-settings-save')?.addEventListener('click', () => {
            const state = window.getState();

            // Targets
            state.tests.topic.total = Math.max(1, parseInt(document.getElementById('set-target-topic-tests').value) || 40);
            state.tests.subject.total = Math.max(1, parseInt(document.getElementById('set-target-subject-tests').value) || 10);
            state.mocks.total = Math.max(1, parseInt(document.getElementById('set-target-mocks').value) || 20);
            state.revision.total = Math.max(1, parseInt(document.getElementById('set-target-revision').value) || 9);

            document.querySelectorAll('.set-pyq-input').forEach(input => {
                const subId = input.dataset.pyqSubject;
                const val = Math.max(1, parseInt(input.value) || 100);
                if(state.pyqs[subId]) {
                    state.pyqs[subId].total = val;
                    // Cap solved at the new max
                    state.pyqs[subId].solved = Math.min(state.pyqs[subId].solved, val);
                }
            });
            
            // Cap existing values at new maxes
            state.tests.topic.completed = Math.min(state.tests.topic.completed, state.tests.topic.total);
            state.tests.subject.completed = Math.min(state.tests.subject.completed, state.tests.subject.total);
            state.mocks.completed = Math.min(state.mocks.completed, state.mocks.total);
            ['1st', '2nd', 'final'].forEach(k => {
                state.revision[k] = Math.min(state.revision[k], state.revision.total);
            });

            window.saveState(state);
            settingsModal.classList.add('hidden');
        });

        // Syllabus Modal Logic
        const syllabusModal = document.getElementById('syllabus-settings-modal');
        const syllabusSelect = document.getElementById('syllabus-subject-select');
        const topicsList = document.getElementById('topics-edit-list');
        const btnAddTopic = document.getElementById('btn-add-topic');
        
        let workingSubjects = [];

        function syncCurrentVisibleTopics() {
            if (!syllabusSelect || !workingSubjects.length) return;
            const currentSubjectId = syllabusSelect.value;
            const currentSubject = workingSubjects.find(s => s.id === currentSubjectId);
            if (!currentSubject) return;

            topicsList.querySelectorAll('.topic-name-input').forEach(inp => {
                const idx = parseInt(inp.dataset.idx);
                if (currentSubject.topics[idx]) currentSubject.topics[idx].name = inp.value;
            });
            topicsList.querySelectorAll('.topic-weight-input').forEach(inp => {
                const idx = parseInt(inp.dataset.idx);
                if (currentSubject.topics[idx]) {
                    const val = parseFloat(inp.value);
                    currentSubject.topics[idx].trackerWeight = isNaN(val) ? 0 : val;
                }
            });

            document.querySelectorAll('.set-subject-weight-input').forEach(inp => {
                const subId = inp.dataset.subjectId;
                const sub = workingSubjects.find(s => s.id === subId);
                if (sub) {
                    const val = parseFloat(inp.value);
                    sub.trackerWeight = isNaN(val) ? 0 : val;
                }
            });
        }

        function renderWorkingTopics(subjectId) {
            topicsList.innerHTML = '';
            const subject = workingSubjects.find(s => s.id === subjectId);
            if (!subject) return;

            const disp = document.getElementById('selected-subject-weight-display');
            if (disp) disp.textContent = `Weight: ${subject.trackerWeight}%`;

            const totalTopicWeight = subject.topics.reduce((sum, t) => sum + (parseFloat(t.trackerWeight) || 0), 0);

            subject.topics.forEach((topic, idx) => {
                const truePct = totalTopicWeight === 0 ? 0 : ((parseFloat(topic.trackerWeight) || 0) / totalTopicWeight) * 100;
                const row = document.createElement('div');
                row.className = "flex items-center gap-1.5 sm:gap-2 bg-black/30 p-2 rounded-lg border border-panel-border shrink-0 min-w-0";
                row.innerHTML = `
                    <input type="text" class="topic-name-input flex-grow min-w-0 bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-xs sm:text-sm" value="${topic.name}" data-idx="${idx}">
                    <input type="number" step="0.1" class="topic-weight-input w-16 sm:w-20 shrink-0 bg-white/5 border border-panel-border text-text-main p-1.5 sm:p-2 rounded-md focus:outline-none focus:border-primary-accent text-xs sm:text-sm text-center font-semibold" value="${topic.trackerWeight}" data-idx="${idx}" title="Relative Weight">
                    <span class="topic-true-percent w-12 sm:w-16 text-center text-xs text-primary-accent font-semibold shrink-0" data-idx="${idx}">${truePct.toFixed(1)}%</span>
                    <button class="btn btn-sm text-red-400 hover:text-red-300 hover:bg-red-400/10 btn-delete-topic shrink-0 p-1.5 sm:p-2" data-idx="${idx}" title="Remove Topic">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    </button>
                `;
                topicsList.appendChild(row);
            });
            
            const countSpan = document.getElementById('dashboard-topic-count');
            if (countSpan) countSpan.textContent = subject.topics.length;
            if (btnAddTopic) {
                btnAddTopic.disabled = subject.topics.length >= 40;
                btnAddTopic.style.opacity = subject.topics.length >= 40 ? '0.5' : '1';
                btnAddTopic.style.cursor = subject.topics.length >= 40 ? 'not-allowed' : 'pointer';
            }

            topicsList.querySelectorAll('.topic-name-input').forEach(inp => {
                const update = (e) => {
                    const idx = parseInt(e.target.dataset.idx);
                    if (subject.topics[idx]) subject.topics[idx].name = e.target.value;
                };
                inp.addEventListener('input', update);
                inp.addEventListener('change', update);
            });
            topicsList.querySelectorAll('.topic-weight-input').forEach(inp => {
                const update = (e) => {
                    const idx = parseInt(e.target.dataset.idx);
                    if (subject.topics[idx]) {
                        let val = parseFloat(e.target.value);
                        subject.topics[idx].trackerWeight = isNaN(val) ? 0 : val;
                        
                        // Dynamically update true percentages without re-rendering everything
                        const totalTopicWeight = subject.topics.reduce((sum, t) => sum + (parseFloat(t.trackerWeight) || 0), 0);
                        topicsList.querySelectorAll('.topic-true-percent').forEach(span => {
                            const i = parseInt(span.dataset.idx);
                            if (subject.topics[i]) {
                                const w = parseFloat(subject.topics[i].trackerWeight) || 0;
                                const truePct = totalTopicWeight === 0 ? 0 : (w / totalTopicWeight) * 100;
                                span.textContent = `${truePct.toFixed(1)}%`;
                            }
                        });
                    }
                };
                inp.addEventListener('input', update);
                inp.addEventListener('change', update);
            });
            topicsList.querySelectorAll('.btn-delete-topic').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    syncCurrentVisibleTopics();
                    const idx = parseInt(e.currentTarget.dataset.idx);
                    subject.topics.splice(idx, 1);
                    renderWorkingTopics(subjectId);
                });
            });
        }

        // Setup subject weight input listeners
        document.querySelectorAll('.set-subject-weight-input').forEach(inp => {
            const updateSubjectWeight = (e) => {
                const subId = e.target.dataset.subjectId;
                const sub = workingSubjects.find(s => s.id === subId);
                if (sub) {
                    const val = parseFloat(e.target.value);
                    sub.trackerWeight = isNaN(val) ? 0 : val;
                    if (syllabusSelect && syllabusSelect.value === subId) {
                        const disp = document.getElementById('selected-subject-weight-display');
                        if (disp) disp.textContent = `Weight: ${sub.trackerWeight}%`;
                    }
                }
            };
            inp.addEventListener('input', updateSubjectWeight);
            inp.addEventListener('change', updateSubjectWeight);
        });

        document.querySelectorAll('.open-syllabus-settings-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                workingSubjects = JSON.parse(JSON.stringify(window.getState().subjects));
                workingSubjects.forEach(s => {
                    const inp = document.getElementById(`set-subject-weight-${s.id}`);
                    if (inp) inp.value = s.trackerWeight;
                });
                syllabusSelect.value = workingSubjects[0].id;
                renderWorkingTopics(syllabusSelect.value);
                syllabusModal.classList.remove('hidden');
            });
        });

        syllabusSelect?.addEventListener('change', (e) => {
            syncCurrentVisibleTopics();
            renderWorkingTopics(e.target.value);
        });

        btnAddTopic?.addEventListener('click', () => {
            syncCurrentVisibleTopics();
            const subjectId = syllabusSelect.value;
            const subject = workingSubjects.find(s => s.id === subjectId);
            if (!subject) return;
            
            if (subject.topics.length >= 40) {
                alert('Maximum of 40 topics allowed per subject.');
                return;
            }
            
            subject.topics.push({
                id: `custom_${Date.now()}`,
                name: "New Topic",
                trackerWeight: 1.0,
                completed: false
            });
            renderWorkingTopics(subjectId);
            setTimeout(() => { topicsList.scrollTop = topicsList.scrollHeight; }, 10);
        });

        document.getElementById('btn-syllabus-cancel')?.addEventListener('click', () => {
            syllabusModal.classList.add('hidden');
        });

        document.getElementById('btn-syllabus-save')?.addEventListener('click', () => {
            syncCurrentVisibleTopics();
            const state = window.getState();
            
            // 1. GATE Readiness Weights save logic
            const oldW = state.settings?.weights || { syllabus: 0.60, pyqs: 0.15, tests: 0.10, mocks: 0.10, revision: 0.05 };
            const inputs = {
                syllabus: parseFloat(document.getElementById('set-weight-syllabus').value) || 0,
                pyqs: parseFloat(document.getElementById('set-weight-pyqs').value) || 0,
                tests: parseFloat(document.getElementById('set-weight-tests').value) || 0,
                mocks: parseFloat(document.getElementById('set-weight-mocks').value) || 0,
                revision: parseFloat(document.getElementById('set-weight-revision').value) || 0
            };

            let changedKeys = [];
            let unchangedKeys = [];
            let changedSum = 0;

            Object.keys(inputs).forEach(k => {
                if (Math.round(inputs[k]) !== Math.round(oldW[k] * 100)) {
                    changedKeys.push(k);
                    changedSum += inputs[k];
                } else {
                    unchangedKeys.push(k);
                }
            });

            if (changedKeys.length > 0) {
                let remaining = 100 - changedSum;
                if (remaining < 0) {
                    let total = Object.values(inputs).reduce((a,b)=>a+b, 0);
                    let currentSum = 0;
                    let values = Object.keys(inputs).map(k => {
                        let prop = Math.round((inputs[k] / total) * 100);
                        currentSum += prop;
                        return { k, val: prop };
                    });
                    let diff = 100 - currentSum;
                    if(diff !== 0) {
                        values.sort((a,b) => b.val - a.val);
                        values[0].val += diff;
                    }
                    values.forEach(v => inputs[v.k] = v.val);
                } else if (unchangedKeys.length > 0) {
                    let unchangedOriginalSum = unchangedKeys.reduce((sum, k) => sum + Math.round(oldW[k] * 100), 0);
                    let currentNewSum = 0;
                    let values = unchangedKeys.map(k => {
                        const oldVal = Math.round(oldW[k] * 100);
                        const propVal = unchangedOriginalSum === 0 
                            ? Math.floor(remaining / unchangedKeys.length) 
                            : Math.round((oldVal / unchangedOriginalSum) * remaining);
                        currentNewSum += propVal;
                        return { k, val: propVal };
                    });
                    
                    let diff = remaining - currentNewSum;
                    if (diff !== 0 && values.length > 0) {
                        values.sort((a,b) => b.val - a.val);
                        values[0].val += diff;
                    }
                    
                    values.forEach(v => {
                        inputs[v.k] = Math.max(0, v.val);
                    });
                } else if (changedSum !== 100) {
                    let currentSum = 0;
                    let values = Object.keys(inputs).map(k => {
                        let prop = Math.round((inputs[k] / changedSum) * 100);
                        currentSum += prop;
                        return { k, val: prop };
                    });
                    let diff = 100 - currentSum;
                    if(diff !== 0) {
                        values.sort((a,b) => b.val - a.val);
                        values[0].val += diff;
                    }
                    values.forEach(v => inputs[v.k] = v.val);
                }
            }

            const finalSum = Object.values(inputs).reduce((a,b)=>a+b, 0);
            if (Math.round(finalSum) !== 100) {
                alert('GATE Readiness Weights must sum up exactly to 100%!');
                return;
            }
            
            if(!state.settings) state.settings = {};
            state.settings.weights = {
                syllabus: inputs.syllabus / 100,
                pyqs: inputs.pyqs / 100,
                tests: inputs.tests / 100,
                mocks: inputs.mocks / 100,
                revision: inputs.revision / 100
            };
            
            // 2. Smart Auto-Balance for Subject Tracker Weights (Must total 100%)
            let changedSubIndices = [];
            let unchangedSubIndices = [];
            let changedSubSum = 0;

            workingSubjects.forEach((s, i) => {
                const origS = state.subjects.find(os => os.id === s.id);
                if (!origS || Math.abs(origS.trackerWeight - s.trackerWeight) > 0.01) {
                    changedSubIndices.push(i);
                    changedSubSum += s.trackerWeight;
                } else {
                    unchangedSubIndices.push(i);
                }
            });

            let currentTotalSub = workingSubjects.reduce((a, b) => a + b.trackerWeight, 0);

            if (changedSubIndices.length > 0 && unchangedSubIndices.length > 0) {
                let remainingSub = 100 - changedSubSum;
                if (remainingSub <= 0) {
                    if (currentTotalSub > 0) {
                        workingSubjects.forEach(s => s.trackerWeight = (s.trackerWeight / currentTotalSub) * 100);
                    } else {
                        workingSubjects.forEach(s => s.trackerWeight = 100 / workingSubjects.length);
                    }
                } else {
                    let unchangedSubSum = unchangedSubIndices.reduce((sum, i) => sum + workingSubjects[i].trackerWeight, 0);
                    unchangedSubIndices.forEach(i => {
                        const oldVal = workingSubjects[i].trackerWeight;
                        const propVal = unchangedSubSum === 0 ? (remainingSub / unchangedSubIndices.length) : (oldVal / unchangedSubSum) * remainingSub;
                        workingSubjects[i].trackerWeight = propVal;
                    });
                }
            } else if (changedSubIndices.length > 0 && unchangedSubIndices.length === 0) {
                if (changedSubSum > 0 && Math.abs(changedSubSum - 100) > 0.01) {
                    workingSubjects.forEach(s => s.trackerWeight = (s.trackerWeight / changedSubSum) * 100);
                }
            } else if (Math.abs(currentTotalSub - 100) > 0.01) {
                if (currentTotalSub > 0) {
                    workingSubjects.forEach(s => s.trackerWeight = (s.trackerWeight / currentTotalSub) * 100);
                }
            }

            let newSubSum = 0;
            workingSubjects.forEach(s => {
                s.trackerWeight = Math.round(s.trackerWeight * 10) / 10;
                newSubSum += s.trackerWeight;
            });

            let subDiff = Math.round((100 - newSubSum) * 10) / 10;
            if (subDiff !== 0 && workingSubjects.length > 0) {
                let targetIdx = unchangedSubIndices.length > 0 ? unchangedSubIndices[0] : 0;
                workingSubjects[targetIdx].trackerWeight = Math.max(0, Math.round((workingSubjects[targetIdx].trackerWeight + subDiff) * 10) / 10);
            }

            // 3. Smart Auto-Balance for Subtopics on Save (Must total each subject's trackerWeight)
            workingSubjects.forEach(workingSub => {
                const origSub = state.subjects.find(s => s.id === workingSub.id);
                if (!origSub || !workingSub.topics || workingSub.topics.length === 0) return;
                
                const totalTarget = workingSub.trackerWeight;
                if (workingSub.topics.length === 1) {
                    workingSub.topics[0].trackerWeight = totalTarget;
                    return;
                }

                let changedIndices = [];
                let unchangedIndices = [];
                let changedSum = 0;

                workingSub.topics.forEach((t, i) => {
                    const origT = origSub?.topics?.find(ot => ot.id === t.id);
                    if (!origT || Math.abs(origT.trackerWeight - t.trackerWeight) > 0.01) {
                        changedIndices.push(i);
                        changedSum += t.trackerWeight;
                    } else {
                        unchangedIndices.push(i);
                    }
                });

                let currentTotalSum = workingSub.topics.reduce((a, b) => a + b.trackerWeight, 0);

                if (changedIndices.length > 0 && unchangedIndices.length > 0) {
                    let remaining = totalTarget - changedSum;
                    if (remaining <= 0) {
                        if (currentTotalSum > 0) {
                            workingSub.topics.forEach(t => {
                                t.trackerWeight = (t.trackerWeight / currentTotalSum) * totalTarget;
                            });
                        } else {
                            const eq = totalTarget / workingSub.topics.length;
                            workingSub.topics.forEach(t => t.trackerWeight = eq);
                        }
                    } else {
                        let unchangedSum = unchangedIndices.reduce((sum, i) => sum + workingSub.topics[i].trackerWeight, 0);
                        unchangedIndices.forEach(i => {
                            const oldVal = workingSub.topics[i].trackerWeight;
                            const propVal = unchangedSum === 0 
                                ? remaining / unchangedIndices.length 
                                : (oldVal / unchangedSum) * remaining;
                            workingSub.topics[i].trackerWeight = propVal;
                        });
                    }
                } else if (changedIndices.length > 0 && unchangedIndices.length === 0) {
                    if (changedSum > 0 && Math.abs(changedSum - totalTarget) > 0.01) {
                        workingSub.topics.forEach(t => {
                            t.trackerWeight = (t.trackerWeight / changedSum) * totalTarget;
                        });
                    } else if (changedSum === 0) {
                        const eq = totalTarget / workingSub.topics.length;
                        workingSub.topics.forEach(t => t.trackerWeight = eq);
                    }
                } else if (Math.abs(currentTotalSum - totalTarget) > 0.01) {
                    // Triggers if topics were deleted or subject's trackerWeight changed
                    if (currentTotalSum > 0) {
                        workingSub.topics.forEach(t => {
                            t.trackerWeight = (t.trackerWeight / currentTotalSum) * totalTarget;
                        });
                    } else {
                        const eq = totalTarget / workingSub.topics.length;
                        workingSub.topics.forEach(t => t.trackerWeight = eq);
                    }
                }

                // Rounding and diff adjustment to hit exact totalTarget
                let newSum = 0;
                workingSub.topics.forEach(t => {
                    t.trackerWeight = Math.round(t.trackerWeight * 10) / 10;
                    newSum += t.trackerWeight;
                });

                let diff = Math.round((totalTarget - newSum) * 10) / 10;
                if (diff !== 0 && workingSub.topics.length > 0) {
                    let targetIdx = unchangedIndices.length > 0 ? unchangedIndices[0] : 0;
                    workingSub.topics[targetIdx].trackerWeight = Math.max(0, Math.round((workingSub.topics[targetIdx].trackerWeight + diff) * 10) / 10);
                }
            });

            state.subjects = workingSubjects;
            window.saveState(state);
            syllabusModal.classList.add('hidden');
        });

        // Run on load and state changes
        document.addEventListener('DOMContentLoaded', hydrateDashboard);
        window.addEventListener('stateChanged', hydrateDashboard);
    </script>
</Layout>
