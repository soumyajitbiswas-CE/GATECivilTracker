---
interface Props {
    class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer class={`mt-16 w-full ${className}`}>
    <div class="border-t border-white/5 py-10 flex flex-col items-center justify-center gap-5 text-center">
        
        <!-- Brand & Tagline -->
        <div class="flex flex-col items-center gap-2 mb-2">
            <a href="/" class="text-lg font-[Outfit] font-semibold flex items-center gap-2 text-white hover:text-primary-accent transition-colors group">
                <img src="/favicon.svg" alt="Logo" class="w-5 h-5 rounded object-cover border border-white/10 group-hover:border-primary-accent/30 transition-colors" />
                <span>GATE Civil <span class="text-primary-accent">Tracker</span></span>
            </a>
            <p class="text-text-muted text-[13px] leading-relaxed max-w-xs sm:max-w-sm">
                Free, privacy-first GATE Civil Engineering preparation & progress tracking.
            </p>
        </div>

        <!-- Links Row 1 -->
        <nav aria-label="Footer Navigation" class="flex flex-wrap justify-center items-center gap-3 text-[13px] font-medium text-white/90">
            <a href="/about" class="hover:text-primary-accent transition-colors">About</a>
            <span class="text-white/20">&middot;</span>
            <a href="/contact" class="hover:text-primary-accent transition-colors">Contact</a>
        </nav>
        
        <!-- Links Row 2 -->
        <nav aria-label="Legal Navigation" class="flex flex-wrap justify-center items-center gap-3 text-[12px] text-text-muted/60">
            <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
            <span class="text-white/10">&middot;</span>
            <a href="/terms" class="hover:text-white transition-colors">Terms & Conditions</a>
        </nav>
        
        <!-- Links Row 3 (Socials) -->
        <div class="flex flex-wrap justify-center items-center gap-3 text-[12px] text-text-muted/60">
            <a href="https://www.linkedin.com/in/soumyajitbiswas-ce/" target="_blank" rel="noopener noreferrer" class="hover:text-primary-accent transition-colors">LinkedIn</a>
            <span class="text-white/10">&middot;</span>
            <a href="https://github.com/soumyajitbiswas-CE" target="_blank" rel="noopener noreferrer" class="hover:text-primary-accent transition-colors">GitHub</a>
        </div>

        <!-- Copyright -->
        <div class="text-[11px] text-text-muted/50 mt-4">
            Made for GATE CE students by <span class="text-text-muted/70">Soumyajit Biswas</span> &copy; 2026
        </div>
    </div>
</footer>
