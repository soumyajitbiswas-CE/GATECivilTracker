---
// src/components/HeroSpline.astro
---

<div class="spline-hero-container absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden rounded-2xl" aria-hidden="true">
  
  <!-- Spline Wrapper positioned to the right -->
  <div class="absolute right-0 top-0 w-full md:w-[65%] lg:w-[55%] h-full opacity-40 sm:opacity-100 flex items-center justify-center pointer-events-none">
    
    <!-- events-target="global" enables full cursor tracking across the entire window smoothly -->
    <spline-viewer 
      id="hero-spline-viewer"
      transition:persist="hero-spline"
      class="w-full h-full pointer-events-none transition-opacity duration-500 opacity-0"
      style="filter: sepia(1) hue-rotate(95deg) saturate(1.5) brightness(0.95) contrast(1.1);"
      url="/scene.splinecode"
      background="transparent"
      loading-anim-type="none"
      events-target="global"
    ></spline-viewer>
  </div>

  <!-- Feather fade on the left edge & bottom for mobile readability -->
  <div class="absolute inset-0 z-10 pointer-events-none 
              bg-gradient-to-t from-[#020503] from-0% via-[#020503]/90 via-30% to-transparent
              md:bg-gradient-to-r md:from-[#020503] md:from-0% md:via-[#020503]/90 md:via-25% md:to-transparent md:to-60%">
  </div>
</div>

<style>
  .spline-hero-container {
    transform: translateZ(0);
    backface-visibility: hidden;
    contain: layout paint;
  }
  spline-viewer {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
</style>

<script>
  // @ts-nocheck
  import '@splinetool/viewer';

  function initViewer() {
    const viewer = document.getElementById('hero-spline-viewer');
    if (!viewer) return;

    // Handle intersection observer across navigations
    const heroContainer = viewer.closest('.spline-hero-container');
    if (heroContainer) {
      if (window._splineHeroObserver) {
        window._splineHeroObserver.disconnect();
      }
      
      window._splineHeroObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (viewer._spline) {
            if (entry.isIntersecting) {
              viewer._spline.play?.();
            } else {
              viewer._spline.stop?.();
            }
          }
        });
      }, { threshold: 0.05 });
      
      window._splineHeroObserver.observe(heroContainer);
    } else if (viewer._spline) {
      viewer._spline.stop?.();
    }

    // Only initialize the shadow DOM styles once
    if (viewer.dataset.initialized) return;
    viewer.dataset.initialized = 'true';


    const applyShadowStyles = () => {
      const shadow = viewer.shadowRoot;
      if (!shadow) return;

      if (!shadow.querySelector('#anti-logo-style')) {
        const style = document.createElement('style');
        style.id = 'anti-logo-style';
        style.textContent = `
          #spline, canvas {
            visibility: visible !important;
            display: block !important;
            width: 100% !important;
            height: 100% !important;
            pointer-events: none !important;
            background: transparent !important;
            transform: translateZ(0);
            backface-visibility: hidden;
          }
          #container {
            background: transparent !important;
            transform: translateZ(0);
          }
          #logo, #hint-drag, a[href*="spline.design"] {
            display: none !important;
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            width: 0 !important;
            height: 0 !important;
            max-width: 0 !important;
            max-height: 0 !important;
            position: absolute !important;
            top: -9999px !important;
            left: -9999px !important;
            clip: rect(0,0,0,0) !important;
            transform: scale(0) !important;
            z-index: -9999 !important;
          }
        `;
        shadow.appendChild(style);
      }

      if (viewer._spline?._renderer) {
        const r = viewer._spline._renderer;
        if (typeof r.setClearColor === 'function') {
          r.setClearColor(0x000000, 0);
        }
        if (r.pipeline) {
          r.pipeline.logoOverlayPass.enabled = false;
          r.pipeline.setWatermark = () => {
            r.pipeline.logoOverlayPass.enabled = false;
          };
          r.pipeline.updateRenderToScreen();
        }
        viewer._spline.setBackgroundColor?.('transparent');
      }

      const canvas = shadow.querySelector('canvas');
      if (canvas) {
        canvas.style.visibility = 'visible';
      }

      viewer.classList.remove('opacity-0');
      viewer.classList.add('opacity-100');
    };

    viewer.addEventListener('load-complete', applyShadowStyles);
    viewer.addEventListener('loaded', applyShadowStyles);
    
    // Observer for shadowRoot to immediately apply styles as soon as shadow DOM mounts
    const observer = new MutationObserver(() => {
      applyShadowStyles();
    });

    const checkInterval = setInterval(() => {
      if (viewer.shadowRoot) {
        observer.observe(viewer.shadowRoot, { childList: true, subtree: true });
        applyShadowStyles();
      }
    }, 50);

    setTimeout(() => {
      clearInterval(checkInterval);
      applyShadowStyles();
    }, 2500);
  }

  const start = () => {
    if (window.innerWidth < 640) {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => initViewer(), { timeout: 1000 });
      } else {
        setTimeout(initViewer, 150);
      }
    } else {
      initViewer();
    }
  };

  document.addEventListener('astro:page-load', start);
</script>
