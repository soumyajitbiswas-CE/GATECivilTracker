---
// Canvas 2D Highly Optimized Falling Leaves
// Based on "falling-leaves" skill guidelines
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true" id="falling-leaves-container" style="contain: strict; will-change: transform; transform: translateZ(0);">
    <canvas id="falling-leaves-canvas" class="w-full h-full"></canvas>
</div>

<script is:inline>
(function() {
    // 1. Single unified harmonious color tone with minimal non-distracting detailing
    var LEAF_COLOR = {
        main: '#047857',      // Balanced calming emerald
        deep: '#064e3b',      // Subtle deep green tone
        stem: '#022c22'       // Minimal stem tone
    };

    // Minimalist, ambient leaf artwork (soft, natural, non-distracting)
    function drawLeafArt(octx, size, isBack) {
        var half = size / 2;
        octx.save();
        octx.translate(half, half);

        // Smooth subtle gradient (no harsh highlights)
        var grad = octx.createLinearGradient(0, -36, 0, 34);
        if (isBack) {
            grad.addColorStop(0, '#059669');
            grad.addColorStop(1, '#064e3b');
        } else {
            grad.addColorStop(0, LEAF_COLOR.main);
            grad.addColorStop(1, LEAF_COLOR.deep);
        }

        // Clean, stylized organic silhouette
        octx.beginPath();
        octx.moveTo(0, -36); // Tip
        octx.bezierCurveTo(-15, -28, -24, -10, -22, 10);
        octx.bezierCurveTo(-20, 24, -8, 32, 0, 34); // Base
        octx.bezierCurveTo(8, 32, 20, 24, 22, 10);
        octx.bezierCurveTo(24, -10, 15, -28, 0, -36);
        octx.closePath();

        octx.fillStyle = grad;
        if (isBack) octx.globalAlpha = 0.65; // Matte underside
        octx.fill();

        // Minimal, subtle stem
        octx.beginPath();
        octx.moveTo(0, 33);
        octx.quadraticCurveTo(-0.8, 38, -2, 42);
        octx.strokeStyle = LEAF_COLOR.stem;
        octx.lineWidth = 1.8;
        octx.lineCap = 'round';
        octx.globalAlpha = isBack ? 0.5 : 0.75;
        octx.stroke();

        // Soft, minimal midrib crease (subtle, non-eye-catchy)
        octx.beginPath();
        octx.moveTo(0, -32);
        octx.lineTo(0, 32);
        octx.strokeStyle = isBack ? 'rgba(255,255,255,0.14)' : 'rgba(0,0,0,0.12)';
        octx.lineWidth = 1.0;
        octx.stroke();

        octx.restore();
    }

    function bakeSprite(isBack) {
        var size = 96;
        var offCanvas = document.createElement('canvas');
        offCanvas.width = size;
        offCanvas.height = size;
        var octx = offCanvas.getContext('2d');
        if (octx) {
            drawLeafArt(octx, size, isBack);
        }
        return offCanvas;
    }

    // Pre-bake blurred sprite once for ZERO runtime performance cost on mobile
    function bakeBlurredSprite(sourceCanvas) {
        var size = sourceCanvas.width;
        var offCanvas = document.createElement('canvas');
        offCanvas.width = size;
        offCanvas.height = size;
        var octx = offCanvas.getContext('2d');
        if (octx) {
            octx.filter = 'blur(2.5px)';
            octx.drawImage(sourceCanvas, 0, 0);
        }
        return offCanvas;
    }

    var faceSprite = bakeSprite(false);
    var backSprite = bakeSprite(true);
    var unifiedSprite = {
        face: faceSprite,
        back: backSprite,
        faceBlurred: bakeBlurredSprite(faceSprite),
        backBlurred: bakeBlurredSprite(backSprite)
    };

    // Target counts per device profile (+5% quantity increase applied)
    function getTargetLeafCount(width) {
        if (width <= 640) return 23;      // Mobile (+5% -> 23)
        if (width <= 1024) return 38;     // Tablets / iPads (+5% -> 38)
        if (width >= 2560) return 113;    // Large 4K Desktops (+5% -> 113)
        return 85;                        // Normal Desktop (+5% -> 85)
    }

    // Setup function to run immediately and on every page load
    function initFallingLeaves() {
        var container = document.getElementById('falling-leaves-container');
        var canvas = document.getElementById('falling-leaves-canvas');
        if (!canvas || !container) return;

        // Prevent double initialization
        if (canvas._initialized) return;
        canvas._initialized = true;

        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        // State
        var leaves = [];
        var isPaused = false;
        var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var lastTime = 0;
        var animId;

        // Synchronous initial dimension measurement for instantaneous frame 0 rendering
        var W = container.clientWidth || window.innerWidth || document.documentElement.clientWidth || 800;
        var H = container.clientHeight || window.innerHeight || document.documentElement.clientHeight || 600;

        var maxDpr = W <= 640 ? 1.0 : 1.25;
        var dpr = Math.min(window.devicePixelRatio || 1, maxDpr);

        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.scale(dpr, dpr);

        // Spatial distribution per device profile:
        // - Mobile & Tablets (<= 1024px): Uniform across screen
        // - Standard Desktop & 4K Ultra-Wide (> 1024px): 37% Left | 26% Center UI | 37% Right
        function getLaneBaseX(laneIndex, totalLeaves, width) {
            if (width <= 1024 || totalLeaves <= 0) {
                // Mobile & Tablets: Uniform lane distribution across entire screen
                var laneW = width / Math.max(1, totalLeaves);
                return (laneIndex + 0.5 + (Math.random() - 0.5) * 0.65) * laneW;
            }

            // Desktop & 4K Ultra-Wide (> 1024px): 37% Left | 26% Center UI | 37% Right
            var u = (laneIndex + 0.5) / totalLeaves;
            var flankWidth = Math.max(width * 0.28, (width - Math.min(1150, width - 48)) / 2 + 100);
            var leftEnd = flankWidth;
            var rightStart = width - flankWidth;

            if (u < 0.37) {
                // Left Flank (37% of leaves)
                var t = u / 0.37;
                var localSpan = (leftEnd + 10) / Math.max(1, totalLeaves * 0.37);
                return -10 + t * (leftEnd + 10) + (Math.random() - 0.5) * localSpan * 0.6;
            } else if (u < 0.63) {
                // Center UI (26% of leaves)
                var t = (u - 0.37) / 0.26;
                var centerWidth = Math.max(10, rightStart - leftEnd);
                var localSpan = centerWidth / Math.max(1, totalLeaves * 0.26);
                return leftEnd + t * centerWidth + (Math.random() - 0.5) * localSpan * 0.6;
            } else {
                // Right Flank (37% of leaves)
                var t = (u - 0.63) / 0.37;
                var rightWidth = width + 10 - rightStart;
                var localSpan = rightWidth / Math.max(1, totalLeaves * 0.37);
                return rightStart + t * rightWidth + (Math.random() - 0.5) * localSpan * 0.6;
            }
        }

        // 2. Initialize leaves with lane-stratified distribution
        function initLeaves() {
            if (!W || !H) return;
            var numLeaves = getTargetLeafCount(W);

            var yIndices = Array.from({ length: numLeaves }, function(_, i) { return i; });
            for (var i = yIndices.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                var temp = yIndices[i];
                yIndices[i] = yIndices[j];
                yIndices[j] = temp;
            }

            leaves = Array.from({ length: numLeaves }).map(function(_, i) {
                var startX = getLaneBaseX(i, numLeaves, W);
                var startY = (yIndices[i] / numLeaves) * (H + 100) - 50;
                return createLeaf(i, startX, startY);
            });
        }

        function createLeaf(laneIndex, customX, customY) {
            var rand = Math.random();
            var isMacro = rand > 0.60;
            var isBlurred = isMacro && (rand > 0.80);
            var scale, fallBase, opacity;
            
            // Applied adjustments: +5% size, -10% opacity, +5% speed
            if (isMacro) {
                // Macro Foreground Layer: ~0.87x to 1.25x (5% size increase)
                scale = 0.87 + Math.random() * 0.38;
                fallBase = 36.91 + Math.random() * 20.75; // 36.91 - 57.66 px/s (5% faster)
                opacity = 0.27 + Math.random() * 0.14; // Soft ambient opacity: 27% – 41%
            } else {
                // Main Near Layer: ~0.53x to 0.78x (5% size increase)
                scale = 0.53 + Math.random() * 0.25;
                fallBase = 23.05 + Math.random() * 16.16; // 23.05 - 39.21 px/s (5% faster)
                opacity = 0.21 + Math.random() * 0.15; // Gentle backdrop opacity: 21% – 36%
            }

            var anchorX = customX !== undefined ? customX : getLaneBaseX(laneIndex, leaves.length || getTargetLeafCount(W), W);
            var y = customY !== undefined ? customY : -35 - Math.random() * 45;

            // Sway harmonic properties (5% faster frequency)
            var swayAmp = 12 + Math.random() * 16;
            var swayFreq = 0.45 + Math.random() * 0.45;
            var swayPhase = Math.random() * Math.PI * 2;

            var canFullFlip = Math.random() < 0.18;

            return {
                laneIndex: laneIndex,
                anchorX: anchorX,
                y: y,
                sprite: unifiedSprite,
                scale: scale,
                fallBase: fallBase,
                opacity: opacity,
                isBlurred: isBlurred,
                canFullFlip: canFullFlip,

                swayAmp: swayAmp,
                swayFreq: swayFreq,
                swayPhase: swayPhase,

                roll: Math.random() * Math.PI * 2,
                rollRate: (Math.random() - 0.5) * 0.35,
                
                spin: Math.random() * Math.PI * 2,
                spinRate: canFullFlip ? (Math.random() - 0.5) * 0.75 : (Math.random() - 0.5) * 0.50,
                
                slipBase: 13.86 + Math.random() * 20.75
            };
        }

        // 3. Animation loop
        function update(time) {
            if (isPaused) {
                lastTime = time;
                animId = requestAnimationFrame(update);
                return;
            }

            if (lastTime === 0) lastTime = time;
            var dt = Math.min((time - lastTime) / 1000, 1 / 30);
            lastTime = time;

            ctx.clearRect(0, 0, W, H);

            if (prefersReducedMotion) {
                drawLeaves(0);
            } else {
                drawLeaves(dt);
            }

            animId = requestAnimationFrame(update);
        }

        function drawLeaves(dt) {
            if (!leaves.length) return;

            for (var i = 0; i < leaves.length; i++) {
                var l = leaves[i];
                
                if (dt > 0) {
                    l.spin += l.spinRate * dt;
                    l.roll += l.rollRate * dt;
                    l.swayPhase += l.swayFreq * dt;
                    l.y += l.fallBase * dt;

                    if (l.y > H + 60) {
                        l.anchorX = getLaneBaseX(l.laneIndex, leaves.length, W);
                        l.y = -35 - Math.random() * 45;
                        l.spin = Math.random() * Math.PI * 2;
                        l.roll = Math.random() * Math.PI * 2;
                    }
                }

                var slipOffset = Math.sin(l.spin) * (l.slipBase * 0.8 * l.scale);
                var swayOffset = Math.sin(l.swayPhase) * l.swayAmp;
                var renderX = l.anchorX + slipOffset + swayOffset;

                var scaleX;
                var isBack = false;

                if (l.canFullFlip) {
                    var rawCos = Math.cos(l.spin);
                    isBack = rawCos < 0;
                    var clampedCos = Math.sign(rawCos) * Math.max(0.20, Math.abs(rawCos));
                    scaleX = clampedCos * l.scale;
                } else {
                    scaleX = (0.85 + 0.15 * Math.cos(l.spin)) * l.scale;
                    isBack = false;
                }

                ctx.save();
                ctx.translate(renderX, l.y);
                ctx.rotate(l.roll);              
                ctx.scale(scaleX, l.scale);
                
                ctx.globalAlpha = l.opacity;
                
                var img = l.isBlurred
                    ? (isBack ? l.sprite.backBlurred : l.sprite.faceBlurred)
                    : (isBack ? l.sprite.back : l.sprite.face);
                
                ctx.drawImage(img, -24, -24, 48, 48);
                ctx.restore();
            }
        }

        // 4. Synchronous frame 0 paint — INSTANT ZERO-LATENCY PAINT
        initLeaves();
        drawLeaves(0);

        // 5. Resize & Multi-Device Handling
        var resizeObserver;
        if (typeof ResizeObserver !== 'undefined') {
            resizeObserver = new ResizeObserver(function(entries) {
                if (!entries || !entries.length) return;
                var rect = entries[0].contentRect;
                if (rect.width === 0 || rect.height === 0) return;

                if (Math.abs(W - rect.width) < 2 && Math.abs(H - rect.height) < 2) return;

                W = rect.width;
                H = rect.height;

                var maxDpr = W <= 640 ? 1.0 : 1.25;
                var dpr = Math.min(window.devicePixelRatio || 1, maxDpr);

                canvas.width = Math.round(W * dpr);
                canvas.height = Math.round(H * dpr);
                canvas.style.width = W + 'px';
                canvas.style.height = H + 'px';
                ctx.scale(dpr, dpr);

                var targetCount = getTargetLeafCount(W);
                if (leaves.length === 0 || Math.abs(leaves.length - targetCount) > 8) {
                    initLeaves();
                }

                if (prefersReducedMotion || isPaused) {
                    ctx.clearRect(0, 0, W, H);
                    drawLeaves(0);
                }
            });

            resizeObserver.observe(container);
        }

        // 6. Visibility and Motion Preferences
        var io;
        if (typeof IntersectionObserver !== 'undefined') {
            io = new IntersectionObserver(function(entries) {
                isPaused = !entries[0].isIntersecting || document.hidden;
                if (!isPaused) lastTime = performance.now();
            });
            io.observe(container);
        }

        function handleVisibilityChange() {
            isPaused = document.hidden;
            if (!isPaused) lastTime = performance.now();
        }
        document.addEventListener('visibilitychange', handleVisibilityChange);

        function handleMotionChange(e) {
            prefersReducedMotion = e.matches;
            if (prefersReducedMotion) {
                ctx.clearRect(0, 0, W, H);
                drawLeaves(0);
            }
        }
        var motionQuery = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
        if (motionQuery && motionQuery.addEventListener) {
            motionQuery.addEventListener('change', handleMotionChange);
        }

        // Cleanup on navigation
        document.addEventListener('astro:before-swap', function() {
            cancelAnimationFrame(animId);
            if (resizeObserver) resizeObserver.disconnect();
            if (io) io.disconnect();
            document.removeEventListener('visibilitychange', handleVisibilityChange);
            if (motionQuery && motionQuery.removeEventListener) {
                motionQuery.removeEventListener('change', handleMotionChange);
            }
            if (canvas) {
                canvas._initialized = false;
            }
        }, { once: true });

        // Start animation immediately
        lastTime = performance.now();
        animId = requestAnimationFrame(update);
    }

    // Run IMMEDIATELY synchronous on HTML parse (zero milliseconds delay)
    initFallingLeaves();
    document.addEventListener('astro:page-load', initFallingLeaves);
})();
</script>
