---
// Optimized for Universal Device Performance & Smooth Realistic Physics
const numLeaves = 80; // Reverted back to high density
const leaves = Array.from({ length: numLeaves }).map((_, i) => {
    // Physics Logic: Tiny leaves fall slower and flutter faster
    const isTiny = Math.random() > 0.6; // 40% of leaves are tiny background leaves
    
    // Increased minimum sizes so they don't look like dust
    const sizeScale = isTiny ? (0.35 + Math.random() * 0.3) : (0.65 + Math.random() * 0.65);
    const fallDuration = isTiny ? (20 + Math.random() * 20) : (12 + Math.random() * 15);
    const swayDuration = isTiny ? (3 + Math.random() * 3) : (4 + Math.random() * 5);
    
    return {
        id: i,
        left: Math.random() * 100, // random horizontal start
        fallDelay: Math.random() * -45, // huge negative delay spread so screen is instantly full
        fallDuration: fallDuration,
        swayDelay: Math.random() * -5,
        swayDuration: swayDuration,
        // Depth of field simulated with opacity (0 filter overhead)
        opacity: isTiny ? (0.12 + Math.random() * 0.12) : (0.2 + Math.random() * 0.25),
        scale: sizeScale,
        swayType: i % 4,
        // Brightened the colors slightly for better contrast
        color: ['text-emerald-600', 'text-emerald-700', 'text-emerald-800', 'text-green-700', 'text-[#0c4a26]'][Math.floor(Math.random() * 5)]
    };
});
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    {leaves.map((leaf) => (
        /* 1. Outer Container: Hardware-accelerated Linear Gravity */
        <div 
            class="absolute top-[-10vh] leaf-fall"
            style={`
                left: ${leaf.left}%;
                animation-delay: ${leaf.fallDelay}s;
                animation-duration: ${leaf.fallDuration}s;
            `}
        >
            {/* 2. Middle Container: Static visual properties */}
            <div 
                class={`${leaf.color}`}
                style={`
                    opacity: ${leaf.opacity};
                    transform: scale(${leaf.scale}) translateZ(0);
                `}
            >
                {/* 3. Inner Element: Organic Pendulum Physics & 3D Tumble */}
                <svg 
                    width="32"
                    height="32"
                    viewBox="0 0 24 24" 
                    fill="currentColor" 
                    class={`w-8 h-8 leaf-sway sway-${leaf.swayType}`}
                    style={`
                        width: 32px;
                        height: 32px;
                        max-width: 32px;
                        max-height: 32px;
                        animation-delay: ${leaf.swayDelay}s;
                        animation-duration: ${leaf.swayDuration}s;
                    `}
                >
                    <!-- Beautiful smooth leaf silhouette -->
                    <path d="M17.5,3C13.5,3 10.5,5.5 8.5,8.5C6.5,11.5 5.5,15.5 5,20C8.5,20 13.5,18.5 16.5,14.5C19.5,10.5 20,6 20,3L17.5,3Z"/>
                </svg>
            </div>
        </div>
    ))}
</div>

<style>
    /* 
      GPU HARDWARE ACCELERATION:
      will-change and backface-visibility force the browser to composite these smoothly on the GPU.
    */
    .leaf-fall {
        will-change: transform;
        backface-visibility: hidden;
        animation-name: fallDown;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    @keyframes fallDown {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(0, 120vh, 0); } 
    }

    .leaf-sway {
        will-change: transform;
        backface-visibility: hidden;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        transform-origin: center center;
        width: 32px;
        height: 32px;
        max-width: 32px;
        max-height: 32px;
    }

    /* 4 DISTINCT PHYSICS PATTERNS for maximum realism */
    .sway-0 { animation-name: sway0; }
    .sway-1 { animation-name: sway1; }
    .sway-2 { animation-name: sway2; }
    .sway-3 { animation-name: sway3; }

    /* Sway 0: Gentle, wide drift */
    @keyframes sway0 {
        0% { transform: translate3d(-35px, 0, 0) rotateZ(-25deg); }
        100% { transform: translate3d(35px, 0, 0) rotateZ(35deg); }
    }
    
    /* Sway 1: Tighter, faster fluttering with 3D Y-axis flip */
    @keyframes sway1 {
        0% { transform: translate3d(25px, 0, 0) rotateZ(15deg) rotateY(0deg); }
        100% { transform: translate3d(-25px, 0, 0) rotateZ(-40deg) rotateY(60deg); }
    }

    /* Sway 2: Aggressive sideways sweeping */
    @keyframes sway2 {
        0% { transform: translate3d(-50px, 0, 0) rotateZ(-60deg); }
        100% { transform: translate3d(30px, 0, 0) rotateZ(20deg); }
    }

    /* Sway 3: Chaotic tumbling in 3D space */
    @keyframes sway3 {
        0% { transform: translate3d(15px, 0, 0) rotateZ(45deg) rotateX(-20deg); }
        100% { transform: translate3d(-40px, 0, 0) rotateZ(-55deg) rotateX(40deg); }
    }

    /* TABLET OPTIMIZATION (641px to 1024px): Moderately reduce quantity */
    @media (min-width: 641px) and (max-width: 1024px) {
        .leaf-fall:nth-child(3n) {
            display: none !important;
        }
    }

    /* MOBILE OPTIMIZATION (<= 640px): Significantly reduce quantity for clean view & maximum battery saving */
    @media (max-width: 640px) {
        .leaf-fall:nth-child(3n),
        .leaf-fall:nth-child(3n + 1) {
            display: none !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .leaf-fall, .leaf-sway {
            animation: none !important;
        }
    }
</style>
