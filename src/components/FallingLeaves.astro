---
// High-Density Cinematic Falling Leaves with Depth-of-Field & 3D Tumble Physics
const numLeaves = 75; // Full rich density
const leaves = Array.from({ length: numLeaves }).map((_, i) => {
    const isTiny = i % 3 === 0; // Background micro-leaves
    const isBlurred = i % 4 === 0; // 25% depth-of-field blur
    
    const sizeScale = isTiny 
        ? (0.35 + Math.random() * 0.3) 
        : (0.65 + Math.random() * 0.65);

    const fallDuration = isTiny 
        ? (22 + Math.random() * 18) 
        : (12 + Math.random() * 14);

    const swayDuration = isTiny 
        ? (3.5 + Math.random() * 2.5) 
        : (4.5 + Math.random() * 4.5);
    
    return {
        id: i,
        left: Math.random() * 100, // natural horizontal spread
        fallDelay: Math.random() * -50, // instant full-screen presence
        fallDuration: fallDuration,
        swayDelay: Math.random() * -8,
        swayDuration: swayDuration,
        opacity: isTiny 
            ? (0.18 + Math.random() * 0.15) 
            : (0.25 + Math.random() * 0.35),
        scale: sizeScale,
        blur: isBlurred ? 'blur(2px)' : 'none',
        swayType: i % 4,
        color: ['text-emerald-600', 'text-emerald-700', 'text-emerald-800', 'text-green-700', 'text-[#0c4a26]'][i % 5]
    };
});
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-[-1]" style="contain: layout style paint;" aria-hidden="true">
    {leaves.map((leaf) => (
        /* 1. Outer Container: Hardware-accelerated Linear Gravity */
        <div 
            class="absolute top-[-10vh] leaf-fall"
            style={`
                left: ${leaf.left}%;
                animation-delay: ${leaf.fallDelay}s;
                animation-duration: ${leaf.fallDuration}s;
            `}
        >
            {/* 2. Middle Container: Static visual scale, color, opacity & depth-of-field blur */}
            <div 
                class={`${leaf.color}`}
                style={`
                    opacity: ${leaf.opacity};
                    filter: ${leaf.blur};
                    transform: scale(${leaf.scale}) translateZ(0);
                    will-change: transform;
                `}
            >
                {/* 3. Inner Element: Organic 3D Pendulum Physics & Multi-axis Tumble */}
                <svg 
                    viewBox="0 0 24 24" 
                    fill="currentColor" 
                    class={`w-8 h-8 leaf-sway sway-${leaf.swayType}`}
                    style={`
                        animation-delay: ${leaf.swayDelay}s;
                        animation-duration: ${leaf.swayDuration}s;
                    `}
                >
                    <!-- Realistic leaf silhouette -->
                    <path d="M17.5,3C13.5,3 10.5,5.5 8.5,8.5C6.5,11.5 5.5,15.5 5,20C8.5,20 13.5,18.5 16.5,14.5C19.5,10.5 20,6 20,3L17.5,3Z"/>
                </svg>
            </div>
        </div>
    ))}
</div>

<style>
    /* 
      GPU HARDWARE ACCELERATION & COMPOSITING:
      will-change, translate3d and backface-visibility guarantee 60fps across PC, tablet and mobile.
    */
    .leaf-fall {
        will-change: transform;
        backface-visibility: hidden;
        animation-name: fallDown;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    @keyframes fallDown {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(0, 125vh, 0); } 
    }

    .leaf-sway {
        will-change: transform;
        backface-visibility: hidden;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        transform-origin: center center;
    }

    /* 4 DISTINCT REALISTIC 3D PHYSICS PATTERNS */
    .sway-0 { animation-name: sway0; }
    .sway-1 { animation-name: sway1; }
    .sway-2 { animation-name: sway2; }
    .sway-3 { animation-name: sway3; }

    /* Sway 0: Gentle, wide natural drift */
    @keyframes sway0 {
        0% { transform: translate3d(-35px, 0, 0) rotateZ(-25deg); }
        100% { transform: translate3d(35px, 0, 0) rotateZ(35deg); }
    }
    
    /* Sway 1: Fast fluttering with 3D Y-axis flip */
    @keyframes sway1 {
        0% { transform: translate3d(25px, 0, 0) rotateZ(15deg) rotateY(0deg); }
        100% { transform: translate3d(-25px, 0, 0) rotateZ(-40deg) rotateY(65deg); }
    }

    /* Sway 2: Sweeping lateral glide */
    @keyframes sway2 {
        0% { transform: translate3d(-50px, 0, 0) rotateZ(-60deg); }
        100% { transform: translate3d(30px, 0, 0) rotateZ(20deg); }
    }

    /* Sway 3: Chaotic 3D aerodynamic tumble */
    @keyframes sway3 {
        0% { transform: translate3d(15px, 0, 0) rotateZ(45deg) rotateX(-20deg); }
        100% { transform: translate3d(-40px, 0, 0) rotateZ(-55deg) rotateX(45deg); }
    }

    /* Mobile Performance: render 37 leaves on mobile, 75 on desktop/tablet */
    @media (max-width: 640px) {
        .leaf-fall:nth-child(even) {
            display: none !important;
        }
    }
</style>
